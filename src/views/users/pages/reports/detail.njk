<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{{ title }} - Chi tiết báo cáo</title>
    
    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Font Awesome -->
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css" rel="stylesheet">
    
    <script>
        tailwind.config = {
            theme: {
                extend: {
                    fontFamily: {
                        'sans': ['Segoe UI', 'Tahoma', 'Geneva', 'Verdana', 'sans-serif'],
                    }
                }
            }
        }
    </script>
    
    <style>
        @media print {
            .no-print {
                display: none !important;
            }
        }
        
        .media-preview {
            transition: transform 0.2s ease;
        }
        
        .media-preview:hover {
            transform: scale(1.05);
        }
        
        .loading-animation {
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        
        .loading-animation.loaded {
            opacity: 1;
        }
    </style>
</head>
<body class="bg-gray-50 font-sans loading-animation">    <!-- Header Section -->
    <div class="bg-gradient-to-br from-indigo-500 via-purple-500 to-pink-500 text-white py-8 mb-8 rounded-b-3xl">
        <div class="max-w-6xl mx-auto px-4">
            <div class="flex items-center space-x-4">
                <!-- Logo -->
                <div class="w-12 h-12 rounded-full flex items-center justify-center cursor-pointer bg-white/10 backdrop-blur-sm border border-white/20"
                     onclick="window.location.href='/home'">
                    <img alt="Logo" class="w-8 h-8 object-cover" src="/images/favicon.png"/>
                </div>
                <div>
                    <h1 class="text-3xl font-bold mb-2">
                        <i class="fas fa-flag mr-3"></i>Chi tiết báo cáo
                    </h1>
                    <p class="text-white/80">Xem thông tin chi tiết về báo cáo và phản hồi</p>
                </div>
            </div>
        </div>
    </div>

    <!-- Main Content -->
    <div class="max-w-6xl mx-auto px-4">
        <!-- Report Info Card -->
        <div class="bg-white rounded-xl shadow-lg mb-8 overflow-hidden">
            <div class="bg-blue-600 text-white px-6 py-4">
                <h5 class="text-xl font-semibold flex items-center">
                    <i class="fas fa-info-circle mr-3"></i>
                    Thông tin báo cáo - {{ report.type }}
                </h5>
            </div>
            <div class="p-6">
                <div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
                    <div class="space-y-6">
                        <div>
                            <label class="block text-sm font-bold text-blue-600 mb-3">
                                <i class="fas fa-user mr-2"></i>Người báo cáo:
                            </label>
                            <div class="flex items-center space-x-3">
                                <img src="{{ report.reporter.avatar }}" alt="Avatar" class="w-12 h-12 rounded-full object-cover">
                                <div>
                                    <div class="font-bold text-gray-900">{{ report.reporter.name }}</div>
                                    <div class="text-sm text-gray-500">@{{ report.reporter.username }}</div>
                                    <div class="text-xs text-gray-400">{{ report.reporter.email }}</div>
                                </div>
                            </div>
                        </div>
                        
                        <div>
                            <label class="block text-sm font-bold text-blue-600 mb-3">
                                <i class="fas fa-tag mr-2"></i>Loại báo cáo:
                            </label>
                            <div>
                                <span class="inline-flex items-center px-4 py-2 rounded-full bg-yellow-100 text-yellow-800 font-semibold">
                                    {% if report.type === 'POST' %}
                                        <i class="fas fa-file-text mr-2"></i>Báo cáo bài viết
                                    {% else %}
                                        <i class="fas fa-user mr-2"></i>Báo cáo người dùng
                                    {% endif %}
                                </span>
                            </div>
                        </div>

                        <div>
                            <label class="block text-sm font-bold text-blue-600 mb-3">
                                <i class="fas fa-calendar mr-2"></i>Thời gian:
                            </label>
                            <div class="space-y-2">
                                <div class="flex justify-between py-2 border-b border-gray-100">
                                    <span class="text-gray-600">Ngày tạo:</span>
                                    <span class="font-medium text-gray-900">{{ report.createdAt | date('DD/MM/YYYY HH:mm') }}</span>
                                </div>
                                <div class="flex justify-between py-2">
                                    <span class="text-gray-600">Cập nhật:</span>
                                    <span class="font-medium text-gray-900">{{ report.updatedAt | date('DD/MM/YYYY HH:mm') }}</span>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="space-y-6">
                        <div>
                            <label class="block text-sm font-bold text-blue-600 mb-3">
                                <i class="fas fa-exclamation-triangle mr-2"></i>Lý do báo cáo:
                            </label>
                            <div class="bg-gray-50 border-l-4 border-blue-500 p-5 rounded-r-lg">
                                <p class="text-gray-800 leading-relaxed">{{ report.reason }}</p>
                            </div>
                        </div>

                        <!-- Report Status -->
                        <div class="p-4 rounded-lg {% if report.responder %}bg-gradient-to-r from-green-50 to-emerald-50 border-l-4 border-green-500{% else %}bg-gradient-to-r from-yellow-50 to-amber-50 border-l-4 border-yellow-500{% endif %}">
                            {% if report.responder %}
                                <div class="flex items-center">
                                    <i class="fas fa-check-circle mr-3 text-green-600"></i>
                                    <span class="font-bold text-green-800">Đã được phản hồi</span>
                                </div>
                            {% else %}
                                <div class="flex items-center">
                                    <i class="fas fa-hourglass-half mr-3 text-yellow-600"></i>
                                    <span class="font-bold text-yellow-800">Đang chờ xử lý</span>
                                </div>
                            {% endif %}
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Target Details Card -->
        <div class="bg-white rounded-xl shadow-lg mb-8 overflow-hidden">
            <div class="bg-cyan-600 text-white px-6 py-4">
                <h5 class="text-xl font-semibold flex items-center">
                    <i class="fas fa-bullseye mr-3"></i>
                    Đối tượng bị báo cáo
                    {% if report.type === 'POST' %}
                        - Bài viết
                    {% else %}
                        - Người dùng
                    {% endif %}
                </h5>
            </div>
            <div class="p-6">
                {% if report.type === 'POST' %}
                    <!-- Post Details -->
                    <div class="bg-white rounded-xl p-6 shadow-md">
                        <div class="flex items-center mb-6">
                            <img src="{{ targetDetails.author.avatar }}" alt="Avatar" class="w-12 h-12 rounded-full object-cover mr-4">
                            <div class="flex-grow">
                                <div class="font-bold text-gray-900">{{ targetDetails.author.name }}</div>
                                <div class="text-sm text-gray-500">@{{ targetDetails.author.username }}</div>
                                <div class="text-xs text-gray-400">{{ targetDetails.author.email }}</div>
                            </div>
                            <span class="inline-flex items-center px-3 py-1 rounded-full bg-gray-100 text-gray-700 text-sm font-medium">{{ targetDetails.type }}</span>
                        </div>
                        
                        <div class="mb-6">
                            <h6 class="font-bold text-blue-600 mb-3 flex items-center">
                                <i class="fas fa-file-text mr-2"></i>Nội dung bài viết:
                            </h6>
                            <div class="bg-gray-50 border-l-4 border-blue-500 p-5 rounded-r-lg">
                                <p class="text-gray-800 leading-relaxed">{{ targetDetails.content }}</p>
                            </div>
                        </div>

                        {% if targetDetails.mediaUrls.length > 0 %}
                        <div class="mb-6">
                            <h6 class="font-bold text-blue-600 mb-3 flex items-center">
                                <i class="fas fa-images mr-2"></i>Hình ảnh đính kèm:
                            </h6>
                            <div class="grid grid-cols-2 md:grid-cols-4 gap-4">
                                {% for mediaUrl in targetDetails.mediaUrls %}
                                <div class="cursor-pointer">
                                    <img src="{{ mediaUrl }}" alt="Media" 
                                         class="w-full h-32 object-cover rounded-lg media-preview shadow-md hover:shadow-lg" 
                                         onclick="openImageModal('{{ mediaUrl }}')">
                                </div>
                                {% endfor %}
                            </div>
                        </div>
                        {% endif %}

                        <div class="grid grid-cols-3 gap-4 text-center border-t pt-4">
                            <div class="text-gray-600">
                                <i class="fas fa-heart text-red-500 mr-1"></i>
                                <span class="font-bold text-lg">{{ targetDetails.likes.length }}</span>
                                <div class="text-sm">Lượt thích</div>
                            </div>
                            <div class="text-gray-600">
                                <i class="fas fa-comment text-blue-500 mr-1"></i>
                                <span class="font-bold text-lg">{{ targetDetails.commentsCount }}</span>
                                <div class="text-sm">Bình luận</div>
                            </div>
                            <div class="text-gray-600">
                                <i class="fas fa-share text-green-500 mr-1"></i>
                                <span class="font-bold text-lg">{{ targetDetails.sharesCount }}</span>
                                <div class="text-sm">Chia sẻ</div>
                            </div>
                        </div>

                        <div class="mt-4 text-center text-gray-500 text-sm">
                            <i class="fas fa-clock mr-1"></i>
                            Đăng lúc: {{ targetDetails.createdAt | date('DD/MM/YYYY HH:mm') }}
                        </div>
                    </div>
                {% else %}
                    <!-- User Details -->
                    <div class="bg-white rounded-xl p-6 shadow-md">
                        <div class="grid grid-cols-1 md:grid-cols-12 gap-6">
                            <div class="md:col-span-4 text-center">
                                <img src="{{ targetDetails.avatar }}" alt="Avatar" class="w-20 h-20 rounded-full object-cover mx-auto mb-4">
                                <h5 class="font-bold text-xl text-gray-900">{{ targetDetails.name }}</h5>
                                <div class="text-gray-500 mb-2">@{{ targetDetails.username }}</div>
                                <span class="inline-flex items-center px-3 py-1 rounded-full bg-blue-100 text-blue-800 text-sm font-medium">{{ targetDetails.role }}</span>
                                {% if targetDetails.bannedUntil %}
                                    <div class="mt-2">
                                        <span class="inline-flex items-center px-3 py-1 rounded-full bg-red-100 text-red-800 text-sm font-bold">BỊ CẤM</span>
                                    </div>
                                {% endif %}
                            </div>
                            <div class="md:col-span-8">
                                <h6 class="font-bold text-blue-600 mb-4 flex items-center">
                                    <i class="fas fa-info-circle mr-2"></i>Thông tin cá nhân:
                                </h6>
                                
                                <div class="space-y-3">
                                    <div class="flex justify-between py-2 border-b border-gray-100">
                                        <span class="flex items-center text-gray-600">
                                            <i class="fas fa-envelope mr-2 w-4"></i>Email:
                                        </span>
                                        <span class="font-medium text-gray-900">{{ targetDetails.email }}</span>
                                    </div>
                                    
                                    <div class="flex justify-between py-2 border-b border-gray-100">
                                        <span class="flex items-center text-gray-600">
                                            <i class="fas fa-venus-mars mr-2 w-4"></i>Giới tính:
                                        </span>
                                        <span class="font-medium text-gray-900">
                                            {% if targetDetails.gender === 'MALE' %}
                                                <i class="fas fa-mars text-blue-500"></i> Nam
                                            {% elif targetDetails.gender === 'FEMALE' %}
                                                <i class="fas fa-venus text-pink-500"></i> Nữ
                                            {% else %}
                                                <i class="fas fa-genderless text-gray-500"></i> Khác
                                            {% endif %}
                                        </span>
                                    </div>
                                    
                                    <div class="flex justify-between py-2 border-b border-gray-100">
                                        <span class="flex items-center text-gray-600">
                                            <i class="fas fa-phone mr-2 w-4"></i>Số điện thoại:
                                        </span>
                                        <span class="font-medium text-gray-900">{{ targetDetails.phone or 'Chưa cập nhật' }}</span>
                                    </div>
                                    
                                    <div class="flex justify-between py-2 border-b border-gray-100">
                                        <span class="flex items-center text-gray-600">
                                            <i class="fas fa-birthday-cake mr-2 w-4"></i>Ngày sinh:
                                        </span>
                                        <span class="font-medium text-gray-900">
                                            {% if targetDetails.birthday %}
                                                {{ targetDetails.birthday | date('DD/MM/YYYY') }}
                                            {% else %}
                                                Chưa cập nhật
                                            {% endif %}
                                        </span>
                                    </div>
                                    
                                    <div class="flex justify-between py-2 border-b border-gray-100">
                                        <span class="flex items-center text-gray-600">
                                            <i class="fas fa-shield-alt mr-2 w-4"></i>Quyền riêng tư:
                                        </span>
                                        <span>
                                            <span class="inline-flex items-center px-2 py-1 rounded-full text-xs font-medium {% if targetDetails.isPrivate %}bg-red-100 text-red-800{% else %}bg-green-100 text-green-800{% endif %}">
                                                {% if targetDetails.isPrivate %}
                                                    <i class="fas fa-lock mr-1"></i>Riêng tư
                                                {% else %}
                                                    <i class="fas fa-globe mr-1"></i>Công khai
                                                {% endif %}
                                            </span>
                                        </span>
                                    </div>
                                    
                                    <div class="flex justify-between py-2">
                                        <span class="flex items-center text-gray-600">
                                            <i class="fas fa-calendar-plus mr-2 w-4"></i>Tham gia:
                                        </span>
                                        <span class="font-medium text-gray-900">{{ targetDetails.createdAt | date('DD/MM/YYYY') }}</span>
                                    </div>
                                </div>
                                
                                {% if targetDetails.bio %}
                                <div class="mt-6">
                                    <h6 class="font-bold text-blue-600 mb-3 flex items-center">
                                        <i class="fas fa-user-edit mr-2"></i>Tiểu sử:
                                    </h6>
                                    <div class="bg-gray-50 border-l-4 border-blue-500 p-4 rounded-r-lg">
                                        <p class="text-gray-800">{{ targetDetails.bio }}</p>
                                    </div>
                                </div>
                                {% endif %}

                                {% if targetDetails.bannedUntil %}
                                <div class="mt-6 bg-red-50 border border-red-200 rounded-lg p-4">
                                    <h6 class="font-bold text-red-800 flex items-center mb-2">
                                        <i class="fas fa-ban mr-2"></i>Tài khoản bị cấm
                                    </h6>
                                    <div class="text-sm text-red-700">
                                        <div><strong>Đến:</strong> {{ targetDetails.bannedUntil | date('DD/MM/YYYY HH:mm') }}</div>
                                        <div><strong>Lý do:</strong> {{ targetDetails.bannedReason }}</div>
                                    </div>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>

        <!-- Response Card -->
        {% if report.responder and report.responseContent %}
        <div class="bg-white rounded-xl shadow-lg mb-8 overflow-hidden">
            <div class="bg-green-600 text-white px-6 py-4">
                <h5 class="text-xl font-semibold flex items-center">
                    <i class="fas fa-reply mr-3"></i>
                    Phản hồi từ quản trị viên
                </h5>
            </div>
            <div class="p-6">
                <div class="bg-white rounded-xl p-6 shadow-md">
                    <div class="flex items-center justify-between mb-6">
                        <div class="flex items-center space-x-3">
                            <img src="{{ report.responder.avatar }}" alt="Avatar" class="w-12 h-12 rounded-full object-cover">
                            <div>
                                <div class="font-bold text-gray-900">{{ report.responder.name }}</div>
                                <div class="text-sm text-gray-500">@{{ report.responder.username }}</div>
                                <div class="text-xs text-gray-400">{{ report.responder.email }}</div>
                            </div>
                        </div>
                        <div class="text-right">
                            <div class="text-sm text-gray-500">
                                <i class="fas fa-clock mr-1"></i>
                                {{ report.updatedAt | date('DD/MM/YYYY HH:mm') }}
                            </div>
                        </div>
                    </div>
                    
                    <div>
                        <h6 class="font-bold text-blue-600 mb-3 flex items-center">
                            <i class="fas fa-comment-dots mr-2"></i>Nội dung phản hồi:
                        </h6>
                        <div class="bg-gray-50 border-l-4 border-blue-500 p-5 rounded-r-lg">
                            <p class="text-gray-800 leading-relaxed">{{ report.responseContent }}</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% else %}
        <div class="bg-white rounded-xl shadow-lg mb-8 overflow-hidden">
            <div class="bg-yellow-500 text-white px-6 py-4">
                <h5 class="text-xl font-semibold flex items-center">
                    <i class="fas fa-hourglass-half mr-3"></i>
                    Trạng thái xử lý
                </h5>
            </div>
            <div class="p-6">
                <div class="bg-blue-50 border border-blue-200 rounded-lg p-6">
                    <div class="flex items-center">
                        <div class="mr-4">
                            <i class="fas fa-info-circle text-4xl text-blue-500"></i>
                        </div>
                        <div>
                            <h6 class="font-bold text-blue-800 mb-1">Đang chờ xử lý</h6>
                            <p class="text-blue-700">Báo cáo này hiện tại chưa được quản trị viên phản hồi. Vui lòng chờ đợi.</p>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        {% endif %}    </div>

    <!-- Image Modal -->
    <div id="imageModal" class="fixed inset-0 z-50 hidden items-center justify-center bg-black bg-opacity-75">
        <div class="max-w-4xl mx-auto p-4">
            <div class="bg-white rounded-lg overflow-hidden">
                <div class="flex justify-between items-center p-4 border-b">
                    <h5 class="text-lg font-semibold">Xem ảnh</h5>
                    <button onclick="closeImageModal()" class="text-gray-500 hover:text-gray-700">
                        <i class="fas fa-times text-xl"></i>
                    </button>
                </div>
                <div class="p-4 text-center">
                    <img id="modalImage" src="" alt="Image" class="max-w-full max-h-96 mx-auto">
                </div>
            </div>
        </div>
    </div>

    <script>
        // Function to open image modal
        function openImageModal(imageUrl) {
            document.getElementById('modalImage').src = imageUrl;
            document.getElementById('imageModal').classList.remove('hidden');
            document.getElementById('imageModal').classList.add('flex');        }

        // Function to close image modal
        function closeImageModal() {
            document.getElementById('imageModal').classList.add('hidden');
            document.getElementById('imageModal').classList.remove('flex');
        }

        // Close modal when clicking outside
        document.getElementById('imageModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeImageModal();
            }
        });

        // Close modal when pressing ESC
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeImageModal();
            }
        });

        // Loading animation
        window.addEventListener('load', function() {
            document.body.classList.add('loaded');
        });

        // Smooth scrolling for anchor links
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const target = document.querySelector(this.getAttribute('href'));
                if (target) {
                    target.scrollIntoView({
                        behavior: 'smooth'
                    });
                }
            });
        });
    </script>
</body>
</html>
