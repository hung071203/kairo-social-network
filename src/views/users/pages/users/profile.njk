{% extends 'users/layouts/app.njk' %}
{% set title = 'Trang cá nhân' %}
{% block css %}
  <style>
    .scrollbar-hide::-webkit-scrollbar {
      display: none;
    }
    /* Ẩn scrollbar trên Firefox */
    .scrollbar-hide {
      scrollbar-width: none;
      -ms-overflow-style: none; /* IE 10+ */
    }
  </style>
{% endblock %}
{% block content %}
  <div
    class="w-full w-[1100px] h-[880px] overflow-y-auto scrollbar-hide scrollable-content">
    <!-- Cover photo container -->
    <div class="relative w-full">
      <div onclick="showImageModal('{{ target.background }}')" class="cursor-pointer">
        <img alt="Cover photo" class="w-full h-[300px] object-cover" height="300" src="{{ target.background }}" width="1200"/>
      </div>
      <div id="coverLoading" class="absolute inset-0 bg-black/50 flex items-center justify-center hidden z-10">
        <div class="loader border-4 border-t-transparent border-white rounded-full w-8 h-8 animate-spin"></div>
      </div>
      <!-- Edit cover button -->
      {% if isThisAccount %}
        <button
          class="absolute bottom-3 right-3 bg-[#18191a] text-[#e4e6eb] text-xs px-2 py-1 rounded-md border border-[#3a3b3c]
            hover:bg-[#3a3b3c] flex items-center gap-1"
          type="button"
          onclick="document.getElementById('coverInput').click()">
          <i class="fas fa-camera"></i>
          Chỉnh sửa ảnh bìa
        </button>
        <input type="file" id="coverInput" accept="image/*" class="hidden" onchange="handleCoverChange(event)"/>
      {% endif %}
      <script>
        async function handleCoverChange(event) {
          const file = event.target.files[0];
          if (! file) 
            return;
          
          const loadingEl = document.getElementById('coverLoading');
          loadingEl.classList.remove('hidden'); // Hiện loading
          if (! file.type.startsWith('image/')) {
            showToast({message: 'Chỉ được chọn ảnh!', type: 'error'});
            return;
          }
          const url = await uploadFile(file); // Hàm bạn đã có sẵn
          if (url) {
            await updateProfile({background: url}); // Cập nhật lên server
          }loadingEl.classList.add('hidden')
        }
        async function handleCoverChange1(event) {
          const file = event.target.files[0];
          if (! file) 
            return;
          
          const loadingEl = document.getElementById('coverLoading1');
          loadingEl.classList.remove('hidden'); // Hiện loading
          if (! file.type.startsWith('image/')) {
            showToast({message: 'Chỉ được chọn ảnh!', type: 'error'});
            return;
          }
          const url = await uploadFile(file); // Hàm bạn đã có sẵn
          if (url) {
            await updateProfile({avatar: url}); // Cập nhật lên server
          }loadingEl.classList.add('hidden');
        }
        async function updateProfile(data) {
          try {
            const response = await fetch(
              '/profile/update', {
                method: 'PATCH',
                headers: {
                  'Content-Type': 'application/json'
                },
                body: JSON.stringify(data) // Đây là key bạn muốn cập nhật
              }
            );
            const result = await response.json();
            if (! response.ok) {
              throw new Error(result.message || 'Lỗi khi cập nhật thông tin');
            }
            showToast({message: 'Cập nhật thành công', type: 'success', delay: 5000});
            setTimeout(() => {
              location.reload();
            }, 2000);
          } catch (error) {
            showToast({message: `Lỗi: ${
                error.message
              }`, type: 'error', delay: 5000});
          }
        }
      </script>
      <script>
        function showImageModal(src) {
          const modal = document.getElementById('imageModal');
          const modalImg = document.getElementById('modalImage');
          modalImg.src = src;
          modal.classList.remove('hidden');
        }
        function hideImageModal() {
          const modal = document.getElementById('imageModal');
          modal.classList.add('hidden');
        }
        // Optional: đóng modal khi bấm nền đen
        document.getElementById('imageModal').addEventListener('click', (e) => {
          if (e.target.id === 'imageModal') {
            hideImageModal();
          }
        });
      </script>
    </div>
    <!-- Profile info container -->
    <!-- Bọc toàn bộ phần profile -->
    <div
      class="px-4 -mt-16 flex flex-col sm:flex-row items-start sm:items-end gap-4 sm:gap-6 w-full">
      <!-- Profile picture -->
      <div class="relative flex-shrink-0">
        <img alt="Profile" class="w-32 h-32 rounded-full border-4 border-[#242526] object-cover" src="{{ target.avatar }}" onclick="showImageModal('{{ target.avatar }}')"/>
        <div
          id="coverLoading1"
          class="absolute top-0 left-0 w-full h-full bg-black/50 flex items-center justify-center hidden z-10 rounded-full">
          <div class="loader border-4 border-t-transparent border-white rounded-full w-8 h-8 animate-spin"></div>
        </div>
        {% if isThisAccount %}
          <button
            class="absolute bottom-0 right-0 bg-[#18191a] border border-[#3a3b3c] rounded-full p-1 text-[#e4e6eb] hover:bg-[#3a3b3c]"
            onclick="document.getElementById('coverInput1').click()">
            <i class="fas fa-camera"></i>
          </button>
          <input type="file" id="coverInput1" accept="image/*" class="hidden" onchange="handleCoverChange1(event)"/>
        {% endif %}
      </div>
      <div id="imageModal" class="fixed inset-0 z-50 bg-black/80 flex items-center justify-center hidden">
        <img id="modalImage" src="" alt="Preview" class="max-w-full max-h-full rounded-lg shadow-lg"/>
        <button onclick="hideImageModal()" class="absolute top-5 right-5 text-white text-2xl font-bold hover:text-red-500">
          &times;
        </button>
      </div>
      <!-- Tên + bạn bè bên trái, nút bên phải -->
      <div
        class="flex justify-between items-center w-full flex-wrap gap-2">
        <!-- Tên + bạn bè -->
        <div class="flex flex-col sm:flex-row sm:items-center gap-1 sm:gap-2 flex-grow min-w-0">
          <h1 class="text-[#e4e6eb] font-semibold text-lg sm:text-xl truncate">{{ target.name }}</h1>
          <span class="text-[#b0b3b8] text-xs sm:text-sm whitespace-nowrap">{{ target.username }}</span>
        </div>
        <!-- Các nút bên phải -->
        <div class="flex gap-2">
          {% if target._id.toString() == user._id.toString() %}
            <!-- Chính chủ -->
            <button
              class="bg-[#3a3b3c] hover:bg-[#4e4f50] text-[#e4e6eb] text-xs sm:text-sm font-semibold px-3 py-1.5 rounded-md flex
                items-center gap-1"
              onclick="openEditInfoModal()">
              <i class="fas fa-pen"></i>
              Chỉnh sửa trang cá nhân
            </button>
          {% else %}
            {% set fromUser = null %}
            {% set fromTarget = null %}
            {% for f in follows %}
              {% if f.requester.toString() == user._id.toString() and f.target.toString() == target._id.toString() %}
                {% set fromUser = f %}
              {% elif f.requester.toString() == target._id.toString() and f.target.toString() == user._id.toString() %}
                {% set fromTarget = f %}
              {% endif %}
            {% endfor %}
            <div class="relative inline-block">
              {% if fromUser %}
                {% if fromUser.status == 'pending' %}
                  <button
                    class="h-8 bg-[#3a3b3c] hover:bg-[#4e4f50] text-[#e4e6eb] text-xs sm:text-sm font-semibold px-3 rounded-md flex
                      items-center gap-1"
                    type="button"
                    onclick="toggleDropdownPending('{{ target._id }}')">
                    <i class="fas fa-hourglass-half"></i>
                    Đang chờ xác nhận
                    <i class="fas fa-chevron-down ml-1 text-[10px]"></i>
                  </button>
                  <div
                    id="dropdown-pending-{{ target._id }}"
                    class="absolute top-full left-0 mt-1 hidden flex-col bg-[#242526] text-[#e4e6eb] rounded-md w-52 shadow-lg z-10 p-1">
                    <button
                      class="h-8 w-full text-left hover:bg-[#3a3b3c] px-4 text-xs sm:text-sm flex items-center gap-2"
                      onclick="toggleFollow('{{ target._id }}')">
                      <i class="fas fa-times"></i>
                      Hủy yêu cầu theo dõi
                    </button>
                  </div>
                {% elif fromUser.status == 'accepted' %}
                  <button
                    class="h-8 bg-[#3a3b3c] hover:bg-[#4e4f50] text-[#e4e6eb] text-xs sm:text-sm font-semibold px-3 rounded-md flex
                      items-center gap-1"
                    type="button"
                    onclick="toggleDropdownAccepted('{{ target._id }}')">
                    <i class="fas fa-user-check"></i>
                    Đang theo dõi
                    <i class="fas fa-chevron-down ml-1 text-[10px]"></i>
                  </button>
                  <div
                    id="dropdown-accepted-{{ target._id }}"
                    class="absolute top-full left-0 mt-1 hidden flex-col bg-[#242526] text-[#e4e6eb] rounded-md w-52 shadow-lg z-10 p-1">
                    <button
                      class="h-8 w-full text-left hover:bg-[#3a3b3c] px-4 text-xs sm:text-sm flex items-center gap-2"
                      onclick="toggleFollow('{{ target._id }}')">
                      <i class="fas fa-user-times"></i>
                      Bỏ theo dõi
                    </button>
                  </div>
                {% endif %}
              {% elif fromTarget and fromTarget.status == 'accepted' %}
                <button
                  class="h-8 bg-[#3a3b3c] hover:bg-[#4e4f50] text-[#e4e6eb] text-xs sm:text-sm font-semibold px-3 rounded-md flex
                    items-center gap-1"
                  type="button"
                  onclick="toggleDropdownAccepted('{{ target._id }}')">
                  <i class="fas fa-user-plus"></i>
                  Người này theo dõi bạn
                  <i class="fas fa-chevron-down ml-1 text-[10px]"></i>
                </button>
                <div
                  id="dropdown-accepted-{{ target._id }}"
                  class="absolute top-full left-0 mt-1 hidden flex-col bg-[#242526] text-[#e4e6eb] rounded-md w-52 shadow-lg z-10 p-1">
                  <button
                    class="h-8 w-full text-left hover:bg-[#3a3b3c] px-4 text-xs sm:text-sm flex items-center gap-2"
                    onclick="toggleFollow('{{ target._id }}')">
                    <i class="fas fa-user-check"></i>
                    Theo dõi lại
                  </button>
                  <button
                    class="h-8 w-full text-left hover:bg-[#3a3b3c] px-4 text-xs sm:text-sm flex items-center gap-2"
                    onclick="toggleFollowReject('{{ target._id }}')">
                    <i class="fas fa-user-times"></i>
                    Gỡ theo dõi của họ
                  </button>
                </div>
              {% elif fromTarget and fromTarget.status == 'pending' %}
                <button
                  class="h-8 bg-[#3a3b3c] hover:bg-[#4e4f50] text-[#e4e6eb] text-xs sm:text-sm font-semibold px-3 rounded-md flex
                    items-center gap-1"
                  type="button"
                  onclick="toggleDropdownAccepted('{{ target._id }}')">
                  <i class="fas fa-user-plus"></i>
                  Yêu cầu theo dõi bạn
                  <i class="fas fa-chevron-down ml-1 text-[10px]"></i>
                </button>
                <div
                  id="dropdown-accepted-{{ target._id }}"
                  class="absolute top-full left-0 mt-1 hidden flex-col bg-[#242526] text-[#e4e6eb] rounded-md w-52 shadow-lg z-10 p-1">
                  <button
                    class="h-8 w-full text-left hover:bg-[#3a3b3c] px-4 text-xs sm:text-sm flex items-center gap-2"
                    onclick="toggleFollowAccept('{{ target._id }}')">
                    <i class="fas fa-user-check"></i>
                    Chấp nhận
                  </button>
                  <button
                    class="h-8 w-full text-left hover:bg-[#3a3b3c] px-4 text-xs sm:text-sm flex items-center gap-2"
                    onclick="toggleFollowReject('{{ target._id }}')">
                    <i class="fas fa-user-times"></i>
                    Từ chối
                  </button>
                </div>
              {% else %}
                <button
                  class="h-8 bg-[#2374e1] hover:bg-[#1a64c8] text-white text-xs sm:text-sm font-semibold px-3 rounded-md flex items-center
                    gap-1"
                  type="button"
                  onclick="toggleFollow('{{ target._id }}')">
                  <i class="fas fa-user-check"></i>
                  Theo dõi
                </button>
              {% endif %}
            </div>
            <script>
              function toggleDropdownPending(targetId) {
                const dropdown = document.getElementById(`dropdown-pending-${targetId}`);
                if (! dropdown) 
                  return;
                
                // Ẩn các dropdown khác cùng loại nếu cần
                document.querySelectorAll('[id^="dropdown-pending-"]').forEach(d => {
                  if (d !== dropdown) 
                    d.classList.add('hidden');
                  
                });
                dropdown.classList.toggle('hidden');
              }
              function toggleDropdownAccepted(targetId) {
                const dropdown = document.getElementById(`dropdown-accepted-${targetId}`);
                if (! dropdown) 
                  return;
                
                document.querySelectorAll('[id^="dropdown-accepted-"]').forEach(d => {
                  if (d !== dropdown) 
                    d.classList.add('hidden');
                  
                });
                dropdown.classList.toggle('hidden');
              }
              // Đóng dropdown khi click ra ngoài
              document.addEventListener('click', function (e) {
                if (! e.target.closest('[id^="dropdown-"]') && ! e.target.closest('button[onclick^="toggleDropdown"]')) {
                  document.querySelectorAll('[id^="dropdown-pending-"], [id^="dropdown-accepted-"]').forEach(d => d.classList.add('hidden'));
                }
              });
            </script>
          {% endif %}
        </div>
        <div class="flex gap-2">
          <div class="relative inline-block">
            <button
              class="h-8 bg-[#3a3b3c] hover:bg-[#4e4f50] text-[#e4e6eb] text-xs sm:text-sm font-semibold px-3 rounded-md flex
                items-center gap-1 options-button"
              type="button"
              onclick="toggleDropdownOther(this)"
              data-dropdown-id="dropdown-other-682c9ae4b8492a1b3c1cb148">
              <i class="fas fa-ellipsis-h"></i>
            </button>
            <div
              id="dropdown-other-682c9ae4b8492a1b3c1cb148"
              class="absolute test1 top-full right-0 mt-1 hidden flex-col bg-[#242526] text-[#e4e6eb] rounded-md w-52 shadow-lg z-10
                p-1">
              <button
                class="h-8 w-full text-left hover:bg-[#3a3b3c] px-4 text-xs sm:text-sm flex items-center gap-2 dropdown-item"
                onclick="openReportModal('{{ target._id }}', 'USER')">
                <i class="fas fa-flag"></i>
                Báo cáo người dùng
              </button>
            </div>
            <script>
              function toggleDropdownOther(button) {
                const dropdownId = button.getAttribute('data-dropdown-id');
                const dropdown = document.getElementById(dropdownId);
                // Ẩn các dropdown khác
                document.querySelectorAll('.test1').forEach(menu => {
                  if (menu.id !== dropdownId) {
                    menu.classList.add('hidden');
                  }
                });
                // Toggle dropdown hiện tại
                dropdown.classList.toggle('hidden');
              }
              // Tự động đóng khi click ra ngoài dropdown
              document.addEventListener('click', function (e) {
                const isDropdownButton = e.target.closest('.options-button');
                const isDropdownMenu = e.target.closest('.test1');
                // Nếu không click vào nút hoặc menu thì ẩn tất cả dropdown
                if (! isDropdownButton && ! isDropdownMenu) {
                  document.querySelectorAll('.test1').forEach(menu => {
                    menu.classList.add('hidden');
                  });
                }
              });
            </script>
          </div>
        </div>
      </div>
    </div>
    <!-- Navigation bar with tab functionality -->
    <nav class="px-4 mt-4 border-b border-[#3a3b3c] flex flex-wrap gap-2 text-[#b0b3b8] text-xs sm:text-sm">
      <button
        data-tab-target="#posts"
        class="text-[#e4e6eb] font-semibold border-b-2 border-[#1877f2] pb-2 cursor-pointer"
        type="button">
        Bài viết
      </button>
      <button data-tab-target="#about" class="hover:text-[#e4e6eb] pb-2 cursor-pointer text-[#b0b3b8]" type="button">
        Giới thiệu
      </button>
      {% if target._id.toString() == user._id.toString() %}
        <a class="hover:text-[#e4e6eb] pb-2" href="/follow?tab=following">Người bạn theo dõi</a>
        <a class="hover:text-[#e4e6eb] pb-2" href="/follow?tab=followers">Đang theo dõi bạn</a>
      {% endif %}
    </nav>
    <!-- Main content area with tab contents -->
    <main
      class="mt-4 w-full w-2xl mx-auto w-[1100px] mx-auto pb-20">
      <!-- Posts tab content (default visible) -->
      <section id="posts" data-tab-content="data-tab-content" class="block w-[1100px]">
        {% if target._id.toString() == user._id.toString() %}
          <div class="bg-[#242526] rounded-lg p-3 space-y-3 w-[672px] mx-auto">
            <div class="flex items-center space-x-3">
              <img alt="User avatar with short hair and light skin tone" class="w-9 h-9 rounded-full object-cover" height="36" src="{{ user.avatar }}" width="36"/>
              <button
                onclick="openPostModal()"
                class="bg-[#3a3b3c] rounded-full flex-1 py-2 px-4 text-left text-sm text-[#b0b3b8] hover:bg-[#4e4f50] transition">
                {{ user.name }} ơi, bạn đang nghĩ gì thế?
              </button>
            </div>
          </div>
        {% endif %}
        <div id="posts-container" class="max-w-2xl mx-auto py-4 space-y-4">
          {% if isThisAccount or not target.isPrivate == true or(fromUser and fromUser.status == 'accepted') %}
            <div
              id="posts-list"><!-- Bài đăng sẽ render ở đây -->
            </div>
            <div id="loading-posts-spinner" class="flex justify-center py-4 hidden">
              <div class="w-6 h-6 border-4 border-blue-400 border-t-transparent rounded-full animate-spin"></div>
            </div>
          {% else %}
            <div class="bg-[#242526] rounded-lg p-5 max-w-[800px] mx-auto flex items-center justify-center">
              <p class="text-[#e4e6eb] text-sm text-center">Trang cá nhân này là riêng tư. Bạn không thể xem bài đăng của họ.</p>
            </div>
          {% endif %}
        </div>
      </section>
      <div
        id="postModal"
        class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden"
        role="dialog"
        aria-modal="true">
        <div class="bg-[#242526] rounded-xl max-w-md w-full shadow-lg max-h-[75vh] overflow-y-auto">
          <header class="flex justify-between items-center border-b border-[#3a3b3c] py-3 px-4">
            <h2 class="text-[#e4e6eb] font-semibold text-lg">Tạo bài viết</h2>
            <button onclick="closePostModal()" class="text-[#b0b3b8] hover:bg-[#3a3b3c] rounded-full p-1">✕</button>
          </header>
          <section class="p-4 space-y-4">
            <div class="flex items-center space-x-3">
              <img alt="Profile" class="w-10 h-10 rounded-full object-cover" src="{{ user.avatar }}"/>
              <div>
                <p class="text-[#e4e6eb] font-semibold text-sm">{{ user.name }}</p>
                <div class="relative inline-block text-left">
                  <button
                    id="privacyToggle"
                    onclick="togglePrivacyMenu()"
                    type="button"
                    class="inline-flex items-center space-x-1 bg-[#3a3b3c] text-[#b0b3b8] text-xs font-semibold rounded px-2 py-0.5">
                    <i id="privacyIcon" class="fas fa-user-friends text-[10px]"></i>
                    <span id="privacyLabel">Người theo dõi</span>
                    <svg class="h-3 w-3" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                      <polyline points="6 9 12 15 18 9"></polyline>
                    </svg>
                  </button>
                  <!-- Dropdown menu -->
                  <div id="privacyMenu" class="absolute z-10 mt-1 w-36 bg-[#3a3b3c] rounded-md shadow-lg hidden">
                    <button
                      class="block w-full text-left px-3 py-1 text-xs text-[#e4e6eb] hover:bg-[#4e4f50]"
                      onclick="setPrivacy('FOLLOWERS', 'Người theo dõi')">
                      <i class="fas fa-user-friends text-[10px]"></i>
                      Người theo dõi
                    </button>
                    <button
                      class="block w-full text-left px-3 py-1 text-xs text-[#e4e6eb] hover:bg-[#4e4f50]"
                      onclick="setPrivacy('PUBLIC', 'Mọi người')">
                      <i class="fas fa-globe-americas text-[10px]"></i>
                      Mọi người
                    </button>
                    <button
                      class="block w-full text-left px-3 py-1 text-xs text-[#e4e6eb] hover:bg-[#4e4f50]"
                      onclick="setPrivacy('PRIVATE', 'Chỉ mình tôi')">
                      <i class="fas fa-lock text-[10px]"></i>
                      Chỉ mình tôi
                    </button>
                  </div>
                </div>
              </div>
              <!-- Ẩn input để gửi lên form -->
              <input type="hidden" id="privacyValue" name="privacy" value="FOLLOWERS"></div>
              <div class="relative w-full">
                <div id="fakePlaceholder" class="absolute top-2 left-2 text-[#b0b3b8] pointer-events-none select-none text-base">
                  Bạn đang nghĩ gì?
                </div>
                <!-- Hiển thị phần text đã được highlight -->
                <div
                  id="highlightContent"
                  class="whitespace-pre-wrap break-words bg-[#242526] text-base text-[#e4e6eb] rounded-md p-2 pointer-events-none w-full
                    min-h-[72px]"></div>
                <!-- Phần nhập liệu cho người dùng -->
                <div
                  id="postContent"
                  contenteditable="true"
                  class="absolute top-0 left-0 w-full resize-none bg-transparent text-transparent caret-white text-base rounded-md p-2
                    focus:outline-none"
                  placeholder="Bạn đang nghĩ gì?"></div>
              </div>
              <div class="flex justify-between items-center">
                <button
                  class="flex items-center space-x-1 text-[#4bbf67] hover:text-green-400"
                  onclick="document.getElementById('mediaUpload').click()"
                  type="button">
                  📷
                  <span>Ảnh / Video</span>
                </button>
              </div>
              <input type="file" id="mediaUpload" accept="image/*,video/*" multiple class="hidden"/>
              <div id="mediaPreview" class="flex flex-wrap gap-2"></div>
              <button
                id="submitBtn"
                class="w-full bg-[#3a3b3c] text-[#b0b3b8] font-semibold rounded-md py-2 cursor-not-allowed"
                disabled
                onclick="submitPost()">
                Đăng
              </button>
            </section>
          </div>
        </div>
        <script>
          function togglePrivacyMenu() {
            const menu = document.getElementById('privacyMenu');
            menu.classList.toggle('hidden');
          }
          // Cập nhật label và giá trị form
          function setPrivacy(value, label) {
            const icon = document.getElementById('privacyIcon');
            const labelElement = document.getElementById('privacyLabel');
            const hiddenInput = document.getElementById('privacyValue');
            const menu = document.getElementById('privacyMenu');
            // Cập nhật icon theo giá trị
            switch (value) {
              case 'PUBLIC': icon.className = 'fas fa-globe-americas text-[10px]';
                break;
              case 'FOLLOWERS': icon.className = 'fas fa-user-friends text-[10px]';
                break;
              case 'PRIVATE': icon.className = 'fas fa-lock text-[10px]';
                break;
            }
            // Cập nhật text và giá trị form
            labelElement.innerText = label;
            hiddenInput.value = value;
            // Ẩn menu
            menu.classList.add('hidden');
          }
          const postContent = document.getElementById('postContent');
          const highlightContent = document.getElementById('highlightContent');
          const mediaUpload = document.getElementById('mediaUpload');
          const mediaPreview = document.getElementById('mediaPreview');
          const submitBtn = document.getElementById('submitBtn');
          let selectedFiles = [];
          const fakePlaceholder = document.getElementById('fakePlaceholder');
          postContent.addEventListener('input', () => {
            const raw = postContent.innerText;
            const highlighted = raw.replace(/#(\w+)/g, '<span class="text-blue-400 font-semibold">#$1</span>');
            highlightContent.innerHTML = highlighted + '\n';
            // Ẩn/hiện placeholder
            fakePlaceholder.style.display = raw.trim().length === 0
              ? 'block'
              : 'none';
            updateSubmitButtonState();
          });
          postContent.addEventListener('input', () => {
            const raw = postContent.innerText;
            const highlighted = raw.replace(/#(\w+)/g, '<span class="text-blue-400 font-semibold">#$1</span>');
            highlightContent.innerHTML = highlighted + '\n';
            updateSubmitButtonState();
          });
          function openPostModal() {
            document
              .getElementById('postModal')
              .classList
              .remove('hidden');
          }
          function closePostModal() { // Ẩn modal
            document
              .getElementById('postModal')
              .classList
              .add('hidden');
            // Reset nội dung
            document.getElementById('postContent').innerText = '';
            document.getElementById('highlightContent').innerText = '';
            document
              .getElementById('fakePlaceholder')
              .style
              .display = 'block';
            // Reset file upload
            const fileInput = document.getElementById('mediaUpload');
            fileInput.value = '';
            document.getElementById('mediaPreview').innerHTML = '';
            // Reset nút Đăng
            submitBtn.disabled = true;
            submitBtn.classList.remove('bg-[#1877f2]', 'text-white', 'cursor-pointer');
            submitBtn.classList.add('bg-[#3a3b3c]', 'text-[#b0b3b8]', 'cursor-not-allowed');
            // Reset privacy nếu cần
            setPrivacy('FOLLOWERS', 'Người theo dõi'); // hoặc giá trị mặc định của bạn
          }
          function updateSubmitButtonState() {
            const hasText = postContent
              .innerText
              .trim()
              .length > 0;
            const hasMedia = selectedFiles.length > 0;
            if (hasText || hasMedia) {
              submitBtn.disabled = false;
              submitBtn.classList.remove('bg-[#3a3b3c]', 'text-[#b0b3b8]', 'cursor-not-allowed');
              submitBtn.classList.add('bg-[#1877f2]', 'text-white', 'cursor-pointer');
            } else {
              submitBtn.disabled = true;
              submitBtn.classList.remove('bg-[#1877f2]', 'text-white', 'cursor-pointer');
              submitBtn.classList.add('bg-[#3a3b3c]', 'text-[#b0b3b8]', 'cursor-not-allowed');
            }
          }
          mediaUpload.addEventListener('change', (event) => {
            const files = Array.from(event.target.files);
            const hasImage = selectedFiles.some(f => f.type.startsWith('image/'));
            const hasVideo = selectedFiles.some(f => f.type.startsWith('video/'));
            let addingImage = files.some(f => f.type.startsWith('image/'));
            let addingVideo = files.some(f => f.type.startsWith('video/'));
            // Chặn nếu đang chọn 2 loại khác nhau
            if ((hasImage && addingVideo) || (hasVideo && addingImage) || (addingImage && addingVideo)) {
              showToast({message: "Chỉ được chọn ảnh hoặc video", header: "Cảnh báo", type: "warning", delay: 5000});
              mediaUpload.value = '';
              return;
            }
            for (const file of files) {
              if (file.type.startsWith('image/')) {
                selectedFiles.push(file);
              } else if (file.type.startsWith('video/')) {
                if (selectedFiles.some(f => f.type.startsWith('video/'))) {
                  showToast({message: "Chỉ được đăng 1 video", header: "Cảnh báo", type: "warning", delay: 5000});
                  continue;
                }
                selectedFiles.push(file);
              } else {
                showToast({message: "Chỉ hỗ trợ ảnh hoặc video", header: "Cảnh báo", type: "warning", delay: 5000});
              }
            }
            renderMediaPreview();
            updateSubmitButtonState();
            mediaUpload.value = '';
          });
          function renderMediaPreview() {
            mediaPreview.innerHTML = '';
            selectedFiles.forEach((file, index) => {
              const wrapper = document.createElement('div');
              wrapper.className = 'relative group inline-block mr-2 mb-2';
              const removeBtn = document.createElement('button');
              removeBtn.innerHTML = '&times;';
              removeBtn.className = 'absolute top-0 right-0 bg-black bg-opacity-50 text-white rounded-full w-5 h-5 flex items-center justify-center text-sm h' +
                  'idden group-hover:flex';
              removeBtn.onclick = () => {
                selectedFiles.splice(index, 1);
                renderMediaPreview();
                updateSubmitButtonState();
              };
              if (file.type.startsWith('image/')) {
                const img = document.createElement('img');
                img.src = URL.createObjectURL(file);
                img.className = 'w-24 h-24 object-cover rounded';
                wrapper.appendChild(img);
              } else if (file.type.startsWith('video/')) {
                const video = document.createElement('video');
                video.src = URL.createObjectURL(file);
                video.controls = true;
                video.className = 'w-48 max-h-64 rounded';
                wrapper.appendChild(video);
              }
              wrapper.appendChild(removeBtn);
              mediaPreview.appendChild(wrapper);
            });
          }
          function submitPost() {
            submitBtn.disabled = true;
            submitBtn.classList.remove('bg-[#1877f2]', 'text-white', 'cursor-pointer');
            submitBtn.classList.add('bg-[#3a3b3c]', 'text-[#b0b3b8]', 'cursor-not-allowed');
            const content = postContent.innerText;
            const formData = new FormData();
            formData.append('content', content);
            if (
              selectedFiles.some(f => f.type.startsWith('image/')) &&
              selectedFiles.some(f => f.type.startsWith('video/'))
            ) {
              showToast({message: "Không thể đăng ảnh và video cùng lúc", header: "Cảnh báo", type: "warning", delay: 5000});
              return;
            }
            let videoCount = 0;
            for (const file of selectedFiles) {
              if (file.type.startsWith('video/')) {
                videoCount++;
                if (videoCount > 1) {
                  showToast({message: "Chỉ được đăng 1 video", header: "Cảnh báo", type: "warning", delay: 5000});
                  return;
                }
                formData.append('video', file);
              } else if (file.type.startsWith('image/')) {
                formData.append('images', file);
              }
            }
            const privacy = document.getElementById('privacyValue').value;
            formData.append('privacy', privacy);
            // Gửi yêu cầu POST
            fetch('/posts', {
              method: 'POST',
              body: formData
            })
              .then(async res => {
                if (!res.ok) {
                  const error = await res.text();
                  // Thử parse nếu chắc chắn nó là JSON, còn không thì dùng raw text
                  const {message} = JSON.parse(error);
                  throw new Error (`Lỗi: ${message}`);
                }
                return res.json();
              })
              .then(data => {
                showToast({message: "Đăng thành công!", header: "Thông báo", type: "success", delay: 3000});
                closePostModal();
                setTimeout(() => {
                  location.reload();
                }, 2000);
              })
              .catch(err => {
                console.error(err);
                showToast({
                  message: err.message || "Có lỗi xảy ra",
                  header: "Lỗi!",
                  type: "error",
                  delay: 5000
                });
                submitBtn.disabled = false;
                submitBtn.classList.remove('bg-[#3a3b3c]', 'text-[#b0b3b8]', 'cursor-not-allowed');
                submitBtn.classList.add('bg-[#1877f2]', 'text-white', 'cursor-pointer');
              });
          }
        </script>
