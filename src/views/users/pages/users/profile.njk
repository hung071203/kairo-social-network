    <script>
      // Simple tab switching script
      document.addEventListener("DOMContentLoaded", function () {
        const tabs = document.querySelectorAll("[data-tab-target]");
        const tabContents = document.querySelectorAll("[data-tab-content]");
        tabs.forEach((tab) => {
          tab.addEventListener("click", () => {
            const target = document.querySelector(tab.dataset.tabTarget);
            tabContents.forEach((content) => {
              content.classList.add("hidden");
            });
            tabs.forEach((t) => {
              t.classList.remove("text-[#e4e6eb]", "font-semibold", "border-b-2", "border-[#1877f2]");
              t.classList.add("text-[#b0b3b8]");
            });
            tab.classList.add("text-[#e4e6eb]", "font-semibold", "border-b-2", "border-[#1877f2]");
            tab.classList.remove("text-[#b0b3b8]");
            target.classList.remove("hidden");
          });
        });
      });
    </script>
    <script>
      let selectedPostId = null;
      // ==== MỞ / ĐÓNG MODAL ====
      function openChangeStatusModal(postId) {
        selectedPostId = postId;
        document
          .getElementById('changeStatusModal')
          .classList
          .remove('hidden');
      }
      function closeChangeStatusModal() {
        selectedPostId = null;
        document
          .getElementById('changeStatusModal')
          .classList
          .add('hidden');
      }
      function openReportModal(postId, type = 'POST') {
        selectedPostId = postId;
        document.getElementById('reportReason').value = '';
        document.getElementById('reportPostId').value = postId;
        document.getElementById('type').value = type;
        const reportTitle = document.getElementById('report-title');
        const blockWrapper = document.getElementById('blockUserWrapper');
        document.getElementById('blockUserToggle').checked = true; // Reset toggle
        if (type === 'USER') {
          reportTitle.innerText = 'Báo cáo người dùng';
          blockWrapper.classList.remove('hidden');
        } else {
          reportTitle.innerText = 'Báo cáo bài viết';
          blockWrapper.classList.add('hidden');
        }
        document
          .getElementById('reportModal')
          .classList
          .remove('hidden');
      }
      function closeReportModal() {
        selectedPostId = null;
        document
          .getElementById('reportModal')
          .classList
          .add('hidden');
      }
      function openDeleteModal(postId) {
        selectedPostId = postId;
        document
          .getElementById('deleteModal')
          .classList
          .remove('hidden');
      }
      function closeDeleteModal() {
        selectedPostId = null;
        document
          .getElementById('deleteModal')
          .classList
          .add('hidden');
      }
      // ==== GỬI YÊU CẦU ====
      async function setPrivacyAndSubmit(value) {
        if (! selectedPostId) 
          return;
        
        try {
          const res = await fetch (`/posts/update-type/${selectedPostId}`, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(
            {type: value})
          });
          if (! res.ok) {
            const err = await res.json();
            throw new Error(err.message || 'Lỗi khi cập nhật trạng thái');
          }
          showToast({message: `Cập nhật thành công thành: ${value}`, type: "success", delay: 5000});
          setTimeout(() => {
            location.reload();
          }, 2000);
        } catch (error) {
          showToast({
              message: `Lỗi: ${
              error.message
            }`,
            type: "error",
            delay: 5000
          });
        } finally {
          closeChangeStatusModal();
          selectedPostId = null;
        }
      }
      async function submitReport() {
        const blockUser = document.getElementById('blockUserToggle').checked;
        const reason = document
          .getElementById('reportReason')
          .value
          .trim();
        if (! reason) 
          return showToast({message: "Vui lòng nhập lý do báo cáo", type: "warning", delay: 5000});
        
        const payload = {
          target: selectedPostId,
          reason,
          type: document.getElementById('type').value || 'POST'
        };
        if (document.getElementById('type').value === 'USER') {
          payload.blockUser = blockUser;
        }
        try {
          const res = await fetch('/reports', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify(payload)
          });
          if (! res.ok) {
            const err = await res.json();
            throw new Error(err.message || 'Lỗi khi gửi báo cáo');
          }
          showToast({message: "Báo cáo đã được gửi thành công", type: "success", delay: 5000});
          closeReportModal();
          setTimeout(() => {
            if (type === 'USER' && blockUser) {
              window.location.href = '/home';
            } else {
              location.reload();
            }
          }, 2000);
        } catch (error) {
          showToast({
              message: `Lỗi: ${
              error.message
            }`,
            type: "error",
            delay: 5000
          });
        } finally {
          selectedPostId = null;
        }
      }
      async function confirmDeletePost() {
        if (! selectedPostId) 
          return;
        
        try {
          const res = await fetch (`/posts/${selectedPostId}`, {method: 'DELETE'});
          if (! res.ok) {
            const err = await res.json();
            throw new Error(err.message || 'Lỗi khi xoá bài viết');
          }
          showToast({message: "Xoá bài viết thành công", type: "success", delay: 5000});
          setTimeout(() => {
            location.reload();
          }, 2000);
        } catch (error) {
          showToast({
              message: `Lỗi: ${
              error.message
            }`,
            type: "error",
            delay: 5000
          });
        } finally {
          closeDeleteModal();
          selectedPostId = null;
        }
      }
    </script>
    <script>
      function formatDateTime(isoString) {
        const date = new Date(isoString);
        const options = {
          day: '2-digit',
          month: 'long',
          hour: '2-digit',
          minute: '2-digit',
          hour12: false,
          timeZone: 'Asia/Ho_Chi_Minh'
        };
        const formatter = new Intl.DateTimeFormat('vi-VN', options);
        const parts = formatter.formatToParts(date);
        const day = parts.find(p => p.type === 'day').value;
        const month = parts.find(p => p.type === 'month').value;
        const hour = parts.find(p => p.type === 'hour').value;
        const minute = parts.find(p => p.type === 'minute').value;
        return `${day} ${month} lúc ${hour}:${minute}`;
      }
      function renderMedia(mediaUrls, postId) {
        if (! mediaUrls || mediaUrls.length === 0) 
          return '';
        
        if (mediaUrls.length === 1 && mediaUrls[0].mimeType.startsWith('video/')) {
          return `
                  <video class="w-full max-w-full rounded-md cursor-pointer" height="600" width="600" controls onclick="goToPostDetail('${postId}')">
                      <source src="${
            mediaUrls[0].url
          }" type="${
            mediaUrls[0].mimeType
          }">
                      Trình duyệt của bạn không hỗ trợ video.
                  </video>
              `;
        }
        if (mediaUrls.length === 1 && mediaUrls[0].mimeType.startsWith('image/')) {
          return `
                  <img
                      alt="Single photo"
                      class="w-full max-w-full rounded-md cursor-pointer"
                      height="600"
                      src="${
            mediaUrls[0].url
          }"
                      width="600"
                      onclick="goToPostDetail('${postId}')"
                  />
              `;
        }
        const maxDisplay = 4;
        const mediaCount = mediaUrls.length;
        let mediaHtml = '<div class="grid grid-cols-2 gap-1 rounded-md overflow-hidden relative">';
        for (let i = 0; i < Math.min(mediaCount, maxDisplay); i++) {
          const media = mediaUrls[i];
          if (media.mimeType.startsWith('image/')) {
            if (i === 3 && mediaCount > 4) {
              mediaHtml += `
                          <div class="image-container overlay relative cursor-pointer" onclick="goToPostDetail('${postId}')">
                              <img
                                  alt="Photo ${
                i + 1
              } / ${mediaCount}"
                                  class="w-full object-cover aspect-square"
                                  height="300"
                                  src="${
                media.url
              }"
                                  width="300"/>
                              <div class="image-overlay">+${
                mediaCount - 4
              }</div>
                          </div>
                      `;
            } else {
              mediaHtml += `
                          <img
                              alt="Photo ${
                i + 1
              }"
                              class="w-full object-cover aspect-square cursor-pointer"
                              height="300"
                              src="${
                media.url
              }"
                              width="300"
                              onclick="goToPostDetail('${postId}')"
                          />
                      `;
            }
          }
        }
        mediaHtml += '</div>';
        return mediaHtml;
      }
      function renderTags(tags, content) {
        if (! tags || tags.length === 0) 
          return content;
        
        // Lấy danh sách tên tag (không có #)
        const tagNames = tags.map(tag => tag.name);
        // Biểu thức chính quy để tìm hashtag hợp lệ
        const tagRegex = /(^|\s)#([a-zA-Z0-9_]+)(?=\s|$|[.,!?])/g;
        // Thay thế hashtag bằng liên kết HTML
        const textWithTags = content.replace(tagRegex, (match, prefix, tagName) => {
          if (tagNames.includes(tagName)) {
            return `${prefix}<a href="/home/search?q=${
              encodeURIComponent('#' + tagName)
            }" class="text-blue-400 hover:underline">#${tagName}</a>`;
          }
          return match; // Giữ nguyên nếu tag không có trong danh sách
        });
        return textWithTags;
      }
      function renderType(type) {
        if (type === 'PUBLIC') {
          return '<i class="fas fa-globe-americas text-[11px]"></i>';
        } else if (type === 'FOLLOWERS') {
          return '<i class="fas fa-user-friends text-[11px]"></i>';
        } else if (type === 'PRIVATE') {
          return '<i class="fas fa-lock text-[11px]"></i>';
        }
        return '';
      }
      function renderPost(post) {
        const {
          author,
          content,
          mediaUrls,
          likes,
          commentsCount,
          type,
          tags,
          createdAt,
          _id,
          isSearch = false
        } = post;
        const highlightClasses = isSearch
          ? 'border border-blue-500 shadow-lg shadow-blue-500/30'
          : '';
        const formattedDate = formatDateTime(createdAt);
        const typeText = type === 'PUBLIC'
          ? 'Công khai'
          : type == 'FOLLOWERS'
            ? 'Theo dõi'
            : 'Chỉ mình tôi';
        const tagsHtml = renderTags(tags, content);
        const mediaHtml = renderMedia(mediaUrls, _id);
        const typeIcon = renderType(type);
        const currentUserId = '{{ user._id }}';
        // Check if current user has liked the post
        const isLiked = likes.includes(currentUserId);
        // Set like button color based on like status
        const likeButtonColor = isLiked
          ? 'text-blue-600'
          : 'text-gray-400';
        return `
              <article class="bg-[#242526] rounded-lg p-3 space-y-2 relative w-full ${highlightClasses} mb-4">
                  <header class="flex items-center justify-between space-x-2 text-xs text-[#b0b3b8] font-semibold">
                      <div class="flex items-center space-x-2">
                          <a href="/profile/user/${
          author._id
        }" class="flex-shrink-0">
                            <img
                              alt="Ảnh đại diện ${
          author.name
        }"
                              class="w-7 h-7 rounded-full object-cover"
                              height="28"
                              src="${
          author.avatar
        }"
                              width="28"/>
                          </a>
                          <div class="flex flex-col leading-tight">
                              <a href="/profile/user/${
          author._id
        }" class="text-[13px] text-white italic font-extrabold hover:underline">
                                ${
          author.name
        }
                              </a>
                              <div class="flex items-center space-x-1 text-[11px] font-normal">
                                  <span>${typeText}</span>
                                  <span>·</span>
                                  <time>${formattedDate}</time>
                                  ${typeIcon}
                              </div>
                          </div>
                      </div>
                      <div class="relative">
                          <button aria-label="Post options" class="options-button" onclick="toggleDropdown('${_id}')">
                              <i class="fas fa-ellipsis-h"></i>
                          </button>
                          <div id="dropdown-${_id}" class="dropdown-menu">
                              ${
          currentUserId === author._id
            ? `<div class="dropdown-item" onclick="openChangeStatusModal('${_id}', '${type}')">
                                          Đổi trạng thái hiển thị
                                      </div>
                                      <div class="dropdown-item" onclick="openDeleteModal('${_id}')">Xoá bài viết</div>`
            : `<div class="dropdown-item" onclick="openReportModal('${_id}')">Báo cáo bài viết</div>`
          }
                          </div>
                      </div>
                  </header>

                  <p class="text-[13px] text-white font-normal cursor-pointer w-full block break-words" onclick="goToPostDetail('${_id}')">${tagsHtml}</p>
                  ${mediaHtml}
                  <div class="post-actions">
                      <button type="button" id="like-button-${_id}" class="${likeButtonColor}" onclick="handleLike('${_id}', this)">
                          <i class="fas fa-heart"></i>
                          <span>${
          likes.length
        } Tim</span>
                      </button>
                      <button type="button" onclick="goToPostDetail('${_id}')">
                          <i class="far fa-comment"></i>
                          <span>${commentsCount} Comment</span>
                      </button>
                      <button type="button" onclick="copyLink('${_id}')">
                          <i class="fas fa-copy"></i>
                          <span>Copy link</span>
                      </button>
                  </div>
              </article>
          `;
      }
      // Handle like button click
      async function handleLike(postId, buttonElement) {
        try {
          const response = await fetch (`/posts/like/${postId}`, {
            method: 'PATCH',
            headers: {
              'Content-Type': 'application/json',
              // Add any necessary authentication headers here
            }
          });
          if (response.ok) { // Toggle the button color
            buttonElement.classList.toggle('text-blue-600');
            buttonElement.classList.toggle('text-gray-400');
            // Update like count
            const span = buttonElement.querySelector('span');
            const currentLikes = parseInt(span.textContent);
            const isNowLiked = buttonElement.classList.contains('text-blue-600');
            span.textContent = `${
              isNowLiked
                ? currentLikes + 1
                : currentLikes - 1
              } Tim`;
          } else {
            console.error('Failed to like/unlike post');
            // Optionally show error message to user
          }
        } catch (error) {
          console.error('Error liking/unliking post:', error);
          // Optionally show error message to user
        }
      }
      function goToPostDetail(postId) {
        window.location.href = `/posts/detail/${postId}`;
      }
      function toggleDropdown(postId) {
        const dropdown = document.getElementById (`dropdown-${postId}`);
        const isShown = dropdown.classList.contains('show');
        document.querySelectorAll('.dropdown-menu').forEach(menu => {
          menu.classList.remove('show');
        });
        if (! isShown) {
          dropdown.classList.add('show');
        }
      }
      document.addEventListener('click', (event) => {
        if (!event.target.closest('.dropdown-menu') && !event.target.closest('.options-button')) {
          document.querySelectorAll('.dropdown-menu').forEach(menu => {
            menu.classList.remove('show');
          });
        }
      });
      function copyLink(postId) {
        const baseUrl = window.location.origin;
        const link = `${baseUrl}/home?id=${postId}`;
        navigator
          .clipboard
          .writeText(link)
          .then(() => {
            showToast({message: "Sao chép liên kết thành công!", type: "success", delay: 3000});
          })
          .catch(err => {
            console.error('Lỗi sao chép:', err);
            showToast({message: "Không thể sao chép liên kết", type: "error", delay: 3000});
          });
      }
      let currentPage = 1;
      const limit = 15;
      let isLoading = false;
      let hasMorePosts = true;
      const urlParams = new URLSearchParams(window.location.search);
      const postId = urlParams.get('id');
      let seenPostIds = [];
      async function fetchAndRenderPosts(page = 1, limit = 15) {
        if (isLoading || ! hasMorePosts) {
          currentPage = page - 1;
          return;
        }
        isLoading = true;
        const spinner = document.getElementById('loading-posts-spinner');
        spinner.classList.remove('hidden');
        try {
          const url = `/posts?page=${page}&limit=${limit}&seenPostIds=${
            encodeURIComponent(JSON.stringify(seenPostIds))
          }&author={{ target._id }}`;
          const json = await fetch(url).then(res => res.json());
          if (json.success && json.status === 200) {
            const posts = json.data.returnPosts;
            const postsList = document.getElementById('posts-list');
            if (json.data.message) {
              showToast({message: json.data.message, type: "error", delay: 5000});
            }
            const container = document.getElementById('posts-container');
            if (posts.length > 0) {
              posts.forEach(post => {
                const div = document.createElement('div');
                div.innerHTML = renderPost(post); // giả sử renderPost(post) trả về HTML string
                postsList.appendChild(div.firstElementChild);
              });
            } else if (page === 1) {
              container.innerHTML = `
                          <div class="text-center text-white py-10 italic text-sm text-gray-400">
                              Không có bài đăng nào.
                          </div>
                      `;
            }
            if (posts.length<limit) {
                      hasMorePosts = false;
                  }
              } else {
                  console.error('Lỗi lấy bài viết:', json);
              }
          } catch (error) {
              console.error('Lỗi khi fetch bài viết:', error);
          } finally {
              isLoading = false;
              spinner.classList.add('hidden');
          }
      }

      function handleScroll() {
          const scrollTop = scrollableElement.scrollTop;
          const scrollHeight = scrollableElement.scrollHeight;
          const clientHeight = scrollableElement.clientHeight;

          if (scrollTop + clientHeight>= scrollHeight -
            100) {
              currentPage++;
              fetchAndRenderPosts(currentPage, limit);
            }
          }
          let scrollableElement;
          document.addEventListener('DOMContentLoaded', () => {
            scrollableElement = document.querySelector('.scrollable-content');
            if (! scrollableElement) {
              console.error('Không tìm thấy phần tử scrollable-content');
              return;
            }
            fetchAndRenderPosts(currentPage, limit);
            scrollableElement.addEventListener('scroll', handleScroll);
          });
          </script>
          <div
            id="changeStatusModal"
            class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden"
            role="dialog"
            aria-modal="true">
            <div class="bg-[#242526] rounded-xl max-w-sm w-full shadow-lg">
              <header class="flex justify-between items-center border-b border-[#3a3b3c] py-3 px-4">
                <h2 class="text-[#e4e6eb] font-semibold text-lg">Đổi trạng thái hiển thị</h2>
                <button onclick="closeChangeStatusModal()" class="text-[#b0b3b8] hover:bg-[#3a3b3c] rounded-full p-1">✕</button>
              </header>
              <section class="p-4 space-y-4">
                <div class="space-y-2">
                  <button
                    onclick="setPrivacyAndSubmit('PUBLIC')"
                    class="w-full bg-[#3a3b3c] text-left text-[#e4e6eb] rounded-md px-4 py-2 hover:bg-[#4e4f50]">
                    <i class="fas fa-globe-americas mr-2 text-sm"></i>Mọi người
                  </button>
                  <button
                    onclick="setPrivacyAndSubmit('FOLLOWERS')"
                    class="w-full bg-[#3a3b3c] text-left text-[#e4e6eb] rounded-md px-4 py-2 hover:bg-[#4e4f50]">
                    <i class="fas fa-user-friends mr-2 text-sm"></i>Người theo dõi
                  </button>
                  <button
                    onclick="setPrivacyAndSubmit('PRIVATE')"
                    class="w-full bg-[#3a3b3c] text-left text-[#e4e6eb] rounded-md px-4 py-2 hover:bg-[#4e4f50]">
                    <i class="fas fa-lock mr-2 text-sm"></i>Chỉ mình tôi
                  </button>
                </div>
              </section>
            </div>
          </div>
          <div
            id="reportModal"
            class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden"
            role="dialog"
            aria-modal="true">
            <div class="bg-[#242526] rounded-xl max-w-sm w-full shadow-lg">
              <header class="flex justify-between items-center border-b border-[#3a3b3c] py-3 px-4">
                <h2 id="report-title" class="text-[#e4e6eb] font-semibold text-lg">Báo cáo bài viết</h2>
                <button onclick="closeReportModal()" class="text-[#b0b3b8] hover:bg-[#3a3b3c] rounded-full p-1">✕</button>
              </header>
              <section class="p-4 space-y-4">
                <textarea
                  id="reportReason"
                  rows="4"
                  placeholder="Nhập lý do báo cáo..."
                  class="w-full bg-[#3a3b3c] text-[#e4e6eb] border-none p-2 rounded resize-none focus:outline-none"></textarea>
                <input type="hidden" id="reportPostId" name="target" value="">
                  <input type="hidden" id="type" name="type" value="POST">
                    <div id="blockUserWrapper" class="hidden flex items-center justify-between text-sm text-[#e4e6eb]">
                      <label for="blockUserToggle" class="mr-2">Chặn người dùng này</label>
                      <label class="relative inline-flex items-center cursor-pointer">
                        <input type="checkbox" id="blockUserToggle" class="sr-only peer">
                          <div class="w-11 h-6 bg-gray-600 peer-focus:outline-none peer-focus:ring-2 peer-focus:ring-red-400 rounded-full peer
                            peer-checked:bg-red-600 transition-colors"></div>
                          <div class="absolute left-1 top-1 bg-white w-4 h-4 rounded-full transition-transform peer-checked:translate-x-5"></div>
                        </label>
                      </div>
                      <div class="flex justify-end gap-2">
                        <button onclick="closeReportModal()" class="bg-[#3a3b3c] text-[#b0b3b8] rounded px-4 py-1 hover:bg-[#4e4f50]">
                          Huỷ
                        </button>
                        <button onclick="submitReport()" class="bg-red-600 text-white rounded px-4 py-1 hover:bg-red-700">
                          Gửi
                        </button>
                      </div>
                    </section>
                  </div>
                </div>
                <div
                  id="deleteModal"
                  class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden"
                  role="dialog"
                  aria-modal="true">
                  <div class="bg-[#242526] rounded-xl max-w-sm w-full shadow-lg">
                    <header class="flex justify-between items-center border-b border-[#3a3b3c] py-3 px-4">
                      <h2 class="text-[#e4e6eb] font-semibold text-lg">Xoá bài viết</h2>
                      <button onclick="closeDeleteModal()" class="text-[#b0b3b8] hover:bg-[#3a3b3c] rounded-full p-1">✕</button>
                    </header>
                    <section class="p-4 space-y-4">
                      <p class="text-[#e4e6eb] text-sm">
                        Bạn có chắc chắn muốn xóa bài đăng này? <br/>
                        <span class="text-red-500 font-medium">Hành động này sẽ không thể hoàn tác.</span>
                      </p>
                      <div class="flex justify-end gap-2">
                        <button onclick="closeDeleteModal()" class="bg-[#3a3b3c] text-[#b0b3b8] rounded px-4 py-1 hover:bg-[#4e4f50]">
                          Huỷ
                        </button>
                        <button onclick="confirmDeletePost()" class="bg-red-600 text-white rounded px-4 py-1 hover:bg-red-700">
                          Đồng ý
                        </button>
                      </div>
                    </section>
                  </div>
                </div>
                <div
                  id="editInfoModal"
                  class="fixed inset-0 bg-black bg-opacity-50 z-50 flex items-center justify-center hidden"
                  role="dialog"
                  aria-modal="true">
                  <div class="bg-[#242526] rounded-xl w-full max-w-md shadow-lg">
                    <header class="flex justify-between items-center border-b border-[#3a3b3c] py-3 px-4">
                      <h2 class="text-[#e4e6eb] font-semibold text-lg">Chỉnh sửa thông tin</h2>
                      <button onclick="closeEditInfoModal()" class="text-[#b0b3b8] hover:bg-[#3a3b3c] rounded-full p-1">✕</button>
                    </header>
                    <form onsubmit="submitEditInfo(event)">
                      <section class="p-4 space-y-4">
                        <div>
                          <label class="block text-[#e4e6eb] text-sm mb-1">Tiểu sử</label>
                          <textarea
                            name="bio"
                            id="bioInput"
                            rows="4"
                            placeholder="Nhập tiểu sử (tối đa 300 ký tự)..."
                            maxlength="300"
                            class="w-full bg-[#3a3b3c] text-[#e4e6eb] border-none p-2 rounded resize-none focus:outline-none custom-scrollbar"
                            oninput="checkBioCharLimit(this)">{{ target.bio }}</textarea>
                          <style>
                            /* Custom Scrollbar for WebKit (Chrome, Edge, Safari) */
                            .custom-scrollbar::-webkit-scrollbar {
                              width: 6px;
                            }
                            .custom-scrollbar::-webkit-scrollbar-track {
                              background: #2a2b2c;
                              border-radius: 4px;
                            }
                            .custom-scrollbar::-webkit-scrollbar-thumb {
                              background: #555;
                              border-radius: 4px;
                            }
                            .custom-scrollbar::-webkit-scrollbar-thumb:hover {
                              background: #777;
                            }
                            /* Firefox support */
                            .custom-scrollbar {
                              scrollbar-width: thin;
                              scrollbar-color: #555 #2a2b2c;
                            }
                          </style>
                          <p id="bioCharCount" class="text-right text-xs text-[#b0b3b8] mt-1">0 / 300 ký tự</p>
                          <script>
                            function checkBioCharLimit(el) {
                              const charCount = el.value.length;
                              const maxChars = 300;
                              const charCountEl = document.getElementById('bioCharCount');
                              const saveBtn = document.getElementById('saveBtn');
                              charCountEl.innerText = `${charCount} / ${} / ${maxChars} ký tự`;
                              if (charCount > maxChars) {
                                charCountEl.classList.add('text-red-500');
                                saveBtn.disabled = true;
                                saveBtn.classList.add('opacity-50', 'cursor-not-allowed');
                              } else {
                                charCountEl.classList.remove('text-red-500');
                                saveBtn.disabled = false;
                                saveBtn.classList.remove('opacity-50', 'cursor-not-allowed');
                              }
                            }
                            </script>
                          </div>
                          <div>
                            <label class="block text-[#e4e6eb] text-sm mb-1">Giới tính</label>
                            <select name="gender" class="w-full bg-[#3a3b3c] text-[#e4e6eb] p-2 rounded focus:outline-none">
                              <option value="OTHER">Không tiết lộ</option>
                              <option value="MALE" {% if target.gender == 'MALE' %} selected {% endif %}>Nam</option>
                              <option value="FEMALE" {% if target.gender == 'FEMALE' %} selected {% endif %}>Nữ</option>
                            </select>
                          </div>
                          <div>
                            <label class="block text-[#e4e6eb] text-sm mb-1">Ngày sinh</label>
                            <input type="date" name="birthday" value="{{ target.birthday }}" class="w-full bg-[#3a3b3c] text-[#e4e6eb] p-2 rounded focus:outline-none"/>
                          </div>
                          <div>
                            <label class="block text-[#e4e6eb] text-sm mb-1">Số điện thoại</label>
                            <input type="text" name="phone" value="{{ target.phone }}" class="w-full bg-[#3a3b3c] text-[#e4e6eb] p-2 rounded focus:outline-none"/>
                          </div>
                          <div class="flex justify-end gap-2 pt-2">
                            <button
                              type="button"
                              onclick="closeEditInfoModal()"
                              class="bg-[#3a3b3c] text-[#b0b3b8] rounded px-4 py-1 hover:bg-[#4e4f50]">
                              Huỷ
                            </button>
                            <button id="saveBtn" type="submit" class="bg-blue-600 text-white rounded px-4 py-1 hover:bg-blue-700">
                              Lưu
                            </button>
                          </div>
                        </section>
                      </form>
                    </div>
                  </div>
<script>
  function openEditInfoModal() {
    document.getElementById("editInfoModal").classList.remove("hidden");
  }

  function closeEditInfoModal() {
    document.getElementById("editInfoModal").classList.add("hidden");
  }

  async function submitEditInfo(event) {
    event.preventDefault();
    const formData = new FormData(event.target);
    const data = Object.fromEntries(
      [...formData.entries()].filter(([_, value]) => Boolean(value))
    );

    try {
      const response = await fetch('/profile/update', {
        method: 'PATCH',
        headers: {
          'Content-Type': 'application/json'
        },
        body: JSON.stringify(data)
      });

      const result = await response.json();

      if (!response.ok) {
        throw new Error(result.message || 'Lỗi khi cập nhật thông tin');
      }

      showToast({ message: 'Cập nhật thông tin thành công', type: 'success', delay: 5000 });

      setTimeout(() => {
        location.reload();
      }, 2000);
    } catch (error) {
      showToast({
        message: `Lỗi: ${error.message}`,
        type: 'error',
        delay: 5000
      });
    }

    closeEditInfoModal();
  }

  async function toggleFollow(targetId) {
    try {
      const response = await fetch(`/follow/send/${targetId}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      if (!response.ok) {
        throw new Error('Không thể thực hiện thao tác theo dõi');
      }

      const { data } = await response.json();

      showToast({ message: data.message, type: "success", delay: 5000 });

      setTimeout(() => {
        location.reload();
      }, 2000);
    } catch (error) {
      showToast({
        message: `Lỗi: ${error.message}`,
        type: "error",
        delay: 5000
      });
    }
  }

  async function toggleFollowAccept(targetId) {
    try {
      const response = await fetch(`/follow/acp/${targetId}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      if (!response.ok) {
        throw new Error('Không thể thực hiện thao tác theo dõi');
      }

      const { data } = await response.json();

      showToast({ message: data.message, type: "success", delay: 5000 });

      setTimeout(() => {
        location.reload();
      }, 2000);
    } catch (error) {
      showToast({
        message: `Lỗi: ${error.message}`,
        type: "error",
        delay: 5000
      });
    }
  }

  async function toggleFollowReject(targetId) {
    try {
      const response = await fetch(`/follow/cancel/${targetId}`, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json'
        }
      });

      if (!response.ok) {
        throw new Error('Không thể thực hiện thao tác theo dõi');
      }

      const { data } = await response.json();

      showToast({ message: data.message, type: "success", delay: 5000 });

      setTimeout(() => {
        location.reload();
      }, 2000);
    } catch (error) {
      showToast({
        message: `Lỗi: ${error.message}`,
        type: "error",
        delay: 5000
      });
    }
  }
</script>
{% endblock %}