<html lang="en">
    <head>
        <meta charset="utf-8"/>
        <meta content="width=device-width, initial-scale=1" name="viewport"/>
        <title>Facebook Post Detail with Modal and Replies</title>
        <script src="https://cdn.tailwindcss.com"></script>
        <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.3/css/all.min.css" rel="stylesheet"/>
        <style>
            /* Custom scrollbar for comments scroll container */
            #commentsScrollContainer {
                height: 100%;
                min-height: 0;
                scrollbar-width: thin;
                scrollbar-color: #555 #18191A;
            }
            #commentsScrollContainer::-webkit-scrollbar {
                width: 8px;
            }
            #commentsScrollContainer::-webkit-scrollbar-track {
                background: #18191A;
                border-radius: 4px;
            }
            #commentsScrollContainer::-webkit-scrollbar-thumb {
                background-color: #555;
                border-radius: 4px;
                border: 2px solid #18191A;
            }
            #commentsScrollContainer::-webkit-scrollbar-thumb:hover {
                background-color: #888;
            }
            @keyframes slideInRight {
                from {
                    opacity: 0;
                    transform: translateX(100%) scale(0.95);
                }
                to {
                    opacity: 1;
                    transform: translateX(0) scale(1);
                }
            }
            @keyframes fadeOutRight {
                from {
                    opacity: 1;
                    transform: translateX(0) scale(1);
                }
                to {
                    opacity: 0;
                    transform: translateX(100%) scale(0.95);
                }
            }
            @keyframes iconPulse {
                0% {
                    transform: scale(1);
                }
                50% {
                    transform: scale(1.1);
                }
                100% {
                    transform: scale(1);
                }
            }
            @keyframes progressBar {
                from {
                    width: 100%;
                }
                to {
                    width: 0;
                }
            }
            .toast {
                display: flex;
                align-items: flex-start;
                background: linear-gradient(145deg, #ffffff 0%, #f8f9fa 100%);
                color: #2c3e50;
                border-radius: 12px;
                padding: 18px 20px;
                min-width: 350px;
                max-width: 420px;
                font-size: 14px;
                font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
                box-shadow: 0 8px 32px rgba(0, 0, 0, 0.1), 0 2px 8px rgba(0, 0, 0, 0.08);
                border: 1px solid rgba(255, 255, 255, 0.8);
                animation: slideInRight 0.4s cubic-bezier(0.25, 0.46, 0.45, 0.94) forwards;
                position: relative;
                opacity: 1;
                transition: all 0.3s ease;
                margin-bottom: 12px;
                backdrop-filter: blur(10px);
                overflow: hidden;
            }
            .toast::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                right: 0;
                height: 3px;
                background: linear-gradient(90deg, transparent, rgba(255,255,255,0.5), transparent);
                animation: progressBar var(--toast-delay, 4000ms) linear forwards;
            }
            .toast.success {
                border-left: 4px solid #27ae60;
                background: linear-gradient(145deg, #f8fff9 0%, #e8f5e8 100%);
            }
            .toast.success::before {
                background: linear-gradient(90deg, #27ae60, #2ecc71, #27ae60);
            }
            .toast.error {
                border-left: 4px solid #e74c3c;
                background: linear-gradient(145deg, #fff8f8 0%, #fdf2f2 100%);
            }
            .toast.error::before {
                background: linear-gradient(90deg, #e74c3c, #c0392b, #e74c3c);
            }
            .toast.warning {
                border-left: 4px solid #f39c12;
                background: linear-gradient(145deg, #fffbf0 0%, #fef7e6 100%);
            }
            .toast.warning::before {
                background: linear-gradient(90deg, #f39c12, #e67e22, #f39c12);
            }
            .toast.info {
                border-left: 4px solid #3498db;
                background: linear-gradient(145deg, #f0f9ff 0%, #e6f3ff 100%);
            }
            .toast.info::before {
                background: linear-gradient(90deg, #3498db, #2980b9, #3498db);
            }
            .toast-icon {
                width: 24px;
                height: 24px;
                margin-right: 16px;
                margin-top: 1px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                flex-shrink: 0;
                animation: iconPulse 0.6s ease-in-out;
                position: relative;
            }
            .toast-icon::after {
                content: '';
                position: absolute;
                width: 100%;
                height: 100%;
                border-radius: 50%;
                background: inherit;
                opacity: 0.2;
                transform: scale(1.5);
                z-index: -1;
            }
            .toast.success .toast-icon {
                background: linear-gradient(135deg, #27ae60, #2ecc71);
                color: white;
                box-shadow: 0 2px 8px rgba(39, 174, 96, 0.3);
            }
            .toast.error .toast-icon {
                background: linear-gradient(135deg, #e74c3c, #c0392b);
                color: white;
                box-shadow: 0 2px 8px rgba(231, 76, 60, 0.3);
            }
            .toast.warning .toast-icon {
                background: linear-gradient(135deg, #f39c12, #e67e22);
                color: white;
                box-shadow: 0 2px 8px rgba(243, 156, 18, 0.3);
            }
            .toast.info .toast-icon {
                background: linear-gradient(135deg, #3498db, #2980b9);
                color: white;
                box-shadow: 0 2px 8px rgba(52, 152, 219, 0.3);
            }
            .toast-content {
                flex-grow: 1;
                line-height: 1.5;
            }
            .toast .message {
                color: #2c3e50;
                margin: 0;
                font-weight: 500;
                font-size: 14px;
                letter-spacing: 0.01em;
            }
            .toast .close-btn {
                background: rgba(0, 0, 0, 0.05);
                border: none;
                color: #7f8c8d;
                font-size: 16px;
                margin-left: 16px;
                cursor: pointer;
                padding: 0;
                width: 24px;
                height: 24px;
                display: flex;
                align-items: center;
                justify-content: center;
                border-radius: 50%;
                transition: all 0.2s ease;
                flex-shrink: 0;
            }
            .toast .close-btn:hover {
                background: rgba(0, 0, 0, 0.1);
                color: #2c3e50;
                transform: scale(1.1);
            }
            .toast.closing {
                animation: fadeOutRight 0.4s cubic-bezier(0.55, 0.085, 0.68, 0.53) forwards;
            }
            .toast:hover {
                transform: translateY(-2px);
                box-shadow: 0 12px 40px rgba(0, 0, 0, 0.15), 0 4px 16px rgba(0, 0, 0, 0.1);
            }
            @media(max-width: 480px) {
                .toast {
                    min-width: 280px;
                    max-width: 320px;
                    margin: 0 8px 12px;
                }
            }
        </style>
        <style>
            .notification-item:hover {
                background-color: #3a3b3c;
            }
            .notification-item.unread {
                background-color: #2d3748;
            }
            .notification-badge {
                animation: pulse 2s infinite;
            }
            @keyframes pulse {
                0,
                100% {
                    opacity: 1;
                }
                50% {
                    opacity: 0.7;
                }
            }
            /* Tab styling */
            .tab-btn {
                transition: all 0.2s ease;
            }
            .tab-btn:hover {
                color: white;
            }
            /* Responsive dropdown positioning */
            @media(max-width: 640px) {
                .dropdown-container {
                    position: fixed !important;
                    right: 8px !important;
                    left: 8px !important;
                    top: 60px !important;
                    width: auto !important;
                }
            }
            /* Text overflow handling */
            .text-clamp-2 {
                display: -webkit-box;
                -webkit-line-clamp: 2;
                -webkit-box-orient: vertical;
                overflow: hidden;
                word-wrap: break-word;
                word-break: break-word;
            }
            .custom-scrollbar::-webkit-scrollbar {
                width: 6px;
            }
            .custom-scrollbar::-webkit-scrollbar-thumb {
                background-color: #4B5563; /* gray-600 */
                border-radius: 4px;
            }
            .custom-scrollbar::-webkit-scrollbar-track {
                background: #1F2937; /* gray-800 */
            }
        </style>
    </head>
    <body class="bg-[#18191A] text-white font-sans min-h-screen flex justify-center">
        <div id="toast-container" class="fixed z-50 space-y-3 p-6 top-6 right-6 max-w-full w-auto"></div>
        <div
            class="flex w-full w-full h-screen">
            <!-- Left: Image/Video viewer -->
            <div class="flex-1 flex flex-col bg-black relative">
                <div class="flex-1 flex items-center justify-center relative">
                    {% if mediaUrls.length > 1 %}
                        <button
                            aria-label="Previous"
                            id="prevBtn"
                            class="absolute left-4 top-1/2 transform -translate-y-1/2 bg-black bg-opacity-50 rounded-full p-3 hover:bg-opacity-80
                                z-10">
                            <i class="fas fa-chevron-left text-white text-xl"></i>
                        </button>
                    {% endif %}
                    <div
                        id="mediaContainer" class="max-h-[90vh] max-w-full flex items-center justify-center cursor-pointer"><!-- Image or video will be injected here -->
                    </div>
                    {% if mediaUrls.length > 1 %}
                        <button
                            aria-label="Next"
                            id="nextBtn"
                            class="absolute right-4 top-1/2 transform -translate-y-1/2 bg-black bg-opacity-50 rounded-full p-3 hover:bg-opacity-80
                                z-10">
                            <i class="fas fa-chevron-right text-white text-xl"></i>
                        </button>
                    {% endif %}
                </div>
            </div>
            <!-- Right: Post details -->
            <div
                class="w-[400px] bg-[#242526] flex flex-col">
                <!-- Top bar -->
                <div
                    class="flex items-center justify-between p-4 border-b border-[#3a3b3c]">
                    <!-- Logo ở bên trái -->
                    <div class="flex items-center" onclick="window.location.href='{{ baseUrl }}'">
                        <img alt="Logo" class="w-10 h-10 object-contain" src="{{ baseUrl }}/images/favicon.png" width="40" height="40"/>
                    </div>
                    <!-- Các nút và avatar ở bên phải -->
                    <div class="flex items-center space-x-2">
                        <button class="w-10 h-10 rounded-full bg-[#3a3b3c] flex items-center justify-center text-[#B0B3B8] hover:text-white
                                hover:bg-[#4a4b4c]" onclick="window.location.href='{{ baseUrl }}/chat'">
                            <i class="fab fa-facebook-messenger text-white"></i>
                        </button>
                        <div
                            class="relative inline-block text-left">
                            <!-- Notification Button -->
                            <button
                                id="notificationBtn"
                                class="w-10 h-10 rounded-full bg-[#3a3b3c] flex items-center justify-center text-[#B0B3B8] hover:text-white
                                    hover:bg-[#4a4b4c]">
                                <i class="fas fa-bell text-white"></i>
                                <span
                                    id="notificationBadge"
                                    class="absolute -top-1 -right-1 bg-red-600 text-[10px] font-semibold rounded-full w-4 h-4 flex items-center
                                        justify-center leading-none">
                                    0
                                </span>
                            </button>
                            <!-- Dropdown -->
                            <div
                                id="notificationDropdown"
                                class="hidden origin-top-right absolute right-0 mt-2 w-80 sm:w-96 max-w-[90vw] rounded-md shadow-lg bg-[#242526] ring-1
                                    ring-black ring-opacity-5 z-50 overflow-y-auto custom-scrollbar">
                                <div
                                    class="py-2 max-h-[80vh]">
                                    <!-- Header -->
                                    <div class="flex justify-between items-center px-4 py-2 border-b border-gray-600">
                                        <div class="text-lg font-bold text-white">Thông báo</div>
                                        <button id="markAllRead" class="text-sm text-blue-400 hover:underline focus:outline-none">
                                            Đánh dấu tất cả đã đọc
                                        </button>
                                    </div>
                                    <!-- Tabs -->
                                    <div class="flex border-b border-gray-600 px-4 mb-2">
                                        <button
                                            class="tab-btn px-3 py-2 text-sm font-semibold text-white border-b-2 border-blue-500 focus:outline-none"
                                            data-tab="all">
                                            Tất cả (<span id="allCount">0</span>)
                                        </button>
                                        <button
                                            class="tab-btn px-3 py-2 text-sm text-gray-400 hover:text-white border-b-2 border-transparent focus:outline-none"
                                            data-tab="unread">
                                            Chưa đọc (<span id="unreadCount">0</span>)
                                        </button>
                                    </div>
                                    <!-- Loading State -->
                                    <div id="loadingState" class="px-4 py-8 text-center text-gray-400">
                                        <i class="fas fa-spinner fa-spin text-2xl mb-2"></i>
                                        <p>Đang tải thông báo...</p>
                                    </div>
                                    <!-- Empty State -->
                                    <div id="emptyState" class="hidden px-4 py-8 text-center text-gray-400">
                                        <i class="fas fa-bell-slash text-3xl mb-2"></i>
                                        <p>Không có thông báo nào</p>
                                    </div>
                                    <!-- Notifications List -->
                                    <div id="notificationsList" class="px-2 pb-2 hidden"></div>
                                </div>
                            </div>
                        </div>
                        <div
                            class="relative" id="dropdownContainer">
                            <!-- Nút avatar người dùng -->
                            <button
                                id="userAvatar"
                                class="w-10 h-10 rounded-full border border-gray-600 hover:border-gray-500 transition-colors overflow-hidden
                                    focus:outline-none"
                                aria-label="User profile">
                                <img src="{{ user.avatar }}" alt="Avatar người dùng" class="w-full h-full object-cover"/>
                            </button>
                            <!-- Menu dropdown -->
                            <div
                                id="dropdownMenu"
                                class="absolute right-0 mt-2 w-80 bg-gray-900 text-white rounded-lg shadow-xl border border-gray-600 z-50 hidden"
                                style="background-color: #242526;">
                                <!-- Thông tin người dùng -->
                                <div class="p-4 border-b border-gray-600" style="border-color: #3a3b3c;">
                                    <div class="flex items-center space-x-3">
                                        <img src="{{ user.avatar }}" alt="Avatar" class="w-10 h-10 rounded-full"/>
                                        <div class="font-medium" style="color: #e4e6ea;">{{ user.name }}</div>
                                    </div>
                                </div>
                                <!-- Các mục menu -->
                                <div class="py-2">
                                    <button
                                        class="menu-item w-full flex items-center space-x-3 px-4 py-3 transition-colors text-left"
                                        style="color: #e4e6ea;"
                                        onclick="window.location.href='/profile/user/{{ user._id }}'"
                                        onmouseover="this.style.backgroundColor='#3a3b3c'"
                                        onmouseout="this.style.backgroundColor='transparent'">
                                        <i class="fas fa-user w-5" style="color: #b0b3b8;"></i>
                                        <span class="flex-1">Trang cá nhân</span>
                                    </button>
                                    <button
                                        class="menu-item w-full flex items-center justify-between px-4 py-3 transition-colors group text-left"
                                        style="color: #e4e6ea;"
                                        onclick="window.location.href='/profile/settings'"
                                        onmouseover="this.style.backgroundColor='#3a3b3c'"
                                        onmouseout="this.style.backgroundColor='transparent'">
                                        <div class="flex items-center space-x-3">
                                            <i class="fas fa-cog w-5" style="color: #b0b3b8;"></i>
                                            <span>Cài đặt và quyền riêng tư</span>
                                        </div>
                                    </button>
                                    <button
                                        class="menu-item w-full flex items-center space-x-3 px-4 py-3 transition-colors text-left"
                                        style="color: #e4e6ea;"
                                        onclick="window.location.href='/auth/logout'"
                                        onmouseover="this.style.backgroundColor='#3a3b3c'"
                                        onmouseout="this.style.backgroundColor='transparent'">
                                        <i class="fas fa-sign-out-alt w-5" style="color: #b0b3b8;"></i>
                                        <span class="flex-1">Đăng xuất</span>
                                    </button>
                                </div>
                                <!-- Footer -->
                                <div class="px-4 py-3 border-t" style="border-color: #3a3b3c;">
                                    <div class="text-xs leading-4" style="color: #b0b3b8;">
                                        <span class="hover:underline cursor-pointer">Quyền riêng tư</span>
                                        <span class="mx-1">•</span>
                                        <span class="hover:underline cursor-pointer">Điều khoản</span>
                                        <span class="mx-1">•</span>
                                        <span class="hover:underline cursor-pointer">Quảng cáo</span>
                                        <span class="mx-1">•</span>
                                        <span class="hover:underline cursor-pointer">Lựa chọn quảng cáo</span>
                                        <span class="mx-1">•</span>
                                        <span class="hover:underline cursor-pointer">Cookie</span>
                                        <span class="mx-1">•</span>
                                        <span class="hover:underline cursor-pointer">Xem thêm</span>
                                        <span class="mx-1">•</span>
                                        <span>KAIRO © 2025</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                        <script>
                            // Lấy các phần tử DOM
                            const userAvatar = document.getElementById('userAvatar');
                            const dropdownMenu = document.getElementById('dropdownMenu');
                            const menuItems = document.querySelectorAll('.menu-item');
                            const dropdownContainer = document.getElementById('dropdownContainer');
                            // Xử lý sự kiện click vào avatar
                            userAvatar.addEventListener('click', function (e) {
                                e.stopPropagation();
                                toggleDropdown1();
                            });
                            // Hàm bật/tắt dropdown
                            function toggleDropdown1() {
                                dropdownMenu.classList.toggle('hidden');
                            }
                            // Đóng dropdown khi click bên ngoài
                            document.addEventListener('click', function (e) {
                                if (! dropdownContainer.contains(e.target)) {
                                    dropdownMenu.classList.add('hidden');
                                }
                            });
                            // Ngăn dropdown đóng khi click bên trong menu (trừ menu items)
                            dropdownMenu.addEventListener('click', function (e) {
                                if (! e.target.closest('.menu-item')) {
                                    e.stopPropagation();
                                }
                            });
                            // Đóng dropdown khi nhấn ESC
                            document.addEventListener('keydown', function (e) {
                                if (e.key === 'Escape') {
                                    dropdownMenu.classList.add('hidden');
                                }
                            });
                        </script>
                    </div>
                </div>
                <!-- Existing post header -->
                <div class="flex items-center justify-between p-4 border-b border-[#3a3b3c]">
                    <div class="flex items-center space-x-3">
                        <div class="w-10 h-10 rounded-full bg-[#1877F2] flex items-center justify-center overflow-hidden">
                            <img alt="User avatar" class="w-full h-full object-cover" src="{{ author.avatar }}" width="40" height="40"/>
                        </div>
                        <div>
                            <p class="text-white font-semibold text-sm">{{ author.name }}</p>
                            <p class="text-[#B0B3B8] text-xs mt-0.5 flex items-center space-x-1">
                                <span>{{ createdAt }}</span>
                                <i class="fas fa-globe-americas text-[10px]"></i>
                            </p>
                        </div>
                    </div>
                    <button class="text-white text-xl hover:bg-[#3a3b3c] p-1 rounded-full">
                        <i class="fas fa-ellipsis-h"></i>
                    </button>
                </div>
                <!-- Post content area -->
                <div class="p-4 border-b border-[#3a3b3c] text-sm text-white leading-relaxed">
                    {{ content | safe }}
                </div>
                <div class="flex justify-around border-b border-[#3a3b3c] py-3 text-[#B0B3B8]">
                    <button id="likeButton" class="flex items-center space-x-1 hover:text-[#1877F2]" data-post-id="{{ _id }}">
                        <i class="fas fa-heart text-xl {% if(isLiked) == true %}liked{% endif %}" id="likeIcon"></i>
                        <span class="text-sm">{{ likes.length }}</span>
                    </button>
                    <button class="flex items-center space-x-1 hover:text-[#1877F2]">
                        <i class="far fa-comment text-xl"></i>
                        <span class="text-sm">{{ commentsCount }}</span>
                    </button>
                    <button class="flex items-center space-x-1 hover:text-[#1877F2]" id="shareButton" data-post-id="{{ _id }}">
                        <i class="fas fa-share text-xl"></i>
                        <span class="text-sm">{{ sharesCount }}</span>
                    </button>
                </div>
                <style>
                    .liked {
                        color: #1877F2 !important;
                    }
                    #sendCommentBtn:disabled {
                        opacity: 0.5;
                        cursor: not-allowed;
                    }
                </style>
                <script>
                    // Lấy phần tử nút Like và icon
                    const likeButton = document.getElementById('likeButton');
                    const likeIcon = document.getElementById('likeIcon');
                    const likeCount = likeButton.querySelector('span');
                    const shareButton = document.getElementById('shareButton');
                    const shareCount = shareButton.querySelector('span');
                    // Phần tử hiển thị số like Hàm xử lý sự kiện click nút Like
                    async function handleLike() {
                        const postId = likeButton.getAttribute('data-post-id'); // Lấy ID bài viết
                        const isLiked = likeIcon.classList.contains('liked'); // Kiểm tra trạng thái hiện tại
                        try { // Gửi yêu cầu PATCH đến /posts/like/:id
                            const response = await fetch(`/posts/like/${postId}`, {
                                method: 'PATCH',
                                headers: {
                                    'Content-Type': 'application/json',
                                    // Thêm header xác thực nếu cần, ví dụ: 'Authorization': `Bearer ${yourToken}`
                                }
                            });
                            if (! response.ok) {
                                throw new Error(`HTTP error! Status: ${
                                    response.status
                                }`);
                            }
                            // Lấy dữ liệu từ response
                            const data = await response.json();
                            // Cập nhật giao diện
                            if (isLiked) {
                                likeIcon.classList.remove('liked'); // Bỏ trạng thái liked
                                likeCount.textContent = parseInt(likeCount.textContent) - 1; // Giảm số like
                            } else {
                                likeIcon.classList.add('liked'); // Thêm trạng thái liked (màu xanh FB)
                                likeCount.textContent = parseInt(likeCount.textContent) + 1; // Tăng số like
                            }
                        } catch (error) {}
                    }
                    async function handleShare() {
                        const postId = shareButton.getAttribute('data-post-id'); // Lấy ID bài viết
                        try {
                            const response = await fetch(`/posts/share/${postId}`, {
                                method: 'PATCH',
                                headers: {
                                    'Content-Type': 'application/json',
                                    // Thêm header xác thực nếu cần, ví dụ: 'Authorization': `Bearer ${yourToken}`
                                }
                            });
                            if (! response.ok) {
                                throw new Error(`HTTP error! Status: ${
                                    response.status
                                }`);
                            }
                            // Lấy dữ liệu từ response
                            const data = await response.json();
                            // Cập nhật giao diện
                            shareCount.textContent = data ?. data ?. sharesCount || parseInt(shareCount.textContent) + 1; // Tăng số share
                            const postUrl = window.location.origin + `/posts/detail/${postId}`;
                            await navigator.clipboard.writeText(postUrl);
                            showToast({message: "Đã sao chép liên kết bài viết vào clipboard!", type: "success", delay: 3000});
                        } catch (error) {}
                    }
                    // Gắn sự kiện click cho nút Like
                    shareButton.addEventListener('click', handleShare);
                    likeButton.addEventListener('click', handleLike);
                </script>
                <div class="flex-1 flex flex-col border-t border-[#3a3b3c] min-h-0">
                    <div
                        id="commentsScrollContainer" class="overflow-y-auto p-4 space-y-3 flex-1 min-h-0">
                        <!-- Comments container with scroll -->
                        <div
                            class="flex flex-col space-y-3" id="commentsContainer"><!-- Comments will be appended here -->
                        </div>
                    </div>
                    <div class="flex items-center p-4 space-x-3 border-t border-[#3a3b3c]">
                        <img alt="User avatar" class="w-10 h-10 rounded-full object-cover" src="{{ user.avatar }}" width="40" height="40"/>
                        <textarea
                            id="commentInput"
                            class="flex-1 resize-none rounded-md bg-[#3a3b3c] text-white placeholder-[#B0B3B8] p-2 focus:outline-none"
                            placeholder="Bình luận dưới tên {{ user.name }}"
                            rows="2"></textarea>
                        <button aria-label="Send comment" id="sendCommentBtn" class="text-[#B0B3B8] hover:text-white p-2 rounded-md">
                            <i class="fas fa-paper-plane"></i>
                        </button>
                    </div>
                </div>
            </div>
        </div>
        <!-- Modal -->
        <div id="modal" class="fixed inset-0 bg-black bg-opacity-90 flex items-center justify-center z-50 hidden">
            <button
                id="modalClose"
                aria-label="Close modal"
                class="absolute top-6 right-6 text-white text-sm px-3 py-1 rounded-full bg-black bg-opacity-50 hover:bg-opacity-80 z-50">
                ✕
            </button>
            <img id="modalImage" alt="Enlarged image" class="max-h-[90vh] max-w-[90vw] object-contain" src=""/>
        </div>
        <script>
            function showToast({
                message = "Thông báo hệ thống.",
                delay = 4000,
                link = null,
                type = "info" // 'success', 'error', 'warning', 'info'
            } = {}) {
                const container = document.getElementById("toast-container");
                const toast = document.createElement("div");
                toast.className = `toast ${type}`;
                toast.style.setProperty('--toast-delay', delay + 'ms');
                // Icon container
                const iconEl = document.createElement("div");
                iconEl.className = "toast-icon";
                // Icon based on type
                let iconHTML = "";
                switch (type) {
                    case 'success': iconHTML = '<i class="fas fa-check" style="font-size: 13px;"></i>';
                        break;
                    case 'error': iconHTML = '<i class="fas fa-times" style="font-size: 13px;"></i>';
                        break;
                    case 'warning': iconHTML = '<i class="fas fa-exclamation" style="font-size: 13px;"></i>';
                        break;
                    case 'info':
                    default: iconHTML = '<i class="fas fa-info" style="font-size: 13px;"></i>';
                        break;
                }
                iconEl.innerHTML = iconHTML;
                // Content container
                const contentEl = document.createElement("div");
                contentEl.className = "toast-content";
                const messageEl = document.createElement(
                    link
                    ? 'a'
                    : 'div');
                messageEl.className = 'message';
                messageEl.textContent = message;
                if (link) {
                    messageEl.href = link;
                    messageEl.style.color = '#3498db';
                    messageEl.style.textDecoration = 'none';
                    messageEl.style.borderBottom = '1px solid transparent';
                    messageEl.style.transition = 'border-color 0.2s ease';
                    messageEl.onmouseover = () => messageEl.style.borderBottomColor = '#3498db';
                    messageEl.onmouseout = () => messageEl.style.borderBottomColor = 'transparent';
                }
                contentEl.appendChild(messageEl);
                const closeBtn = document.createElement("button");
                closeBtn.className = "close-btn";
                closeBtn.innerHTML = "×";
                closeBtn.onclick = (e) => {
                    e.stopPropagation();
                    toast.classList.add('closing');
                    setTimeout(() => {
                        if (toast.parentNode) {
                            toast.remove();
                        }
                    }, 400);
                };
                toast.appendChild(iconEl);
                toast.appendChild(contentEl);
                toast.appendChild(closeBtn);
                // Click vào message cũng đóng toast nếu có link
                if (link) {
                    toast.onclick = (e) => {
                        if (e.target !== closeBtn && ! closeBtn.contains(e.target)) {
                            window.location.href = link;
                        }
                    };
                    toast.style.cursor = 'pointer';
                }
                container.appendChild(toast);
                // Auto remove với hiệu ứng mượt mà hơn
                const autoRemoveTimer = setTimeout(() => {
                    if (toast.parentNode) {
                        toast.classList.add('closing');
                        setTimeout(() => {
                            if (toast.parentNode) {
                                toast.remove();
                            }
                        }, 400);
                    }
                }, delay);
                // Pause auto-remove khi hover
                toast.onmouseenter = () => {
                    clearTimeout(autoRemoveTimer);
                    toast.style.setProperty('--toast-delay', 'paused');
                };
                // Resume auto-remove khi không hover
                toast.onmouseleave = () => {
                    const remainingTime = delay * 0.3; // Còn lại 30% thời gian
                    setTimeout(() => {
                        if (toast.parentNode && ! toast.classList.contains('closing')) {
                            toast.classList.add('closing');
                            setTimeout(() => {
                                if (toast.parentNode) {
                                    toast.remove();
                                }
                            }, 400);
                        }
                    }, remainingTime);
                };
            }(() => { // Hàm định dạng thời gian từ ISO string sang DD/MM/YYYY HH:mm
                function formatTimestamp(isoString) {
                    try {
                        const date = new Date(isoString);
                        if (isNaN(date.getTime())) {
                            return "Thời gian không xác định";
                        }
                        const day = String(date.getDate()).padStart(2, '0');
                        const month = String(date.getMonth() + 1).padStart(2, '0');
                        const year = date.getFullYear();
                        const hours = String(date.getHours()).padStart(2, '0');
                        const minutes = String(date.getMinutes()).padStart(2, '0');
                        return `${day}/${month}/${year} ${hours}:${minutes}`;
                    } catch (error) {
                        console.error('Lỗi định dạng thời gian:', isoString);
                        return "Thời gian không xác định";
                    }
                }
                const mediaItems = {{ mediaUrls | dump | safe }}; // Dữ liệu media từ backend
                let currentIndex = 0;
                const mediaContainer = document.getElementById("mediaContainer");
                const prevBtn = document.getElementById("prevBtn");
                const nextBtn = document.getElementById("nextBtn");
                const modal = document.getElementById("modal");
                const modalImage = document.getElementById("modalImage");
                const modalClose = document.getElementById("modalClose");
                const sendCommentBtn = document.getElementById("sendCommentBtn");
                const commentInput = document.getElementById("commentInput");
                const commentsContainer = document.getElementById("commentsContainer");
                const commentsScrollContainer = document.getElementById("commentsScrollContainer");
                const commentSection = document.querySelector('[data-post-id]');
                const postId = commentSection
                    ? commentSection.getAttribute('data-post-id')
                    : null;
                let page = 1;
                const limit = 10;
                let isLoading = false;
                let hasMoreComments = true;
                function renderMedia() {
                    mediaContainer.innerHTML = "";
                    const item = mediaItems[currentIndex];
                    if (item ?. mimeType.includes("image")) {
                        const img = document.createElement("img");
                        img.src = item.url;
                        img.alt = item.alt;
                        img.className = "max-h-[90vh] max-w-full object-contain cursor-pointer";
                        img.id = "mainMedia";
                        mediaContainer.appendChild(img);
                        img.addEventListener("click", () => {
                            modalImage.src = item.url;
                            modalImage.alt = item.alt;
                            modal.classList.remove("hidden");
                        });
                    } else if (item ?. mimeType.includes("video")) {
                        const video = document.createElement("video");
                        video.src = item.url;
                        video.controls = true;
                        video.className = "max-h-[90vh] max-w-full object-contain cursor-default";
                        video.id = "mainMedia";
                        mediaContainer.appendChild(video);
                    }
                }
                {% if mediaUrls.length > 1 %}prevBtn.addEventListener("click", () => {
                        currentIndex = (currentIndex - 1 + mediaItems.length) % mediaItems.length;
                        renderMedia();
                    });
                    nextBtn.addEventListener("click", () => {
                        currentIndex = (currentIndex + 1) % mediaItems.length;
                        renderMedia();
                    });{% endif %}modalClose.addEventListener("click", () => {
                    modal.classList.add("hidden");
                    modalImage.src = "";
                    modalImage.alt = "";
                });
                modal.addEventListener("click", (e) => {
                    if (e.target === modal) {
                        modal.classList.add("hidden");
                        modalImage.src = "";
                        modalImage.alt = "";
                    }
                });
                let activeReplyBox = null;
                function createReplyBox(parentDiv) {
                    if (activeReplyBox) {
                        activeReplyBox.remove();
                        activeReplyBox = null;
                    }
                    const box = document.createElement("div");
                    box.className = "mt-2 flex space-x-2";
                    const textarea = document.createElement("textarea");
                    textarea.rows = 2;
                    textarea.placeholder = "Viết trả lời...";
                    textarea.className = "flex-1 resize-none rounded-md bg-[#4a4b4c] text-white placeholder-[#B0B3B8] p-2 focus:outline-none";
                    const sendBtn = document.createElement("button");
                    sendBtn.className = "text-[#B0B3B8] hover:text-white px-3 py-1 rounded bg-[#3a3b3c]";
                    sendBtn.textContent = "Gửi";
                    const commentId = parentDiv.closest('[data-comment-id]') ?. getAttribute('data-comment-id');
                    const parentCommentDiv = parentDiv.closest('[data-comment-id]');
                    if (! commentId || ! parentCommentDiv) 
                        return;
                    
                    sendBtn.addEventListener("click", async () => {
                        const content = textarea.value.trim();
                        if (! content || ! postId || ! commentId) 
                            return;
                        
                        const scrollTopBefore = commentsScrollContainer.scrollTop;
                        try {
                            const response = await fetch(`/comment/create/${postId}`, {
                                method: 'POST',
                                headers: {
                                    'Content-Type': 'application/json'
                                },
                                body: JSON.stringify(
                                {content, parentComment: commentId})
                            });
                            if (! response.ok) {
                                throw new Error(`HTTP error! Status: ${
                                    response.status
                                }`);
                            }
                            const data = await response.json();
                            const comment = data.data;
                            const replyDiv = document.createElement("div");
                            replyDiv.className = "flex items-start space-x-3";
                            replyDiv.setAttribute('data-comment-id', comment._id);
                            const avatar = document.createElement("img");
                            avatar.alt = "User avatar";
                            avatar.src = '{{ user.avatar }}';
                            avatar.width = 32;
                            avatar.height = 32;
                            avatar.className = "w-8 h-8 rounded-full object-cover";
                            const contentDiv = document.createElement("div");
                            contentDiv.className = "bg-[#4a4b4c] rounded-lg p-2 text-sm flex-1";
                            const nameP = document.createElement("p");
                            nameP.className = "font-semibold text-white";
                            const parentName = parentDiv.querySelector('.font-semibold') ?. textContent.split(' > ')[0] || 'Unknown';
                            nameP.textContent = `{{user.name}} > ${parentName}`;
                            const textP = document.createElement("p");
                            textP.className = "text-[#B0B3B8]";
                            textP.textContent = comment.content;
                            const timeP = document.createElement("p");
                            timeP.className = "text-[#B0B3B8] text-xs mt-1";
                            timeP.textContent = formatTimestamp(comment.createdAt);
                            const replyBtn = document.createElement("button");
                            replyBtn.className = "text-[#B0B3B8] hover:text-white text-xs mt-1";
                            replyBtn.setAttribute("data-reply-btn", "");
                            replyBtn.innerHTML = '<i class="fas fa-reply mr-1"></i>Trả lời';
                            replyBtn.addEventListener("click", () => {
                                createReplyBox(contentDiv);
                            });
                            const toggleBtn = document.createElement("button");
                            toggleBtn.className = "text-[#B0B3B8] hover:text-white text-xs mt-1 ml-2";
                            toggleBtn.textContent = "Hiện trả lời";
                            toggleBtn.type = "button";
                            const repliesContainer = document.createElement("div");
                            repliesContainer.className = "ml-6 mt-3 space-y-3";
                            repliesContainer.setAttribute("data-replies", "");
                            repliesContainer.style.display = "none";
                            toggleBtn.addEventListener("click", () => {
                                if (repliesContainer.style.display === "none") {
                                    repliesContainer.style.display = "block";
                                    toggleBtn.textContent = "Ẩn/Hiện trả lời";
                                } else {
                                    repliesContainer.style.display = "none";
                                    toggleBtn.textContent = "Hiện trả lời";
                                }
                            });
                            contentDiv.appendChild(nameP);
                            contentDiv.appendChild(textP);
                            contentDiv.appendChild(timeP);
                            contentDiv.appendChild(replyBtn);
                            contentDiv.appendChild(toggleBtn);
                            replyDiv.appendChild(avatar);
                            replyDiv.appendChild(contentDiv);
                            let parentRepliesContainer;
                            const isReply = parentCommentDiv.closest('[data-replies]');
                            if (isReply) {
                                parentRepliesContainer = isReply;
                            } else {
                                parentRepliesContainer = parentCommentDiv.nextElementSibling;
                                if (! parentRepliesContainer || ! parentRepliesContainer.hasAttribute('data-replies')) {
                                    parentRepliesContainer = document.createElement("div");
                                    parentRepliesContainer.className = "ml-6 mt-3 space-y-3";
                                    parentRepliesContainer.setAttribute("data-replies", "");
                                    parentRepliesContainer.style.display = "none";
                                    parentCommentDiv.parentNode.insertBefore(parentRepliesContainer, parentCommentDiv.nextSibling);
                                }
                            }
                            if (isReply) {
                                const nextSibling = parentCommentDiv.nextElementSibling;
                                if (nextSibling && nextSibling !== parentRepliesContainer) {
                                    parentRepliesContainer.insertBefore(replyDiv, nextSibling);
                                } else {
                                    parentRepliesContainer.appendChild(replyDiv);
                                }
                            } else {
                                if (parentRepliesContainer.firstChild) {
                                    parentRepliesContainer.insertBefore(replyDiv, parentRepliesContainer.firstChild);
                                } else {
                                    parentRepliesContainer.appendChild(replyDiv);
                                }
                            } parentRepliesContainer.style.display = "block";
                            let parentToggleBtn = parentDiv.querySelector('button.text-xs.ml-2');
                            if (! parentToggleBtn) {
                                parentToggleBtn = document.createElement("button");
                                parentToggleBtn.className = "text-[#B0B3B8] hover:text-white text-xs mt-1 ml-2";
                                parentToggleBtn.textContent = "Ẩn/Hiện trả lời";
                                parentToggleBtn.type = "button";
                                parentToggleBtn.addEventListener("click", () => {
                                    if (parentRepliesContainer.style.display === "none") {
                                        parentRepliesContainer.style.display = "block";
                                        parentToggleBtn.textContent = "Ẩn/Hiện trả lời";
                                    } else {
                                        parentRepliesContainer.style.display = "none";
                                        parentToggleBtn.textContent = "Hiện trả lời";
                                    }
                                });
                                parentDiv.appendChild(parentToggleBtn);
                            } else {
                                parentToggleBtn.textContent = "Ẩn/Hiện trả lời";
                            } box.remove();
                            activeReplyBox = null;
                            commentsScrollContainer.scrollTop = scrollTopBefore;
                            replyDiv.scrollIntoView({behavior: 'smooth', block: 'nearest'});
                        } catch (error) {
                            console.error('Lỗi khi gửi trả lời:', error);
                            showToast({message: "Đã có lỗi xảy ra khi gửi trả lời. Vui lòng thử lại!", type: "error", delay: 5000});
                        }
                    });
                    box.appendChild(textarea);
                    box.appendChild(sendBtn);
                    parentDiv.appendChild(box);
                    textarea.focus();
                    activeReplyBox = box;
                }
                commentsScrollContainer.addEventListener("click", (e) => {
                    if (e.target.closest("[data-reply-btn]")) {
                        e.preventDefault();
                        const commentDiv = e.target.closest(".bg-[#3a3b3c], .bg-[#4a4b4c]");
                        if (commentDiv) {
                            createReplyBox(commentDiv);
                        }
                    }
                });
                function updateButtonState() {
                    sendCommentBtn.disabled = commentInput.value.trim() === '';
                }
                commentInput.addEventListener('input', updateButtonState);
                async function handleSendComment() {
                    const content = commentInput.value.trim();
                    if (! content || ! postId) 
                        return;
                    
                    try {
                        const response = await fetch(`/comment/create/${postId}`, {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json'
                            },
                            body: JSON.stringify(
                            {content, parentComment: null})
                        });
                        if (! response.ok) {
                            throw new Error(`HTTP error! Status: ${
                                response.status
                            }`);
                        }
                        const data = await response.json();
                        const comment = data.data;
                        const commentDiv = document.createElement("div");
                        commentDiv.className = "flex flex-col space-y-1";
                        commentDiv.setAttribute('data-comment-id', comment._id);
                        const mainComment = document.createElement("div");
                        mainComment.className = "flex items-start space-x-3";
                        const avatar = document.createElement("img");
                        avatar.alt = "User avatar";
                        avatar.src = '{{ user.avatar }}';
                        avatar.width = 40;
                        avatar.height = 40;
                        avatar.className = "w-10 h-10 rounded-full object-cover";
                        const contentDiv = document.createElement("div");
                        contentDiv.className = "bg-[#3a3b3c] rounded-lg p-3 text-sm flex-1";
                        const nameP = document.createElement("p");
                        nameP.className = "font-semibold text-white";
                        nameP.textContent = '{{ user.name }}';
                        const textP = document.createElement("p");
                        textP.className = "text-[#B0B3B8]";
                        textP.textContent = comment.content;
                        const timeP = document.createElement("p");
                        timeP.className = "text-[#B0B3B8] text-xs mt-1";
                        timeP.textContent = formatTimestamp(comment.createdAt);
                        const replyBtn = document.createElement("button");
                        replyBtn.className = "text-[#B0B3B8] hover:text-white text-xs mt-1";
                        replyBtn.setAttribute("data-reply-btn", "");
                        replyBtn.innerHTML = '<i class="fas fa-reply mr-1"></i>Trả lời';
                        replyBtn.addEventListener("click", () => {
                            createReplyBox(contentDiv);
                        });
                        const toggleBtn = document.createElement("button");
                        toggleBtn.className = "text-[#B0B3B8] hover:text-white text-xs mt-1 ml-2";
                        toggleBtn.textContent = "Hiện trả lời";
                        toggleBtn.type = "button";
                        const repliesContainer = document.createElement("div");
                        repliesContainer.className = "ml-6 mt-3 space-y-3";
                        repliesContainer.setAttribute("data-replies", "");
                        repliesContainer.style.display = "none";
                        toggleBtn.addEventListener("click", () => {
                            if (repliesContainer.style.display === "none") {
                                repliesContainer.style.display = "block";
                                toggleBtn.textContent = "Ẩn/Hiện trả lời";
                            } else {
                                repliesContainer.style.display = "none";
                                toggleBtn.textContent = "Hiện trả lời";
                            }
                        });
                        contentDiv.appendChild(nameP);
                        contentDiv.appendChild(textP);
                        contentDiv.appendChild(timeP);
                        contentDiv.appendChild(replyBtn);
                        contentDiv.appendChild(toggleBtn);
                        mainComment.appendChild(avatar);
                        mainComment.appendChild(contentDiv);
                        commentDiv.appendChild(mainComment);
                        commentDiv.appendChild(repliesContainer);
                        commentsContainer.prepend(commentDiv);
                        commentInput.value = "";
                        sendCommentBtn.disabled = true;
                        commentsScrollContainer.scrollTop = 0;
                    } catch (error) {
                        console.error('Lỗi khi gửi bình luận:', error);
                        showToast({message: "Đã có lỗi xảy ra khi gửi bình luận. Vui lòng thử lại!", type: "error", delay: 5000});
                    }
                }
                sendCommentBtn.addEventListener("click", handleSendComment);
                commentInput.addEventListener('keypress', (e) => {
                    if (e.key === 'Enter' && !e.shiftKey) {
                        e.preventDefault();
                        handleSendComment();
                    }
                });
                async function fetchComments(append = false) {
                    if (! postId || isLoading || ! hasMoreComments) 
                        return;
                    
                    isLoading = true;
                    try {
                        console.log(`Fetching comments for postId: ${postId}, page: ${page}`); // Debug log
                        const response = await fetch(`/comment/post/${postId}?limit=${limit}&page=${page}`, {
                            method: 'GET',
                            headers: {
                                'Content-Type': 'application/json'
                            }
                        });
                        if (! response.ok) {
                            throw new Error(`HTTP error! Status: ${
                                response.status
                            }`);
                        }
                        const {data: comments} = await response.json();
                        console.log('Comments fetched:', comments); // Debug log
                        if (comments.length === 0) {
                            hasMoreComments = false;
                            isLoading = false;
                            return;
                        }
                        if (! append) {
                            commentsContainer.innerHTML = '';
                        }
                        const commentMap = new Map();
                        comments.forEach(comment => {
                            commentMap.set(comment._id, comment);
                        });
                        comments.sort((a, b) => new Date(b.createdAt) - new Date(a.createdAt));
                        comments.forEach(comment => {
                            console.log('Rendering comment:', comment); // Debug log
                            const commentDiv = document.createElement("div");
                            commentDiv.className = "flex flex-col space-y-1";
                            commentDiv.setAttribute('data-comment-id', comment._id);
                            const mainComment = document.createElement("div");
                            mainComment.className = "flex items-start space-x-3";
                            const avatar = document.createElement("img");
                            avatar.alt = "User avatar";
                            avatar.src = comment.author.avatar ||
                            "https://storage.googleapis.com/a1aa/image/6e303d4d-7b8b-4278-02b8-dfc6c68b3a32.jpg";
                            avatar.width = 40;
                            avatar.height = 40;
                            avatar.className = "w-10 h-10 rounded-full object-cover";
                            const contentDiv = document.createElement("div");
                            contentDiv.className = "bg-[#3a3b3c] rounded-lg p-3 text-sm flex-1";
                            const nameP = document.createElement("p");
                            nameP.className = "font-semibold text-white";
                            nameP.textContent = comment.author.name || "Nguyễn Hùng";
                            const textP = document.createElement("p");
                            textP.className = "text-[#B0B3B8]";
                            textP.textContent = comment.content;
                            const timeP = document.createElement("p");
                            timeP.className = "text-[#B0B3B8] text-xs mt-1";
                            timeP.textContent = formatTimestamp(comment.createdAt);
                            const replyBtn = document.createElement("button");
                            replyBtn.className = "text-[#B0B3B8] hover:text-white text-xs mt-1";
                            replyBtn.setAttribute("data-reply-btn", "");
                            replyBtn.innerHTML = '<i class="fas fa-reply mr-1"></i>Trả lời';
                            replyBtn.addEventListener("click", () => {
                                createReplyBox(contentDiv);
                            });
                            const toggleBtn = document.createElement("button");
                            toggleBtn.className = "text-[#B0B3B8] hover:text-white text-xs mt-1 ml-2";
                            toggleBtn.textContent = "Hiện trả lời";
                            toggleBtn.type = "button";
                            const repliesContainer = document.createElement("div");
                            repliesContainer.className = "ml-6 mt-3 space-y-3";
                            repliesContainer.setAttribute("data-replies", "");
                            repliesContainer.style.display = "none";
                            toggleBtn.addEventListener("click", () => {
                                if (repliesContainer.style.display === "none") {
                                    repliesContainer.style.display = "block";
                                    toggleBtn.textContent = "Ẩn/Hiện trả lời";
                                } else {
                                    repliesContainer.style.display = "none";
                                    toggleBtn.textContent = "Hiện trả lời";
                                }
                            });
                            contentDiv.appendChild(nameP);
                            contentDiv.appendChild(textP);
                            contentDiv.appendChild(timeP);
                            contentDiv.appendChild(replyBtn);
                            if (comment.replies ?. length) {
                                contentDiv.appendChild(toggleBtn);
                            }
                            mainComment.appendChild(avatar);
                            mainComment.appendChild(contentDiv);
                            commentDiv.appendChild(mainComment);
                            commentDiv.appendChild(repliesContainer);
                            commentsContainer.appendChild(commentDiv); // Ensure commentDiv is appended
                            function addReplies(replies, parentId) {
                                console.log(`Adding replies for parentId: ${parentId}`, replies); // Debug log
                                replies.forEach(reply => {
                                    const replyDiv = document.createElement("div");
                                    replyDiv.className = "flex items-start space-x-3";
                                    replyDiv.setAttribute('data-comment-id', reply._id);
                                    const replyAvatar = document.createElement("img");
                                    replyAvatar.alt = "User avatar";
                                    replyAvatar.src = reply.author.avatar || "https://storage.googleapis.com/a1aa/image/6e303d4d-7b8b-4278-02b8-dfc6c68b3a32.jpg";
                                    replyAvatar.width = 32;
                                    replyAvatar.height = 32;
                                    replyAvatar.className = "w-8 h-8 rounded-full object-cover";
                                    const replyContentDiv = document.createElement("div");
                                    replyContentDiv.className = "bg-[#4a4b4c] rounded-lg p-2 text-sm flex-1";
                                    const replyNameP = document.createElement("p");
                                    replyNameP.className = "font-semibold text-white";
                                    const parentComment = reply.parentComment;
                                    const parentName = parentComment && parentComment.author
                                        ? parentComment.author.name
                                        : "Unknown";
                                    replyNameP.textContent = `${
                                        reply.author.name
                                    } > ${parentName}`;
                                    const replyTextP = document.createElement("p");
                                    replyTextP.className = "text-[#B0B3B8]";
                                    replyTextP.textContent = reply.content;
                                    const replyTimeP = document.createElement("p");
                                    replyTimeP.className = "text-[#B0B3B8] text-xs mt-1";
                                    replyTimeP.textContent = formatTimestamp(reply.createdAt);
                                    const replyReplyBtn = document.createElement("button");
                                    replyReplyBtn.className = "text-[#B0B3B8] hover:text-white text-xs mt-1";
                                    replyReplyBtn.setAttribute("data-reply-btn", "");
                                    replyReplyBtn.innerHTML = '<i class="fas fa-reply mr-1"></i>Trả lời';
                                    replyReplyBtn.addEventListener("click", () => {
                                        createReplyBox(replyContentDiv);
                                    });
                                    const replyToggleBtn = document.createElement("button");
                                    replyToggleBtn.className = "text-[#B0B3B8] hover:text-white text-xs mt-1 ml-2";
                                    replyToggleBtn.textContent = "Hiện trả lời";
                                    replyToggleBtn.type = "button";
                                    const replyRepliesContainer = document.createElement("div");
                                    replyRepliesContainer.className = "ml-6 mt-3 space-y-3";
                                    replyRepliesContainer.setAttribute("data-replies", "");
                                    replyRepliesContainer.style.display = "none";
                                    replyToggleBtn.addEventListener("click", () => {
                                        if (replyRepliesContainer.style.display === "none") {
                                            replyRepliesContainer.style.display = "block";
                                            replyToggleBtn.textContent = "Ẩn/Hiện trả lời";
                                        } else {
                                            replyRepliesContainer.style.display = "none";
                                            replyToggleBtn.textContent = "Hiện trả lời";
                                        }
                                    });
                                    replyContentDiv.appendChild(replyNameP);
                                    replyContentDiv.appendChild(replyTextP);
                                    replyContentDiv.appendChild(replyTimeP);
                                    replyContentDiv.appendChild(replyReplyBtn);
                                    if (reply.replies ?. length) {
                                        replyContentDiv.appendChild(replyToggleBtn);
                                    }
                                    replyDiv.appendChild(replyAvatar);
                                    replyDiv.appendChild(replyContentDiv);
                                    repliesContainer.appendChild(replyDiv);
                                    repliesContainer.appendChild(replyRepliesContainer);
                                    if (reply.replies ?. length) {
                                        addReplies(reply.replies, reply._id);
                                    }
                                });
                            }
                            if (comment.replies ?. length) {
                                addReplies(comment.replies, comment._id);
                            }
                        });
                        page += 1;
                        isLoading = false;
                        if (! append) {
                            commentsScrollContainer.scrollTop = 0;
                        }
                    } catch (error) {
                        console.error('Lỗi khi lấy bình luận:', error);
                        showToast({message: "Đã có lỗi xảy ra khi lấy bình luận. Vui lòng thử lại!", type: "error", delay: 5000});
                        isLoading = false;
                    }
                }
                commentsScrollContainer.addEventListener('scroll', () => {
                    if (isLoading || ! hasMoreComments) 
                        return;
                    
                    const {scrollTop, scrollHeight, clientHeight} = commentsScrollContainer;
                    if (scrollTop + clientHeight >= scrollHeight - 50) {
                        fetchComments(true);
                    }
                });
                function init() {
                    renderMedia();
                    fetchComments();
                    updateButtonState();
                }
                init();
            })();
        </script>
        <script src="https://cdn.socket.io/4.6.1/socket.io.min.js"></script>
        <script src="{{ baseUrl }}/src/js/noti-user.js"></script>
    </body>
</html>