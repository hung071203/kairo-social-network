<nav aria-label="Page navigation">
  <ul class="pagination pagination-rounded">
    <!-- Nút First -->
    <li class="page-item first {{ 'disabled' if data.page == 1 else '' }}">
      <a class="page-link" href="?page=1" aria-label="First">
        <i class="tf-icon bx bx-chevrons-left bx-sm"></i>
      </a>
    </li>
    <!-- Nút Previous -->
    <li class="page-item prev {{ 'disabled' if not data.hasPrevPage else '' }}">
      <a class="page-link" href="?page={{ data.prevPage or 1 }}" aria-label="Previous">
        <i class="tf-icon bx bx-chevron-left bx-sm"></i>
      </a>
    </li>
    <!-- Các nút số trang -->
    {% if data.totalPages >= 5 %}
      {% if data.page > 2 and data.page < data.totalPages - 1 %}
        <!-- Trang 1 -->
        <li class="page-item">
          <a class="page-link" href="?page=1">1</a>
        </li>
        <!-- Dấu ... -->
        <li class="page-item disabled">
          <span class="page-link">...</span>
        </li>
        <!-- Trang trước, hiện tại, sau -->
        <li class="page-item">
          <a class="page-link" href="?page={{ data.page - 1 }}">{{ data.page - 1 }}</a>
        </li>
        <li class="page-item active">
          <a class="page-link" href="?page={{ data.page }}">{{ data.page }}</a>
        </li>
        <li class="page-item">
          <a class="page-link" href="?page={{ data.page + 1 }}">{{ data.page + 1 }}</a>
        </li>
        <!-- Dấu ... -->
        <li class="page-item disabled">
          <span class="page-link">...</span>
        </li>
        <!-- Trang cuối -->
        <li class="page-item">
          <a class="page-link" href="?page={{ data.totalPages }}">{{ data.totalPages }}</a>
        </li>
      {% else %}
        <!-- Hiển thị 3 trang đầu nếu ở đầu -->
        {% if data.page <= 2 %}
          {% for i in range(1, 4) %}
            <li class="page-item {{ 'active' if i == data.page else '' }}">
              <a class="page-link" href="?page={{ i }}">{{ i }}</a>
            </li>
          {% endfor %}
          <!-- Dấu ... -->
          <li class="page-item disabled">
            <span class="page-link">...</span>
          </li>
          <!-- Trang cuối -->
          <li class="page-item {{ 'active' if data.page == data.totalPages else '' }}">
            <a class="page-link" href="?page={{ data.totalPages }}">{{ data.totalPages }}</a>
          </li>
        {% else %}
          <!-- Hiển thị trang 1 và 3 trang cuối nếu ở cuối -->
          <li class="page-item {{ 'active' if data.page == 1 else '' }}">
            <a class="page-link" href="?page=1">1</a>
          </li>
          <!-- Dấu ... -->
          <li class="page-item disabled">
            <span class="page-link">...</span>
          </li>
          {% for i in range(data.totalPages - 2, data.totalPages + 1) %}
            <li class="page-item {{ 'active' if i == data.page else '' }}">
              <a class="page-link" href="?page={{ i }}">{{ i }}</a>
            </li>
          {% endfor %}
        {% endif %}
      {% endif %}
    {% else %}
      <!-- Hiển thị tất cả trang nếu tổng số trang < 5 -->
      {% for i in range(1, data.totalPages + 1) %}
        <li class="page-item {{ 'active' if i == data.page else '' }}">
          <a class="page-link" href="?page={{ i }}">{{ i }}</a>
        </li>
      {% endfor %}
    {% endif %}
    <!-- Nút Next -->
    <li class="page-item next {{ 'disabled' if not data.hasNextPage else '' }}">
      <a class="page-link" href="?page={{ data.nextPage or data.totalPages }}" aria-label="Next">
        <i class="tf-icon bx bx-chevron-right bx-sm"></i>
      </a>
    </li>
    <!-- Nút Last -->
    <li class="page-item last {{ 'disabled' if data.page == data.totalPages else '' }}">
      <a class="page-link" href="?page={{ data.totalPages }}" aria-label="Last">
        <i class="tf-icon bx bx-chevrons-right bx-sm"></i>
      </a>
    </li>
  </ul>
</nav>
<script>
  document.addEventListener('DOMContentLoaded', () => {
    const links = document.querySelectorAll('.page-link');
    const currentUrl = new URL(window.location.href);
    const params = new URLSearchParams(currentUrl.search);

    // Loại bỏ tham số 'page' để tránh xung đột
    params.delete('page');

    // Lấy tất cả các tham số query còn lại
    const queryString = params.toString();

    links.forEach(link => {
      const href = new URL(link.href, window.location.origin);
      // Thêm các tham số query vào href
      if (queryString) {
        const linkParams = new URLSearchParams(href.search);
        // Gộp các tham số hiện có của link với các tham số từ URL hiện tại
        for (const [key, value] of params) {
          linkParams.set(key, value);
        }
        href.search = linkParams.toString();
      }
      link.href = href.toString();
    });
  });
</script>