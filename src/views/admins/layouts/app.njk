    <!-- Page CSS -->
    <style>
      th {
        cursor: default;
      }
      th.sortable {
        cursor: pointer;
        position: relative;
        transition: transform 0.3s ease;
      }
      /* Thay đổi biểu tượng khi di chuột vào thẻ <th> có lớp 'sortable' */
      th.sortable:hover i.fas.fa-sort::before {
        content: "\f0de"; /* Mã Unicode cho biểu tượng fa-sort-up */
        transition: content 0.3s ease; /* Hiệu ứng chuyển đổi mượt mà */
      }
      /* Quay lại trạng thái ban đầu khi chuột rời đi */
      th.sortable i.fas.fa-sort::before {
        content: "\f0dc"; /* Mã Unicode cho biểu tượng fa-sort */
        transition: content 0.3s ease; /* Hiệu ứng chuyển đổi mượt mà */
      }
      th.sortable:hover i {
        color: #007bff; /* Thay đổi màu biểu tượng khi hover */
        transform: rotate(180deg); /* Xoay biểu tượng 180 độ khi hover */
        transition: transform 0.3s ease, color 0.3s ease; /* Hiệu ứng chuyển đổi mượt mà */
      }
    </style>
