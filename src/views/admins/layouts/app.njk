    <!-- Core JS -->
    <!-- build:js assets/vendor/js/core.js -->
    <script src="{{ baseUrl }}/src/vendor/libs/jquery/jquery.js"></script>
    <script src="{{ baseUrl }}/src/vendor/libs/popper/popper.js"></script>
    <script src="{{ baseUrl }}/src/vendor/js/bootstrap.js"></script>
    <script src="{{ baseUrl }}/src/vendor/libs/perfect-scrollbar/perfect-scrollbar.js"></script>
    <script src="{{ baseUrl }}/src/vendor/js/menu.js"></script>
    <!-- endbuild -->
    <!-- Vendors JS -->
    <script src="{{ baseUrl }}/src/vendor/libs/apex-charts/apexcharts.js"></script>
    <!-- Main JS -->
    <script src="{{ baseUrl }}/src/js/main.js"></script>
    <!-- Page JS -->
    <script src="{{ baseUrl }}/src/js/dashboards-analytics.js"></script>
    <!-- Place this tag before closing body tag for github widget button. -->
    <script async defer src="https://buttons.github.io/buttons.js"></script>
    <script>
      function setQueryParams(params = {}) {
        const urlParams = new URLSearchParams(window.location.search);
        for (const key in params) {
          if (params[key]) {
            urlParams.set(key, params[key]);
          } else {
            urlParams.delete(key);
          }
        }
        window.location.href = `?${
          urlParams.toString()
        }`;
      }
    </script>
    <script>      function showToast({
        message = "Default message", // Nội dung toast
        header = "Default header", // Tiêu đề toast
        iconClass = "bx bx-bell", // Icon mặc định
        delay = 2000, // Thời gian hiển thị
        type = "success", // Loại thông báo: 'success', 'error', 'warning', 'info'
        placement = "top-0 end-0", // Vị trí toast
        time = "Ngay bây giờ", // Thời gian
        url = null // URL để redirect khi click vào toast
      } = {}) {
        const toastElement = document.querySelector("#custom-toast");
        const toastBody = toastElement.querySelector("#toast-body");
        const toastHeader = toastElement.querySelector("#toast-header");
        const toastIcon = toastElement.querySelector("#toast-icon");
        const toastTime = toastElement.querySelector("#toast-time");
        
        // Xác định lớp CSS và biểu tượng dựa trên loại thông báo
        let bgClass, icon;
        switch (type) {
          case "success": 
            bgClass = "bg-success";
            icon = "bx bx-check-circle";
            break;
          case "error": 
            bgClass = "bg-danger";
            icon = "bx bx-error";
            break;
          case "warning": 
            bgClass = "bg-warning";
            icon = "bx bx-error-circle";
            break;
          case "info":
          default: 
            bgClass = "bg-primary";
            icon = "bx bx-info-circle";
            break;
        }
        
        // Cập nhật nội dung toast
        toastBody.textContent = message;
        toastHeader.textContent = header;
        toastIcon.className = icon;
        toastTime.textContent = time;
        
        // Cập nhật lớp của toast
        toastElement.className = `bs-toast toast toast-placement-ex m-2 fade hide ${bgClass} ${placement}`;
        
        // Thêm cursor pointer nếu có URL
        if (url) {
          toastElement.style.cursor = 'pointer';
          toastElement.style.userSelect = 'none';
          
          // Remove existing click handlers
          const newToastElement = toastElement.cloneNode(true);
          toastElement.parentNode.replaceChild(newToastElement, toastElement);
          
          // Add click handler for redirect
          newToastElement.addEventListener('click', function(e) {
            // Ignore click on close button
            if (e.target.classList.contains('btn-close') || e.target.closest('.btn-close')) {
              return;
            }
            
            if (url.startsWith('http://') || url.startsWith('https://')) {
              window.open(url, '_blank');
            } else {
              window.location.href = url;
            }
            
            // Hide toast after click
            const toastInstance = bootstrap.Toast.getInstance(newToastElement);
            if (toastInstance) {
              toastInstance.hide();
            }
          });
          
          // Use the new element for toast instance
          const toastInstance = new bootstrap.Toast(newToastElement, {delay: delay});
          toastInstance.show();
          
        } else {
          toastElement.style.cursor = 'default';
          // Khởi tạo toast với delay
          const toastInstance = new bootstrap.Toast(toastElement, {delay: delay});
          // Hiển thị toast
          toastInstance.show();
        }
      }

      function getColor(text) {
        const colors = [
          'dark',
          'info',
          'warning',
          'danger',
          'success',
          'secondary',
          'primary',
        ];
        let hash = 0;
        for (let i = 0; i < text.length; i++) {
          hash = text.charCodeAt(i) + ((hash << 5) - hash);
        }
        return colors[Math.abs(hash) % colors.length];
      };
    </script>
    {% if successMessage is defined %}
      <script>
        showToast({message: "{{ successMessage }}", header: "Thông báo", type: "success", delay: 3000});
      </script>
    {% endif %}
    {% if errorMessage is defined %}
      <script>
        showToast({message: "{{ errorMessage }}", header: "Lỗi!", type: "error", delay: 5000});
      </script>
    {% endif %}
  </body>
</html>