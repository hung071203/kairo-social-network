{% extends 'admins/layouts/app.njk' %}
{% set title = 'Quản lý báo cáo' %}
{% set auth = false %}
{% block content %}
    <div class="card-header border-bottom">
        <h5 class="card-header">Quản lý báo cáo</h5>
    </div>
    <br/>
      <!-- Search and Filter Section -->
    <div class="d-flex justify-content-start gap-3 mb-3">
        <!-- Search by reason -->
        <div class="input-group" style="max-width: 300px;">
            <input type="text" class="form-control" id="searchReason" placeholder="Tìm kiếm theo lý do...">
            <button class="btn btn-outline-primary" onclick="submitReasonSearch()">
                <i class="bx bx-search"></i>
                Tìm kiếm
            </button>
        </div>
        
        <!-- Filter by report type -->
        <div class="input-group" style="max-width: 300px;">
            <select class="form-select" id="reportType" onchange="submitTypeFilter()">
                <option value="">Tất cả loại báo cáo</option>
                <option value="USER">Báo cáo người dùng</option>
                <option value="POST">Báo cáo bài viết</option>
            </select>
        </div>
        
        <!-- Filter by resolution status -->
        <div class="input-group" style="max-width: 300px;">
            <select class="form-select" id="reportResolved" onchange="submitResolvedFilter()">
                <option value="">Tất cả trạng thái</option>
                <option value="false">Chưa xử lý</option>
                <option value="true">Đã xử lý</option>
            </select>
        </div>
        
        <!-- Clear filters -->
        {% if query.search or query.type or query.isResolved %}
            <button class="btn btn-outline-secondary" onclick="clearFilters()">
                <i class="bx bx-x"></i>
                Xóa bộ lọc
            </button>        {% endif %}
    </div>

      <!-- Filter notification banner -->
    {% if query.search or query.type or query.isResolved %}
        <div class="alert alert-info d-flex align-items-center justify-content-between" role="alert">
            <div>
                <i class="bx bx-info-circle me-2"></i>
                <strong>Đang lọc:</strong>
                {% if query.search %}
                    Tìm kiếm: "<em>{{ query.search }}</em>"
                {% endif %}                {% if query.type %}
                    {% if query.type == 'USER' %}
                        {% set typeLabel = 'Báo cáo người dùng' %}
                    {% elif query.type == 'POST' %}
                        {% set typeLabel = 'Báo cáo bài viết' %}
                    {% else %}
                        {% set typeLabel = query.type %}
                    {% endif %}
                    Loại: "<em>{{ typeLabel }}</em>"
                {% endif %}
                {% if query.isResolved %}
                    {% if query.isResolved == 'true' %}
                        {% set statusLabel = 'Đã xử lý' %}
                    {% elif query.isResolved == 'false' %}
                        {% set statusLabel = 'Chưa xử lý' %}
                    {% else %}
                        {% set statusLabel = query.isResolved %}
                    {% endif %}
                    Trạng thái: "<em>{{ statusLabel }}</em>"
                {% endif %}
            </div>
            <button class="btn btn-sm btn-outline-secondary" onclick="clearFilters()">
                <i class="bx bx-x me-1"></i>Xóa bộ lọc
            </button>
        </div>
    {% endif %}
    
    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Người báo cáo</th>
                    <th>Nội dung bị báo cáo</th>
                    <th>Loại báo cáo</th>
                    <th>Lý do</th>
                    <th>Trạng thái</th>
                    <th>Ngày báo cáo</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                {% set index = (data.page - 1) * data.limit + 1 %}
                {% if data.docs and data.docs.length > 0 %}
                    {% for item in data.docs %}
                        <tr>
                            <td>{{ index }}</td>                            <td>
                                <div class="d-flex align-items-center">
                                    {% if item.reporter and item.reporter.avatar %}
                                        <img src="{{ item.reporter.avatar }}" 
                                             class="rounded-circle me-2" 
                                             width="30" height="30" 
                                             alt="Avatar">
                                    {% else %}
                                        <div class="rounded-circle bg-secondary me-2 d-flex align-items-center justify-content-center" 
                                             style="width: 30px; height: 30px; font-size: 12px; color: white;">
                                            {% if item.reporter and item.reporter.name %}
                                                {{ item.reporter.name.charAt(0).toUpperCase() }}
                                            {% else %}
                                                ?
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                    <div>
                                        <strong>{{ item.reporter.name if item.reporter and item.reporter.name else 'Không xác định' }}</strong><br>
                                        <small class="text-muted">@{{ item.reporter.username if item.reporter and item.reporter.username else 'unknown' }}</small>
                                    </div>
                                </div>
                            </td>                            <td>
                                <div style="max-width: 200px;">
                                    {% if item.target %}
                                        <div class="text-truncate">
                                            <strong>ID đối tượng:</strong> {{ item.target }}
                                        </div>
                                        <small class="text-muted">
                                            Loại: {{ item.type }}
                                        </small>
                                    {% else %}
                                        <span class="text-muted">Nội dung đã bị xóa</span>
                                    {% endif %}
                                </div>
                            </td>                            <td>
                                {% if item.type == 'USER' %}
                                    <span class="badge bg-label-info me-1">Báo cáo người dùng</span>
                                {% elif item.type == 'POST' %}
                                    <span class="badge bg-label-warning me-1">Báo cáo bài viết</span>
                                {% else %}
                                    <span class="badge bg-label-secondary me-1">{{ item.type }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <div style="max-width: 150px;" class="text-truncate" 
                                     data-bs-toggle="tooltip" 
                                     data-bs-placement="top" 
                                     title="{{ item.reason }}">
                                    {{ item.reason | truncate(30) }}
                                </div>
                            </td>                            <td>
                                {% if item.responder %}
                                    <span class="badge bg-label-success me-1">Đã xử lý</span>
                                {% else %}
                                    <span class="badge bg-label-warning me-1">Chờ xử lý</span>
                                {% endif %}
                            </td>
                            <td>
                                <small>{{ item.createdAt | date('DD/MM/YYYY HH:mm') }}</small>
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" 
                                            data-bs-toggle="dropdown">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" href="javascript:void(0);" 
                                           onclick="viewReportDetail('{{ item._id }}')">
                                            <i class="bx bx-detail me-1"></i> Xem chi tiết
                                        </a>
                                        {% if item.target %}
                                            <a class="dropdown-item" href="javascript:void(0);" 
                                               onclick="viewReportedContent('{{ item.target }}', '{{ item.type }}')">
                                                <i class="bx bx-show me-1"></i> Xem nội dung
                                            </a>
                                        {% endif %}
                                        {% if not item.responder %}
                                            <a class="dropdown-item" href="javascript:void(0);" 
                                               onclick="resolveReport('{{ item._id }}')">
                                                <i class="bx bx-check-circle me-1"></i> Đánh dấu đã xử lý
                                            </a>                                        {% endif %}
                                    </div>
                                </div>
                            </td>
                        </tr>
                        {% set index = index + 1 %}
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="bx bx-info-circle me-2"></i>
                            Không có báo cáo nào được tìm thấy
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>    </div>
    
    {% include '../../layouts/_pagination.njk' %}
    
    <!-- Report Detail Modal -->
    <div class="modal fade" id="reportDetailModal" tabindex="-1" aria-labelledby="reportDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reportDetailModalLabel">Chi Tiết Báo Cáo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="reportDetailContent">
                        <!-- Report detail content will be loaded here -->
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Reported Post Modal -->
    <div class="modal fade" id="reportedPostModal" tabindex="-1" aria-labelledby="reportedPostModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reportedPostModalLabel">Bài Viết Bị Báo Cáo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="reportedPostContent">
                        <!-- Reported post content will be loaded here -->
                    </div>
                </div>
            </div>
        </div>
    </div>
      <!-- Status Update Confirmation Modal -->
    <div class="modal fade" id="statusUpdateModal" tabindex="-1" aria-labelledby="statusUpdateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="statusUpdateModalLabel">Xử Lý Báo Cáo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Vui lòng nhập lý do phản hồi cho báo cáo này:</p>
                    <div class="mb-3">
                        <label for="responseContent" class="form-label">Lý do phản hồi</label>
                        <textarea class="form-control" id="responseContent" rows="4" 
                                  placeholder="Nhập lý do xử lý báo cáo..."></textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary" onclick="confirmStatusUpdate()">Xác nhận xử lý</button>
                </div>
            </div>
        </div>
    </div>    
    <!-- Delete Report Confirmation Modal - REMOVED -->
    
    <!-- Success/Error Notification Modal -->
    <div class="modal fade" id="notificationModal" tabindex="-1" aria-labelledby="notificationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-body text-center">
                    <div id="notificationContent">
                        <!-- Notification content will be loaded here -->
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        // ===== SEARCH AND FILTER FUNCTIONS =====
        
        // Get query parameters from URL
        function getQueryParam(param) {
            const params = new URLSearchParams(window.location.search);
            return params.get(param) || "";
        }
        
        // Set values from URL when page loads
        document.addEventListener('DOMContentLoaded', function() {
            document.getElementById("searchReason").value = getQueryParam("search");
            document.getElementById("reportType").value = getQueryParam("type");
            document.getElementById("reportResolved").value = getQueryParam("isResolved");
            
            // Initialize tooltips
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
            
            // Add enter key listener for search
            document.getElementById("searchReason").addEventListener("keydown", function (event) {
                if (event.key === "Enter") {
                    submitReasonSearch();
                }
            });
        });
        
        function submitReasonSearch() {
            let input = document.getElementById("searchReason").value.trim();
            let url = new URL(window.location.href);
            
            if (input) {
                url.searchParams.set("search", input);
            } else {
                url.searchParams.delete("search");
            }
            window.location.href = url.toString();
        }
        
        function submitTypeFilter() {
            let typeSelect = document.getElementById("reportType").value;
            let url = new URL(window.location.href);
            
            if (typeSelect) {
                url.searchParams.set("type", typeSelect);
            } else {
                url.searchParams.delete("type");
            }
            window.location.href = url.toString();
        }
        
        function submitResolvedFilter() {
            let resolvedSelect = document.getElementById("reportResolved").value;
            let url = new URL(window.location.href);
            
            if (resolvedSelect) {
                url.searchParams.set("isResolved", resolvedSelect);
            } else {
                url.searchParams.delete("isResolved");
            }
            window.location.href = url.toString();
        }
        
        function clearFilters() {
            let url = new URL(window.location.href);
            url.searchParams.delete("search");
            url.searchParams.delete("type");
            url.searchParams.delete("isResolved");
            window.location.href = url.toString();
        }

        // ===== REPORT MANAGEMENT FUNCTIONS =====
        
        let currentReportId = null;          // View report detail
        function viewReportDetail(reportId) {
            currentReportId = reportId;
            // Load report detail via AJAX
            fetch('{{ baseUrl }}/report-management/detail/' + reportId)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        // Pass the entire response to formatReportDetail
                        document.getElementById('reportDetailContent').innerHTML = formatReportDetail(data);
                        new bootstrap.Modal(document.getElementById('reportDetailModal')).show();
                    } else {
                        showNotification('error', data.message || 'Có lỗi xảy ra khi tải chi tiết báo cáo');
                    }
                })
                .catch(error => {
                    console.error('Error fetching report detail:', error);
                    showNotification('error', 'Có lỗi xảy ra khi tải chi tiết báo cáo');
                });
        }
          // View reported content
        function viewReportedContent(targetId, reportType) {
            // Redirect to appropriate management page based on report type
            if (reportType === 'POST') {
                window.location.href = '{{ baseUrl }}/post-management?search=' + encodeURIComponent(targetId);
            } else if (reportType === 'USER') {
                window.location.href = '{{ baseUrl }}/user-management?search=' + encodeURIComponent(targetId);
            } else {
                showNotification('error', 'Loại báo cáo không được hỗ trợ');
            }
        }
        
        // Resolve report
        function resolveReport(reportId) {
            currentReportId = reportId;
            
            // Clear previous content
            document.getElementById('responseContent').value = '';
            new bootstrap.Modal(document.getElementById('statusUpdateModal')).show();
        }
        
        function confirmStatusUpdate() {
            if (!currentReportId) return;
            
            const responseContent = document.getElementById('responseContent').value.trim();
            
            // Validate input
            if (!responseContent) {
                alert('Vui lòng nhập lý do phản hồi');
                return;
            }
            
            fetch('{{ baseUrl }}/report-management/resolve/' + currentReportId, {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    responseContent: responseContent
                })
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification('success', 'Đánh dấu báo cáo đã xử lý thành công');
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                } else {
                    showNotification('error', data.message || 'Có lỗi xảy ra khi cập nhật trạng thái');
                }
            })
            .catch(error => {
                showNotification('error', 'Có lỗi xảy ra khi cập nhật trạng thái');
            })
            .finally(() => {
                bootstrap.Modal.getInstance(document.getElementById('statusUpdateModal')).hide();
            });
        }          // Format report detail
        function formatReportDetail(data) {
            // Handle both direct report object and API response format
            const report = data.data || data;
            
            const typeLabels = {
                'USER': 'Báo cáo người dùng',
                'POST': 'Báo cáo bài viết'
            };
            
            const reporterName = report.reporter?.name || 'Không xác định';
            const reporterUsername = report.reporter?.username || 'unknown';
            const responderName = report.responder?.name || null;
            const statusText = report.isResolved ? 'Đã xử lý' : 'Chờ xử lý';
            const typeText = typeLabels[report.type] || report.type;
            
            var html = '<div class="card">';
            html += '<div class="card-body">';
            html += '<div class="row">';
            html += '<div class="col-md-6">';
            html += '<h6>Thông tin người báo cáo:</h6>';
            html += '<div class="d-flex align-items-center mb-3">';
            
            if (report.reporter?.avatar) {
                html += '<img src="' + report.reporter.avatar + '" class="rounded-circle me-3" width="50" height="50" alt="Avatar">';
            } else {
                html += '<div class="rounded-circle bg-secondary me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; color: white;">';
                html += reporterName.charAt(0).toUpperCase();
                html += '</div>';
            }
            
            html += '<div>';
            html += '<strong>' + reporterName + '</strong><br>';
            html += '<small class="text-muted">@' + reporterUsername + '</small>';
            if (report.reporter?.email) {
                html += '<br><small class="text-muted">' + report.reporter.email + '</small>';
            }
            html += '</div>';
            html += '</div>';
            html += '</div>';
            html += '<div class="col-md-6">';
            html += '<h6>Thông tin báo cáo:</h6>';
            html += '<p><strong>ID báo cáo:</strong> <code>' + report._id + '</code></p>';
            html += '<p><strong>Loại:</strong> ' + typeText + '</p>';
            html += '<p><strong>Trạng thái:</strong> ';
            html += '<span class="badge ' + (report.isResolved ? 'bg-label-success' : 'bg-label-warning') + ' me-1">';
            html += statusText;
            html += '</span>';
            html += '</p>';
            html += '<p><strong>Ngày báo cáo:</strong> ' + new Date(report.createdAt).toLocaleString('vi-VN') + '</p>';
            
            if (report.updatedAt && report.updatedAt !== report.createdAt) {
                html += '<p><strong>Cập nhật lần cuối:</strong> ' + new Date(report.updatedAt).toLocaleString('vi-VN') + '</p>';
            }
            
            if (responderName) {
                html += '<p><strong>Người xử lý:</strong> ' + responderName + '</p>';
            }
            
            html += '</div>';
            html += '</div>';
            html += '<hr>';
            html += '<h6>Lý do báo cáo:</h6>';
            html += '<p class="mb-3">' + (report.reason || 'Không có lý do cụ thể') + '</p>';
            
            if (report.responseContent) {
                html += '<hr>';
                html += '<h6>Phản hồi xử lý:</h6>';
                html += '<p class="mb-3">' + report.responseContent + '</p>';
            }
            
            html += '<hr>';
            html += '<h6>ID đối tượng bị báo cáo:</h6>';
            html += '<p><code>' + report.target + '</code></p>';
            html += '</div>';
            html += '</div>';
            
            return html;
        }
          // Format reported content
        function formatReportedContent(content, type) {
            var html = '';
            
            if (type === 'USER') {
                html += '<div class="card">';
                html += '<div class="card-body">';
                html += '<h6>Thông tin người dùng bị báo cáo:</h6>';
                html += '<hr>';
                html += '<div class="d-flex align-items-center mb-3">';
                
                if (content.avatar) {
                    html += '<img src="' + content.avatar + '" class="rounded-circle me-3" width="60" height="60" alt="Avatar">';
                } else {
                    html += '<div class="rounded-circle bg-secondary me-3 d-flex align-items-center justify-content-center" style="width: 60px; height: 60px; font-size: 24px; color: white;">';
                    html += (content.name || 'U').charAt(0).toUpperCase();
                    html += '</div>';
                }
                
                html += '<div>';
                html += '<h5>' + (content.name || 'Không xác định') + '</h5>';
                html += '<p class="text-muted mb-1">@' + (content.username || 'unknown') + '</p>';
                html += '<p class="text-muted">' + (content.email || 'Không có email') + '</p>';
                html += '</div>';
                html += '</div>';
                
                if (content.bio) {
                    html += '<div class="mb-3">';
                    html += '<strong>Tiểu sử:</strong>';
                    html += '<p class="mt-2">' + content.bio + '</p>';
                    html += '</div>';
                }
                
                html += '<div class="alert alert-info">';
                html += '<strong>ID người dùng:</strong> <code>' + content._id + '</code>';
                html += '</div>';
                html += '</div>';
                html += '</div>';
                
            } else if (type === 'POST') {
                html += '<div class="card">';
                html += '<div class="card-body">';
                html += '<h6>Bài viết bị báo cáo:</h6>';
                html += '<hr>';
                
                if (content.author) {
                    html += '<div class="d-flex align-items-center mb-3">';
                    
                    if (content.author.avatar) {
                        html += '<img src="' + content.author.avatar + '" class="rounded-circle me-2" width="40" height="40" alt="Avatar">';
                    } else {
                        html += '<div class="rounded-circle bg-secondary me-2 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; font-size: 16px; color: white;">';
                        html += (content.author.name || 'U').charAt(0).toUpperCase();
                        html += '</div>';
                    }
                    
                    html += '<div>';
                    html += '<strong>' + (content.author.name || 'Không xác định') + '</strong>';
                    html += '<small class="text-muted d-block">@' + (content.author.username || 'unknown') + '</small>';
                    html += '</div>';
                    html += '</div>';
                }
                
                html += '<div class="mb-3">';
                html += '<strong>Nội dung bài viết:</strong>';
                html += '<div class="mt-2 p-3 bg-light rounded">';
                html += (content.content || content.text || 'Không có nội dung');
                html += '</div>';
                html += '</div>';
                
                if (content.images && content.images.length > 0) {
                    html += '<div class="mb-3">';
                    html += '<strong>Hình ảnh đính kèm:</strong>';
                    html += '<div class="mt-2">';
                    content.images.forEach(function(img) {
                        html += '<img src="' + img + '" class="img-thumbnail me-2" style="max-width: 100px; max-height: 100px;">';
                    });
                    html += '</div>';
                    html += '</div>';
                }
                
                html += '<div class="alert alert-info">';
                html += '<strong>ID bài viết:</strong> <code>' + content._id + '</code><br>';
                html += '<strong>Ngày tạo:</strong> ' + (content.createdAt ? new Date(content.createdAt).toLocaleString('vi-VN') : 'Không xác định');
                html += '</div>';
                html += '</div>';
                html += '</div>';
            } else {
                html += '<div class="alert alert-warning">';
                html += '<strong>Loại nội dung không được hỗ trợ:</strong> ' + type;
                html += '</div>';
            }
            
            return html;
        }
          // Show notification
        function showNotification(type, message) {
            const iconClass = type === 'success' ? 'bx-check-circle text-success' : 'bx-error-circle text-danger';
            var content = '';
            content += '<div class="mb-3">';
            content += '<i class="bx ' + iconClass + '" style="font-size: 3rem;"></i>';
            content += '</div>';
            content += '<p class="mb-0">' + message + '</p>';
            
            document.getElementById('notificationContent').innerHTML = content;
            const modal = new bootstrap.Modal(document.getElementById('notificationModal'));
            modal.show();
            
            // Auto hide after 3 seconds
            setTimeout(() => {
                modal.hide();
            }, 3000);
        }
    </script>
{% endblock %}