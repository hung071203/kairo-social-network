{% extends 'admins/layouts/app.njk' %}
{% set title = 'Quản lý báo cáo' %}
{% set auth = false %}
{% block content %}
    <div class="card-header border-bottom">
        <h5 class="card-header">Quản lý báo cáo</h5>
    </div>
    <br/>
      <!-- Search and Filter Section -->
    <div class="d-flex justify-content-start gap-3 mb-3">
        <!-- Search by reason -->
        <div class="input-group" style="max-width: 300px;">
            <input type="text" class="form-control" id="searchReason" placeholder="Tìm kiếm theo lý do...">
            <button class="btn btn-outline-primary" onclick="submitReasonSearch()">
                <i class="bx bx-search"></i>
                Tìm kiếm
            </button>
        </div>
        
        <!-- Filter by report type -->
        <div class="input-group" style="max-width: 300px;">
            <select class="form-select" id="reportType" onchange="submitTypeFilter()">
                <option value="">Tất cả loại báo cáo</option>
                <option value="USER">Báo cáo người dùng</option>
                <option value="POST">Báo cáo bài viết</option>
            </select>
        </div>
        
        <!-- Filter by resolution status -->
        <div class="input-group" style="max-width: 300px;">
            <select class="form-select" id="reportResolved" onchange="submitResolvedFilter()">
                <option value="">Tất cả trạng thái</option>
                <option value="false">Chưa xử lý</option>
                <option value="true">Đã xử lý</option>
            </select>
        </div>
        
        <!-- Clear filters -->
        {% if query.search or query.type or query.isResolved %}
            <button class="btn btn-outline-secondary" onclick="clearFilters()">
                <i class="bx bx-x"></i>
                Xóa bộ lọc
            </button>
        {% endif %}
    </div>

    <script>
        // Get query parameters from URL
        function getQueryParam(param) {
            const params = new URLSearchParams(window.location.search);
            return params.get(param) || "";
        }
        
        // Set values from URL
        document.getElementById("searchReason").value = getQueryParam("search");
        document.getElementById("reportType").value = getQueryParam("type");
        document.getElementById("reportResolved").value = getQueryParam("isResolved");
        
        function submitReasonSearch() {
            let input = document.getElementById("searchReason").value.trim();
            let url = new URL(window.location.href);
            
            if (input) {
                url.searchParams.set("search", input);
            } else {
                url.searchParams.delete("search");
            }
            window.location.href = url.toString();
        }
        
        function submitTypeFilter() {
            let typeSelect = document.getElementById("reportType").value;
            let url = new URL(window.location.href);
            
            if (typeSelect) {
                url.searchParams.set("type", typeSelect);
            } else {
                url.searchParams.delete("type");
            }
            window.location.href = url.toString();
        }
        
        function submitResolvedFilter() {
            let resolvedSelect = document.getElementById("reportResolved").value;
            let url = new URL(window.location.href);
            
            if (resolvedSelect) {
                url.searchParams.set("isResolved", resolvedSelect);
            } else {
                url.searchParams.delete("isResolved");
            }
            window.location.href = url.toString();
        }
        
        function clearFilters() {
            let url = new URL(window.location.href);
            url.searchParams.delete("search");
            url.searchParams.delete("type");
            url.searchParams.delete("isResolved");
            window.location.href = url.toString();
        }
        
        // Add enter key listener for search
        document.getElementById("searchReason").addEventListener("keydown", function (event) {
            if (event.key === "Enter") {
                submitReasonSearch();
            }
        });
    </script>
      <!-- Filter notification banner -->
    {% if query.search or query.type or query.isResolved %}
        <div class="alert alert-info d-flex align-items-center justify-content-between" role="alert">
            <div>
                <i class="bx bx-info-circle me-2"></i>
                <strong>Đang lọc:</strong>
                {% if query.search %}
                    Tìm kiếm: "<em>{{ query.search }}</em>"
                {% endif %}                {% if query.type %}
                    {% if query.type == 'USER' %}
                        {% set typeLabel = 'Báo cáo người dùng' %}
                    {% elif query.type == 'POST' %}
                        {% set typeLabel = 'Báo cáo bài viết' %}
                    {% else %}
                        {% set typeLabel = query.type %}
                    {% endif %}
                    Loại: "<em>{{ typeLabel }}</em>"
                {% endif %}
                {% if query.isResolved %}
                    {% if query.isResolved == 'true' %}
                        {% set statusLabel = 'Đã xử lý' %}
                    {% elif query.isResolved == 'false' %}
                        {% set statusLabel = 'Chưa xử lý' %}
                    {% else %}
                        {% set statusLabel = query.isResolved %}
                    {% endif %}
                    Trạng thái: "<em>{{ statusLabel }}</em>"
                {% endif %}
            </div>
            <button class="btn btn-sm btn-outline-secondary" onclick="clearFilters()">
                <i class="bx bx-x me-1"></i>Xóa bộ lọc
            </button>
        </div>
    {% endif %}
    
    <div class="table-responsive text-nowrap">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Người báo cáo</th>
                    <th>Nội dung bị báo cáo</th>
                    <th>Loại báo cáo</th>
                    <th>Lý do</th>
                    <th>Trạng thái</th>
                    <th>Ngày báo cáo</th>
                    <th>Hành động</th>
                </tr>
            </thead>
            <tbody class="table-border-bottom-0">
                {% set index = (data.page - 1) * data.limit + 1 %}
                {% if data.docs and data.docs.length > 0 %}
                    {% for item in data.docs %}
                        <tr>
                            <td>{{ index }}</td>                            <td>
                                <div class="d-flex align-items-center">
                                    {% if item.reporter and item.reporter.avatar %}
                                        <img src="{{ item.reporter.avatar }}" 
                                             class="rounded-circle me-2" 
                                             width="30" height="30" 
                                             alt="Avatar">
                                    {% else %}
                                        <div class="rounded-circle bg-secondary me-2 d-flex align-items-center justify-content-center" 
                                             style="width: 30px; height: 30px; font-size: 12px; color: white;">
                                            {% if item.reporter and item.reporter.name %}
                                                {{ item.reporter.name.charAt(0).toUpperCase() }}
                                            {% else %}
                                                ?
                                            {% endif %}
                                        </div>
                                    {% endif %}
                                    <div>
                                        <strong>{{ item.reporter.name if item.reporter and item.reporter.name else 'Không xác định' }}</strong><br>
                                        <small class="text-muted">@{{ item.reporter.username if item.reporter and item.reporter.username else 'unknown' }}</small>
                                    </div>
                                </div>
                            </td>                            <td>
                                <div style="max-width: 200px;">
                                    {% if item.target %}
                                        <div class="text-truncate">
                                            <strong>ID đối tượng:</strong> {{ item.target }}
                                        </div>
                                        <small class="text-muted">
                                            Loại: {{ item.type }}
                                        </small>
                                    {% else %}
                                        <span class="text-muted">Nội dung đã bị xóa</span>
                                    {% endif %}
                                </div>
                            </td>                            <td>
                                {% if item.type == 'USER' %}
                                    <span class="badge bg-label-info me-1">Báo cáo người dùng</span>
                                {% elif item.type == 'POST' %}
                                    <span class="badge bg-label-warning me-1">Báo cáo bài viết</span>
                                {% else %}
                                    <span class="badge bg-label-secondary me-1">{{ item.type }}</span>
                                {% endif %}
                            </td>
                            <td>
                                <div style="max-width: 150px;" class="text-truncate" 
                                     data-bs-toggle="tooltip" 
                                     data-bs-placement="top" 
                                     title="{{ item.reason }}">
                                    {{ item.reason | truncate(30) }}
                                </div>
                            </td>                            <td>
                                {% if item.responder %}
                                    <span class="badge bg-label-success me-1">Đã xử lý</span>
                                {% else %}
                                    <span class="badge bg-label-warning me-1">Chờ xử lý</span>
                                {% endif %}
                            </td>
                            <td>
                                <small>{{ item.createdAt | date('DD/MM/YYYY HH:mm') }}</small>
                            </td>
                            <td>
                                <div class="dropdown">
                                    <button type="button" class="btn p-0 dropdown-toggle hide-arrow" 
                                            data-bs-toggle="dropdown">
                                        <i class="bx bx-dots-vertical-rounded"></i>
                                    </button>                                    <div class="dropdown-menu">
                                        <a class="dropdown-item" href="javascript:void(0);" 
                                           onclick="viewReportDetail('{{ item._id }}')">
                                            <i class="bx bx-detail me-1"></i> Xem chi tiết
                                        </a>
                                        {% if item.target %}
                                            <a class="dropdown-item" href="javascript:void(0);" 
                                               onclick="viewReportedContent('{{ item.target }}', '{{ item.type }}')">
                                                <i class="bx bx-show me-1"></i> Xem nội dung
                                            </a>
                                        {% endif %}
                                        {% if not item.responder %}
                                            <a class="dropdown-item" href="javascript:void(0);" 
                                               onclick="resolveReport('{{ item._id }}')">
                                                <i class="bx bx-check-circle me-1"></i> Đánh dấu đã xử lý
                                            </a>
                                        {% endif %}
                                        <div class="dropdown-divider"></div>
                                        <a class="dropdown-item text-danger" href="javascript:void(0);" 
                                           onclick="deleteReport('{{ item._id }}')">
                                            <i class="bx bx-trash me-1"></i> Xóa báo cáo
                                        </a>
                                    </div>
                                </div>
                            </td>
                        </tr>
                        {% set index = index + 1 %}
                    {% endfor %}
                {% else %}
                    <tr>
                        <td colspan="8" class="text-center text-muted py-4">
                            <i class="bx bx-info-circle me-2"></i>
                            Không có báo cáo nào được tìm thấy
                        </td>
                    </tr>
                {% endif %}
            </tbody>
        </table>
    </div>
    
    {% include '../../layouts/_pagination.njk' %}
    
    <!-- Report Detail Modal -->
    <div class="modal fade" id="reportDetailModal" tabindex="-1" aria-labelledby="reportDetailModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reportDetailModalLabel">Chi Tiết Báo Cáo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="reportDetailContent">
                        <!-- Report detail content will be loaded here -->
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Reported Post Modal -->
    <div class="modal fade" id="reportedPostModal" tabindex="-1" aria-labelledby="reportedPostModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="reportedPostModalLabel">Bài Viết Bị Báo Cáo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div id="reportedPostContent">
                        <!-- Reported post content will be loaded here -->
                    </div>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Status Update Confirmation Modal -->
    <div class="modal fade" id="statusUpdateModal" tabindex="-1" aria-labelledby="statusUpdateModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="statusUpdateModalLabel">Cập Nhật Trạng Thái</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p id="statusUpdateMessage">Bạn có chắc chắn muốn cập nhật trạng thái báo cáo này?</p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-primary" onclick="confirmStatusUpdate()">Xác nhận</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Delete Report Confirmation Modal -->
    <div class="modal fade" id="deleteReportModal" tabindex="-1" aria-labelledby="deleteReportModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="deleteReportModalLabel">Xác Nhận Xóa Báo Cáo</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <p>Bạn có chắc chắn muốn xóa báo cáo này không?</p>
                    <p class="text-danger"><strong>Hành động này không thể hoàn tác!</strong></p>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Hủy</button>
                    <button type="button" class="btn btn-danger" onclick="confirmDeleteReport()">Xóa Báo Cáo</button>
                </div>
            </div>
        </div>
    </div>
    
    <!-- Success/Error Notification Modal -->
    <div class="modal fade" id="notificationModal" tabindex="-1" aria-labelledby="notificationModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-sm">
            <div class="modal-content">
                <div class="modal-body text-center">
                    <div id="notificationContent">
                        <!-- Notification content will be loaded here -->
                    </div>
                </div>
            </div>
        </div>
    </div>    <script>
        let currentReportId = null;
        
        // View report detail
        function viewReportDetail(reportId) {
            currentReportId = reportId;
            // Load report detail via AJAX
            fetch(`{{ baseUrl }}/report-management/detail/${reportId}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('reportDetailContent').innerHTML = formatReportDetail(data.report);
                        new bootstrap.Modal(document.getElementById('reportDetailModal')).show();
                    } else {
                        showNotification('error', 'Có lỗi xảy ra khi tải chi tiết báo cáo');
                    }
                })
                .catch(error => {
                    showNotification('error', 'Có lỗi xảy ra khi tải chi tiết báo cáo');
                });
        }
        
        // View reported content
        function viewReportedContent(targetId, reportType) {
            // Load reported content via AJAX
            fetch(`{{ baseUrl }}/report-management/content/${targetId}?type=${reportType}`)
                .then(response => response.json())
                .then(data => {
                    if (data.success) {
                        document.getElementById('reportedPostContent').innerHTML = formatReportedContent(data.content, reportType);
                        new bootstrap.Modal(document.getElementById('reportedPostModal')).show();
                    } else {
                        showNotification('error', 'Có lỗi xảy ra khi tải nội dung bị báo cáo');
                    }
                })
                .catch(error => {
                    showNotification('error', 'Có lỗi xảy ra khi tải nội dung bị báo cáo');
                });
        }
        
        // Resolve report
        function resolveReport(reportId) {
            currentReportId = reportId;
            
            document.getElementById('statusUpdateMessage').textContent = 
                'Bạn có chắc chắn muốn đánh dấu báo cáo này là "đã xử lý"?';
            new bootstrap.Modal(document.getElementById('statusUpdateModal')).show();
        }
        
        function confirmStatusUpdate() {
            if (!currentReportId) return;
            
            fetch(`{{ baseUrl }}/report-management/resolve/${currentReportId}`, {
                method: 'PATCH',
                headers: {
                    'Content-Type': 'application/json',
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification('success', 'Đánh dấu báo cáo đã xử lý thành công');
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                } else {
                    showNotification('error', data.message || 'Có lỗi xảy ra khi cập nhật trạng thái');
                }
            })
            .catch(error => {
                showNotification('error', 'Có lỗi xảy ra khi cập nhật trạng thái');
            })
            .finally(() => {
                bootstrap.Modal.getInstance(document.getElementById('statusUpdateModal')).hide();
            });
        }
        
        // Delete report
        function deleteReport(reportId) {
            currentReportId = reportId;
            new bootstrap.Modal(document.getElementById('deleteReportModal')).show();
        }
        
        function confirmDeleteReport() {
            if (!currentReportId) return;
            
            fetch(`{{ baseUrl }}/report-management/delete/${currentReportId}`, {
                method: 'DELETE',
                headers: {
                    'Content-Type': 'application/json',
                }
            })
            .then(response => response.json())
            .then(data => {
                if (data.success) {
                    showNotification('success', 'Xóa báo cáo thành công');
                    setTimeout(() => {
                        window.location.reload();
                    }, 1500);
                } else {
                    showNotification('error', data.message || 'Có lỗi xảy ra khi xóa báo cáo');
                }
            })
            .catch(error => {
                showNotification('error', 'Có lỗi xảy ra khi xóa báo cáo');
            })
            .finally(() => {
                bootstrap.Modal.getInstance(document.getElementById('deleteReportModal')).hide();
            });
        }
        
        // Format report detail
        function formatReportDetail(report) {
            const typeText = {
                'SPAM': 'Spam',
                'HARASSMENT': 'Quấy rối',
                'INAPPROPRIATE_CONTENT': 'Nội dung không phù hợp',
                'VIOLENCE': 'Bạo lực',
                'HATE_SPEECH': 'Phát ngôn thù địch',
                'MISINFORMATION': 'Thông tin sai lệch',
                'OTHER': 'Khác'
            };
            
            const reporterName = report.reporter?.name || 'Không xác định';
            const reporterUsername = report.reporter?.username || 'unknown';
            const responderName = report.responder?.name || null;
            
            return `
                <div class="card">
                    <div class="card-body">
                        <div class="row">
                            <div class="col-md-6">
                                <h6>Thông tin người báo cáo:</h6>
                                <div class="d-flex align-items-center mb-3">
                                    ${report.reporter?.avatar ? 
                                        `<img src="${report.reporter.avatar}" class="rounded-circle me-3" width="50" height="50" alt="Avatar">` :
                                        `<div class="rounded-circle bg-secondary me-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px; color: white;">
                                            ${reporterName.charAt(0).toUpperCase()}
                                        </div>`
                                    }
                                    <div>
                                        <strong>${reporterName}</strong><br>
                                        <small class="text-muted">@${reporterUsername}</small>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <h6>Thông tin báo cáo:</h6>
                                <p><strong>Loại:</strong> ${typeText[report.type] || report.type}</p>                                <p><strong>Trạng thái:</strong> 
                                    <span class="badge ${report.responder ? 'bg-label-success' : 'bg-label-warning'} me-1">
                                        ${report.responder ? 'Đã xử lý' : 'Chờ xử lý'}
                                    </span>
                                </p>
                                <p><strong>Ngày báo cáo:</strong> ${new Date(report.createdAt).toLocaleString('vi-VN')}</p>
                                ${responderName ? `<p><strong>Người xử lý:</strong> ${responderName}</p>` : ''}
                            </div>
                        </div>
                        <hr>
                        <h6>Lý do báo cáo:</h6>
                        <p class="mb-3">${report.reason}</p>
                        ${report.responseContent ? `
                            <hr>
                            <h6>Phản hồi xử lý:</h6>
                            <p class="mb-3">${report.responseContent}</p>
                        ` : ''}
                        <hr>
                        <h6>ID đối tượng bị báo cáo:</h6>
                        <p><code>${report.target}</code></p>
                    </div>
                </div>
            `;
        }
        
        // Format reported content
        function formatReportedContent(content, type) {
            return `
                <div class="card">
                    <div class="card-body">
                        <h6>Loại nội dung: ${type}</h6>
                        <hr>
                        <div class="alert alert-info">
                            <strong>ID:</strong> ${content._id || 'Không xác định'}<br>
                            <strong>Nội dung:</strong> ${content.content || content.text || 'Không có nội dung'}
                        </div>
                        ${content.author ? `
                            <div class="mb-3">
                                <h6>Tác giả:</h6>
                                <div class="d-flex align-items-center">
                                    ${content.author.avatar ? 
                                        `<img src="${content.author.avatar}" class="rounded-circle me-3" width="40" height="40" alt="Avatar">` :
                                        `<div class="rounded-circle bg-secondary me-3 d-flex align-items-center justify-content-center" style="width: 40px; height: 40px; color: white;">
                                            ${(content.author.name || '?').charAt(0).toUpperCase()}
                                        </div>`
                                    }
                                    <div>
                                        <strong>${content.author.name || 'Không xác định'}</strong><br>
                                        <small class="text-muted">@${content.author.username || 'unknown'}</small>
                                    </div>
                                </div>
                            </div>
                        ` : ''}
                        ${content.createdAt ? `
                            <p><strong>Ngày tạo:</strong> ${new Date(content.createdAt).toLocaleString('vi-VN')}</p>
                        ` : ''}
                    </div>
                </div>
            `;
        }
        
        // Show notification
        function showNotification(type, message) {
            const iconClass = type === 'success' ? 'bx-check-circle text-success' : 'bx-error-circle text-danger';
            const content = `
                <div class="mb-3">
                    <i class="bx ${iconClass}" style="font-size: 3rem;"></i>
                </div>
                <p class="mb-0">${message}</p>
            `;
            
            document.getElementById('notificationContent').innerHTML = content;
            const modal = new bootstrap.Modal(document.getElementById('notificationModal'));
            modal.show();
            
            // Auto hide after 3 seconds
            setTimeout(() => {
                modal.hide();
            }, 3000);
        }
        
        // Initialize tooltips
        document.addEventListener('DOMContentLoaded', function() {
            var tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
            var tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                return new bootstrap.Tooltip(tooltipTriggerEl);
            });
        });
    </script>
{% endblock %}