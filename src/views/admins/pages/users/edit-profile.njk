{% extends 'admins/layouts/app.njk' %}More actions {% set title = 'Thông tin cá nhân' %}
{% set auth = false %}
{% block css %}
    <style>
        /* Đảm bảo toàn bộ trang chiếm ít nhất 100% chiều cao của viewport */
        html,
        body {
            height: 100%;
            margin: 0;
        }
        /* Facebook-like Profile Header Styles */
        .profile-cover {
            position: relative;
            background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            border-radius: 16px 16px 0 0;
            overflow: visible;
            margin: -24px -24px 0;
            z-index: 10;
        }
        .cover-image {
            width: 100%;
            height: 250px;
            object-fit: cover;
            cursor: pointer;
            transition: all 0.3s ease;
        }
        .cover-image:hover {
            transform: scale(1.02);
            filter: brightness(0.9);
        }
        .cover-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.4);
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
            cursor: pointer;
        }
        .cover-image:hover + .cover-overlay,
        .cover-overlay:hover {
            opacity: 1;
        }
        .profile-avatar {
            position: absolute;
            bottom: -60px;
            left: 40px;
            width: 140px;
            height: 140px;
            border: 5px solid white;
            border-radius: 50%;
            background: white;
            cursor: pointer;
            transition: all 0.3s ease;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
            z-index: 15;
        }
        .profile-avatar:hover {
            transform: scale(1.05);
            box-shadow: 0 6px 25px rgba(0, 0, 0, 0.2);
        }
        .avatar-image {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 50%;
        }
        .avatar-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            transition: opacity 0.3s ease;
            z-index: 20;
        }
        .profile-avatar:hover .avatar-overlay {
            opacity: 1;
        }
        .profile-info {
            padding: 80px 40px 30px;
            background: white;
            border-radius: 0 0 16px 16px;
            margin: 0 -24px;
            position: relative;
            z-index: 5;
        }
        .profile-name {
            font-size: 2rem;
            font-weight: 700;
            color: #2c3e50;
            margin-bottom: 5px;
        }
        .profile-username {
            font-size: 1.1rem;
            color: #7f8c8d;
            margin-bottom: 15px;
        }
        .profile-stats {
            display: flex;
            gap: 30px;
            margin-top: 20px;
        }
        .stat-item {
            text-align: center;
        }
        .stat-number {
            font-size: 1.5rem;
            font-weight: 600;
            color: #2c3e50;
            display: block;
        }
        .stat-label {
            font-size: 0.9rem;
            color: #7f8c8d;
            text-transform: uppercase;
            letter-spacing: 0.5px;
        }
        .form-section {
            background: white;
            border-radius: 16px;
            padding: 30px;
            margin-top: 30px;
            box-shadow: 0 2px 20px rgba(0, 0, 0, 0.08);
            border: 1px solid #f0f0f0;
        }
        .section-title {
            font-size: 1.4rem;
            font-weight: 600;
            color: #2c3e50;
            margin-bottom: 25px;
            padding-bottom: 15px;
            border-bottom: 2px solid #e9ecef;
        }
        .form-label {
            font-weight: 500;
            color: #495057;
            margin-bottom: 8px;
        }
        .form-control {
            border: 2px solid #e9ecef;
            border-radius: 10px;
            padding: 12px 16px;
            font-size: 0.95rem;
            transition: all 0.3s ease;
        }
        .form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.15);
        }
        .btn {
            border-radius: 10px;
            padding: 12px 30px;
            font-weight: 500;
            transition: all 0.3s ease;
        }
        .btn-primary {
            border: none;
        }
        .btn-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(102, 126, 234, 0.3);
        }
        .upload-hint {
            font-size: 0.85rem;
            color: #6c757d;
            margin-top: 8px;
        }
        /* Animation cho upload */
        .uploading {
            opacity: 0.7;
            transform: scale(0.98);
            position: relative;
        }
        .uploading::after {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.3);
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
        }
        .uploading::before {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 20px;
            height: 20px;
            border: 2px solid #fff;
            border-top: 2px solid transparent;
            border-radius: 50%;
            transform: translate(-50%, -50%);
            animation: spin 1s linear infinite;
            z-index: 10;
        }
        /* Enhanced Loading Animations */
        .loading-spinner {
            width: 20px;
            height: 20px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-radius: 50%;
            border-top-color: #fff;
            animation: spin 1s ease-in-out infinite;
        }
        .loading-overlay {
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            border-radius: inherit;
            z-index: 30;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .loading-overlay.show {
            opacity: 1;
        }
        .loading-text {
            color: white;
            font-size: 0.875rem;
            margin-top: 8px;
            font-weight: 500;
        }
        .upload-progress {
            position: absolute;
            bottom: 10px;
            left: 10px;
            right: 10px;
            background: rgba(0, 0, 0, 0.8);
            border-radius: 4px;
            padding: 5px;
            color: white;
            font-size: 0.75rem;
            text-align: center;
            opacity: 0;
            transition: opacity 0.3s ease;
        }
        .upload-progress.show {
            opacity: 1;
        }
        .success-animation {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            width: 40px;
            height: 40px;
            background: #28a745;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            opacity: 0;
            scale: 0;
            transition: all 0.3s ease;
            z-index: 35;
        }
        .success-animation.show {
            opacity: 1;
            scale: 1;
        }
        .success-animation i {
            color: white;
            font-size: 18px;
        }
        /* Pulse effect for updating elements */
        .pulse-update {
            animation: pulse-glow 2s infinite;
        }
        @keyframes pulse-glow {
            0,
            100% {
                box-shadow: 0 0 5px rgba(102, 126, 234, 0.3);
            }
            50% {
                box-shadow: 0 0 20px rgba(102, 126, 234, 0.6);
            }
        }
        /* Enhanced button loading state */
        .btn-loading {
            position: relative;
            pointer-events: none;
        }
        .btn-loading::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 16px;
            height: 16px;
            margin: -8px 0 0 -8px;
            border: 2px solid transparent;
            border-top: 2px solid currentColor;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        @keyframes spin {
            0% {
                transform: rotate(0deg);
            }
            100% {
                transform: rotate(360deg);
            }
        }
        @keyframes slideInRight {
            from {
                transform: translateX(100%);
                opacity: 0;
            }
            to {
                transform: translateX(0);
                opacity: 1;
            }
        }
        @keyframes fadeInScale {
            from {
                opacity: 0;
                transform: scale(0.8);
            }
            to {
                opacity: 1;
                transform: scale(1);
            }
        }
        /* Enhanced form submit button loading */
        .form-submit-loading {
            position: relative;
            color: transparent !important;
        }
        .form-submit-loading::after {
            content: '';
            position: absolute;
            top: 50%;
            left: 50%;
            width: 20px;
            height: 20px;
            margin: -10px 0 0 -10px;
            border: 2px solid rgba(255, 255, 255, 0.3);
            border-top: 2px solid #fff;
            border-radius: 50%;
            animation: spin 1s linear infinite;
        }
        /* Smooth transitions for image updates */
        .avatar-image,
        .cover-image {
            transition: opacity 0.3s ease, transform 0.3s ease;
        }
        .image-updating {
            opacity: 0.6;
            transform: scale(0.95);
        }
        /* Responsive */
        @media(max-width: 768px) {
            .profile-cover {
                margin: -16px -16px 0;
            }
            .cover-image {
                height: 180px;
            }
            .profile-avatar {
                width: 100px;
                height: 100px;
                bottom: -50px;
                left: 20px;
            }
            .profile-info {
                padding: 60px 20px 20px;
                margin: 0 -16px;
            }
            .profile-name {
                font-size: 1.5rem;
            }
            .profile-stats {
                gap: 20px;
            }
            .form-section {
                padding: 20px;
                margin-top: 20px;
            }
        }
    </style>
{% endblock %}
{% block content %}
    <div class="content-wrapper">
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="row">
                <div
                    class="col-md-12">
                    <!-- Navigation Tabs -->
                    <div class="nav-align-top mb-4">
                        <ul class="nav nav-pills flex-column flex-md-row">
                            <li class="nav-item">
                                <a class="nav-link active" href="javascript:void(0);">
                                    <i class="bx bx-user me-2"></i>
                                    Tài khoản
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="javascript:void(0);" onclick="openFormChangeMail()">
                                    <i class="bx bx-envelope me-2"></i>
                                    Đổi email
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="javascript:void(0);" onclick="openFormChangePass()">
                                    <i class="bx bx-lock me-2"></i>
                                    Đổi mật khẩu
                                </a>
                            </li>
                        </ul>
                    </div>
                    <!-- Profile Header Card -->
                    <div
                        class="card mb-4"
                        style="border-radius: 16px; overflow: hidden; border: none; box-shadow: 0 4px 25px rgba(0, 0, 0, 0.1);">
                        <div class="profile-cover">
                            {% if user.background %}
                                <img id="backgroundDisplay" src="{{ user.background }}" alt="Cover" class="cover-image" onclick="document.getElementById('backgroundUpload').click()"/>
                            {% else %}
                                <div
                                    class="cover-image"
                                    style="background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);"
                                    onclick="document.getElementById('backgroundUpload').click()"></div>
                            {% endif %}
                            <div class="cover-overlay" onclick="document.getElementById('backgroundUpload').click()">
                                <div class="text-white text-center">
                                    <i class="bx bx-camera" style="font-size: 2.5rem;"></i>
                                    <div class="mt-2 fw-bold">Đổi ảnh bìa</div>
                                </div>
                            </div>
                            <div class="profile-avatar" onclick="document.getElementById('avatarUpload').click()">
                                {% if user.avatar %}
                                    <img id="avatarDisplay" src="{{ user.avatar }}" alt="Avatar" class="avatar-image"/>
                                {% else %}
                                    <img id="avatarDisplay" src="/images/kairo.jpg" alt="Avatar" class="avatar-image"/>
                                {% endif %}
                                <div class="avatar-overlay">
                                    <i class="bx bx-camera text-white" style="font-size: 1.8rem;"></i>
                                </div>
                            </div>
                        </div>
                        <div class="profile-info">
                            <h2 class="profile-name">{{ user.name }}</h2>
                            <p class="profile-username">{{ user.username }}</p>
                        </div>
                    </div>
                    <!-- Form Section -->
                    <div class="form-section">
                        <h3 class="section-title">
                            <i class="bx bx-edit me-2"></i>
                            Chỉnh sửa thông tin
                        </h3>
                        <!-- Hidden file inputs -->
                        <input type="file" id="avatarUpload" accept="image/*" style="display: none;" onchange="handleAvatarUpload(event)"/>
                        <input
                            type="file"
                            id="backgroundUpload"
                            accept="image/*"
                            style="display: none;"
                            onchange="handleBackgroundUpload(event)"/>
                        <form id="formAccountSettings" method="POST" action="{{ baseUrl }}/profile/update">
                            <div
                                class="row g-4">
                                <!-- Hidden fields -->
                                <input type="hidden" id="avatar" name="avatar" value="{{ user.avatar }}"/>
                                <input type="hidden" id="background" name="background" value="{{ user.background }}"/>
                                <div class="col-md-6">
                                    <label for="firstName" class="form-label">
                                        <i class="bx bx-user me-1"></i>
                                        Họ và Tên
                                    </label>
                                    <input class="form-control" type="text" id="firstName" name="name" value="{{ user.name }}" autofocus/>
                                </div>
                                <div class="col-md-6">
                                    <label for="username" class="form-label">
                                        <i class="bx bx-at me-1"></i>
                                        Tên người dùng
                                    </label>
                                    <input class="form-control" type="text" id="username" name="username" value="{{ user.username }}"/>
                                </div>
                                <div class="col-md-6">
                                    <label for="email" class="form-label">
                                        <i class="bx bx-envelope me-1"></i>
                                        E-mail
                                    </label>
                                    <input class="form-control" type="email" id="email" disabled value="{{ user.email }}" placeholder="john.doe@example.com"/>
                                    <div class="upload-hint">Email chỉ có thể thay đổi thông qua chức năng "Đổi email"</div>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="phoneNumber">
                                        <i class="bx bx-phone me-1"></i>
                                        Số Điện Thoại
                                    </label>
                                    <input type="text" id="phoneNumber" name="phone" class="form-control" placeholder="0123 456 789" value="{{ user.phone }}"/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="gender">
                                        <i class="bx bx-male-female me-1"></i>
                                        Giới tính
                                    </label>
                                    <select class="form-control" id="gender" name="gender">
                                        <option value="MALE" {% if user.gender == 'MALE' %} selected {% endif %}>Nam</option>
                                        <option value="FEMALE" {% if user.gender == 'FEMALE' %} selected {% endif %}>Nữ</option>
                                        <option value="OTHER" {% if user.gender == 'OTHER' %} selected {% endif %}>Khác</option>
                                    </select>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="birthday">
                                        <i class="bx bx-calendar me-1"></i>
                                        Ngày sinh
                                    </label>
                                    <input type="date" id="birthday" name="birthday" class="form-control" value="{% if user.birthday %}{{ user.birthday | formatDate('YYYY-MM-DD') }}{% endif %}"/>
                                </div>
                                <div class="col-12">
                                    <label class="form-label" for="bio">
                                        <i class="bx bx-edit-alt me-1"></i>
                                        Tiểu sử
                                    </label>
                                    <textarea id="bio" name="bio" class="form-control" rows="4" placeholder="Viết gì đó về bản thân...">{{ user.bio }}</textarea>
                                    <div class="upload-hint">Tối đa 500 ký tự</div>
                                </div>
                                <!-- Read-only fields -->
                                <div class="col-md-6">
                                    <label class="form-label" for="role">
                                        <i class="bx bx-shield me-1"></i>
                                        Quyền Hạn
                                    </label>
                                    <input type="text" id="role" class="form-control" value="{% if user.role == 'ADMIN' %}Quản trị viên{% elif user.role == 'MOD' %}Điều hành viên{% else %}Người dùng{% endif %}" disabled/>
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label" for="createdAt">
                                        <i class="bx bx-calendar-plus me-1"></i>
                                        Ngày tạo tài khoản
                                    </label>
                                    <input type="text" id="createdAt" class="form-control" value="{{ user.createdAt | formatDate('DD/MM/YYYY HH:mm:ss') }}" disabled/>
                                </div>
                                {% if user.bannedUntil %}
                                    <div class="col-md-6">
                                        <label class="form-label" for="bannedUntil">
                                            <i class="bx bx-block me-1"></i>
                                            Bị cấm đến
                                        </label>
                                        <input type="text" id="bannedUntil" class="form-control" value="{{ user.bannedUntil | formatDate('DD/MM/YYYY HH:mm:ss') }}" disabled/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="bannedReason">
                                            <i class="bx bx-message-alt-detail me-1"></i>
                                            Lý do bị cấm
                                        </label>
                                        <input type="text" id="bannedReason" class="form-control" value="{{ user.bannedReason }}" disabled/>
                                    </div>
                                {% endif %}
                                <div class="col-12 mt-4">
                                    <button type="submit" class="btn btn-primary me-3 data-submit">
                                        <i class="bx bx-save me-2"></i>
                                        Lưu Thay Đổi
                                    </button>
                                    <button type="reset" class="btn btn-outline-secondary">
                                        <i class="bx bx-reset me-2"></i>
                                        Đặt lại
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal Popup Đổi Mật Khẩu -->
    <div class="modal fade" id="changePassModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="border-radius: 16px; border: none;">
                <div class="modal-header" style="border-bottom: 2px solid #e9ecef;">
                    <h5 class="modal-title fw-bold">
                        <i class="bx bx-lock me-2"></i>
                        Đổi mật khẩu
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="formChangePass" method="POST" action="{{ baseUrl }}/users/edit-profile">
                        <div class="mb-3">
                            <label for="currentPassword" class="form-label">Mật khẩu hiện tại</label>
                            <input type="password" class="form-control" id="currentPassword" name="currentPassword" required/>
                        </div>
                        <div class="mb-3">
                            <label for="newPassword" class="form-label">Mật khẩu mới</label>
                            <input type="password" class="form-control" id="newPassword" name="newPassword" required/>
                        </div>
                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required/>
                        </div>
                        <input type="hidden" name="type" value="CHANGE_PASS"/>
                    </form>
                </div>
                <div class="modal-footer" style="border-top: 2px solid #e9ecef;">
                    <button type="submit" form="formChangePass" class="btn btn-primary me-2">
                        <i class="bx bx-save me-2"></i>
                        Lưu thay đổi
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bx bx-x me-2"></i>
                        Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal Popup Đổi Email -->
    <div class="modal fade" id="changeMailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content" style="border-radius: 16px; border: none;">
                <div class="modal-header" style="border-bottom: 2px solid #e9ecef;">
                    <h5 class="modal-title fw-bold">
                        <i class="bx bx-envelope me-2"></i>
                        Đổi email
                    </h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <form id="formChangeMail" method="POST" action="{{ baseUrl }}/profile/change-mail">
                        <div id="message-alert-email"></div>
                        <div class="mb-3">
                            <label class="form-label" for="email-pre">Nhập email mới</label>
                            <div class="input-group">
                                <input type="email" id="email-pre" class="form-control" name="email" placeholder="example@email.com" required/>
                                <button class="btn btn-outline-primary" type="button" id="sendOtpBtn" onclick="sendCode(this)">
                                    <i class="bx bx-send me-1"></i>
                                    Nhận mã OTP
                                </button>
                            </div>
                            <div id="email-feedback" class="mt-2 text-danger small" style="display: none;"></div>
                            <div id="countdown-display" class="mt-2 text-muted small" style="display: none;">
                                Gửi lại OTP sau:
                                <span id="countdown-timer">60</span>
                                giây
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="otp-input" class="form-label">Mã OTP</label>
                            <input type="text" class="form-control" id="otp-input" name="otp" placeholder="Nhập mã 6 số" required/>
                        </div>
                        <div class="mb-3">
                            <div class="cf-turnstile" data-sitekey="{{ capchaPublicKey }}" data-theme="light"></div>
                        </div>
                        <input type="hidden" name="type" value="CHANGE_EMAIL"/>
                    </form>
                </div>
                <div class="modal-footer" style="border-top: 2px solid #e9ecef;">
                    <button type="submit" form="formChangeMail" class="btn btn-primary me-2">
                        <i class="bx bx-save me-2"></i>
                        Lưu thay đổi
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">
                        <i class="bx bx-x me-2"></i>
                        Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script>
        function openFormChangePass() {
            var changePassModal = new bootstrap.Modal(document.getElementById('changePassModal'));
            changePassModal.show();
        }
        function openFormChangeMail() {
            var changeMailModal = new bootstrap.Modal(document.getElementById('changeMailModal'));
            changeMailModal.show();
        }
        async function sendCode(button) {
            const emailInput = document.getElementById('email-pre');
            const email = emailInput.value.trim();
            const emailFeedback = document.getElementById('email-feedback');
            const countdownDisplay = document.getElementById('countdown-display');
            const countdownTimer = document.getElementById('countdown-timer');
            // Validate email
            if (! email) {
                emailFeedback.textContent = 'Vui lòng nhập email mới';
                emailFeedback.style.display = 'block';
                emailFeedback.className = 'mt-2 text-danger small';
                return;
            }
            // Check if email is valid format
            const emailRegex = /^[^\s@]+@[^\s@]+\.[^\s@]+$/;
            if (! emailRegex.test(email)) {
                emailFeedback.textContent = 'Email không hợp lệ';
                emailFeedback.style.display = 'block';
                emailFeedback.className = 'mt-2 text-danger small';
                return;
            }
            // Get captcha token
            const captchaToken = document.querySelector('.cf-turnstile [name="cf-turnstile-response"]') ?. value;
            if (! captchaToken) {
                emailFeedback.textContent = 'Vui lòng xác thực Captcha';
                emailFeedback.style.display = 'block';
                emailFeedback.className = 'mt-2 text-danger small';
                return;
            }
            button.disabled = true;
            button.innerHTML = '<i class="bx bx-loader-alt bx-spin me-1"></i> Đang gửi...';
            emailFeedback.style.display = 'none';
            const requestData = {
                email: email,
                'cf-turnstile-response': captchaToken,
                type: 'CHANGE_MAIL'
            };
            try {
                const response = await fetch('{{ baseUrl }}/auth/verify-email', {
                    method: 'POST',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(requestData)
                });
                const data = await response.json();
                if (data.success) {
                    emailFeedback.textContent = 'Mã OTP đã được gửi đến email của bạn';
                    emailFeedback.style.display = 'block';
                    emailFeedback.className = 'mt-2 text-success small';
                    startCountdown(button);
                } else {
                    emailFeedback.textContent = data.message || 'Gửi OTP thất bại';
                    emailFeedback.style.display = 'block';
                    emailFeedback.className = 'mt-2 text-danger small';
                    button.disabled = false;
                    button.innerHTML = '<i class="bx bx-send me-1"></i> Nhận mã OTP';
                }
            } catch (error) {
                console.error('Error:', error);
                emailFeedback.textContent = 'Lỗi khi gửi OTP. Vui lòng thử lại!';
                emailFeedback.style.display = 'block';
                emailFeedback.className = 'mt-2 text-danger small';
                button.disabled = false;
                button.innerHTML = '<i class="bx bx-send me-1"></i> Nhận mã OTP';
            }
        }
        function startCountdown(button) {
            const countdownDisplay = document.getElementById('countdown-display');
            const countdownTimer = document.getElementById('countdown-timer');
            let countdown = 60;
            countdownTimer.textContent = countdown;
            countdownDisplay.style.display = 'block';
            const interval = setInterval(() => {
                countdown--;
                countdownTimer.textContent = countdown;
                if (countdown <= 0) {
                    clearInterval(interval);
                    button.disabled = false;
                    button.innerHTML = '<i class="bx bx-send me-1"></i> Nhận mã OTP';
                    countdownDisplay.style.display = 'none';
                }
            }, 1000);
        }
        async function uploadFile(file, progressCallback) {
            const formData = new FormData();
            formData.append('file', file);
            try { // Create XMLHttpRequest for upload progress tracking
                return new Promise((resolve, reject) => {
                    const xhr = new XMLHttpRequest();
                    xhr.upload.addEventListener('progress', (event) => {
                        if (event.lengthComputable && progressCallback) {
                            const percentComplete = Math.round((event.loaded / event.total) * 100);
                            progressCallback(percentComplete);
                        }
                    });
                    xhr.addEventListener('load', () => {
                        if (xhr.status >= 200 && xhr.status < 300) {
                            const data = JSON.parse(xhr.responseText);
                            resolve(data.data.url);
                        } else {
                            reject(new Error('Upload failed'));
                        }
                    });
                    xhr.addEventListener('error', () => {
                        reject(new Error('Network error during upload'));
                    });
                    xhr.open('POST', '/storage/upload');
                    xhr.send(formData);
                });
            } catch (error) {
                console.error('Error uploading file:', error);
                showToast({message: "Lỗi khi tải lên tệp.", type: "error"});
                throw error;
            }
        }
        async function autoSaveProfile(updateData) {
            try { // Show updating progress
                const updateIndicator = createUpdateIndicator();
                document.body.appendChild(updateIndicator);
                // Get current form data
                const formData = new FormData(document.getElementById('formAccountSettings'));
                const data = {};
                // Convert FormData to regular object
                for (let [key, value] of formData.entries()) {
                    data[key] = value;
                }
                // Merge with update data (avatar or background)
                Object.assign(data, updateData);
                const response = await fetch('{{ baseUrl }}/profile/update', {
                    method: 'PATCH',
                    headers: {
                        'Content-Type': 'application/json'
                    },
                    body: JSON.stringify(data)
                });
                const result = await response.json();
                if (! response.ok) {
                    throw new Error(result.message || "Có lỗi xảy ra khi cập nhật!");
                }
                // Show success animation
                updateIndicator.innerHTML = `
                    <div class="success-animation show">
                        <i class="bx bx-check"></i>
                    </div>
                `;
                setTimeout(() => {
                    document.body.removeChild(updateIndicator);
                }, 1500);
                return result;
            } catch (error) {
                console.error('Error auto-saving profile:', error);
                showToast({
                    message: "Lỗi khi tự động lưu: " + error.message,
                    type: "error"
                });
                // Remove update indicator on error
                const indicator = document.querySelector('.update-indicator');
                if (indicator) {
                    document.body.removeChild(indicator);
                }
                throw error;
            }
        }
        function createUpdateIndicator() {
            const indicator = document.createElement('div');
            indicator.className = 'update-indicator';
            indicator.style.cssText = `
                position: fixed;
                top: 20px;
                right: 20px;
                background: rgba(102, 126, 234, 0.95);
                color: white;
                padding: 12px 20px;
                border-radius: 8px;
                box-shadow: 0 4px 20px rgba(0, 0, 0, 0.15);
                z-index: 1000;
                display: flex;
                align-items: center;
                gap: 10px;
                font-weight: 500;
                animation: slideInRight 0.3s ease;
            `;
            indicator.innerHTML = `
                <div class="loading-spinner"></div>
                <span>Đang cập nhật hồ sơ...</span>
            `;
            return indicator;
        }
        async function handleAvatarUpload(event) {
            const file = event.target.files[0];
            if (! file) 
                return;
            
            // Validate file type
            if (! file.type.startsWith('image/')) {
                showToast({message: "Chỉ được chọn tệp hình ảnh!", type: "error"});
                return;
            }
            // Validate file size (5MB limit)
            if (file.size > 5 * 1024 * 1024) {
                showToast({message: "Kích thước tệp không được vượt quá 5MB!", type: "error"});
                return;
            }
            const avatarImg = document.getElementById('avatarDisplay');
            const avatarContainer = document.querySelector('.profile-avatar');
            // Create loading overlay
            const loadingOverlay = document.createElement('div');
            loadingOverlay.className = 'loading-overlay';
            loadingOverlay.innerHTML = `
                <div class="loading-spinner"></div>
                <div class="loading-text">Đang tải lên... 0%</div>
            `;
            avatarContainer.appendChild(loadingOverlay);
            // Show loading overlay
            setTimeout(() => loadingOverlay.classList.add('show'), 10);
            try { // Add uploading class for visual feedback
                avatarImg.classList.add('uploading');
                avatarContainer.classList.add('pulse-update');
                const uploadedUrl = await uploadFile(file, (progress) => {
                    const loadingText = loadingOverlay.querySelector('.loading-text');
                    loadingText.textContent = `Đang tải lên... ${progress}%`;
                });
                if (uploadedUrl) { // Update loading text
                    loadingOverlay.querySelector('.loading-text').textContent = 'Đang cập nhật hồ sơ...';
                    // Update the hidden input field
                    document.getElementById('avatar').value = uploadedUrl;
                    // Update display image with smooth transition
                    avatarImg.style.opacity = '0';
                    setTimeout(() => {
                        avatarImg.src = uploadedUrl;
                        avatarImg.style.opacity = '1';
                    }, 300);
                    // Auto-save avatar to profile
                    await autoSaveProfile({avatar: uploadedUrl});
                    // Show success state
                    loadingOverlay.innerHTML = `
                        <div class="success-animation show">
                            <i class="bx bx-check"></i>
                        </div>
                        <div class="loading-text">Cập nhật thành công!</div>
                    `;
                    setTimeout(() => {
                        loadingOverlay.classList.remove('show');
                        setTimeout(() => {
                            if (loadingOverlay.parentNode) {
                                loadingOverlay.parentNode.removeChild(loadingOverlay);
                            }
                        }, 300);
                    }, 1500);
                    showToast({message: "Cập nhật ảnh đại diện thành công!", type: "success"});
                }
            } catch (error) { // Show error state
                loadingOverlay.innerHTML = `
                    <div style="color: #dc3545; text-align: center;">
                        <i class="bx bx-error-circle" style="font-size: 24px;"></i>
                        <div class="loading-text" style="color: #dc3545;">Tải lên thất bại!</div>
                    </div>
                `;
                setTimeout(() => {
                    loadingOverlay.classList.remove('show');
                    setTimeout(() => {
                        if (loadingOverlay.parentNode) {
                            loadingOverlay.parentNode.removeChild(loadingOverlay);
                        }
                    }, 300);
                }, 2000);
                showToast({
                    message: "Lỗi khi tải lên ảnh đại diện: " + error.message,
                    type: "error"
                });
            } finally { // Clean up classes
                avatarImg.classList.remove('uploading');
                avatarContainer.classList.remove('pulse-update');
            }
        }
