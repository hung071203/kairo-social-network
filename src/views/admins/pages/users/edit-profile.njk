{% extends 'admins/layouts/app.njk' %}
{% set title = 'Thông tin cá nhân' %}
{% set auth = false %}
{% block css %}
    <style>
        /* Đảm bảo toàn bộ trang chiếm ít nhất 100% chiều cao của viewport */
        html,
        body {
            height: 100%;
            margin: 0;
        }
    </style>
{% endblock %}
{% block content %}
    <div class="content-wrapper">
        <style>
            .form-control:disabled {
                color: #384551 !important;
            }
        </style>
        <div class="container-xxl flex-grow-1 container-p-y">
            <div class="row">
                <div class="col-md-12">
                    <div class="nav-align-top">
                        <ul class="nav nav-pills flex-column flex-md-row mb-6">
                            <li class="nav-item">
                                <a class="nav-link active" href="javascript:void(0);">
                                    <i class="bx bx-sm bx-user me-1_5"></i>
                                    Tài khoản
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="javascript:void(0);" onclick="openFormChangeMail()">
                                    <i class="bx bx-sm bx-envelope me-1_5"></i>
                                    Đổi email
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="javascript:void(0);" onclick="openFormChangePass()">
                                    <i class="bx bx-sm bx-lock me-1_5"></i>
                                    Đổi mật khẩu
                                </a>
                            </li>
                        </ul>
                    </div>
                    <div
                        class="card mb-6">
                        <!-- Tài khoản -->
                        <div
                            class="card-body"><!-- Nội dung của bạn ở đây -->
                        </div>                        <div class="card-body pt-4">
                            <form id="formAccountSettings" method="PATCH" action="{{ baseUrl }}/profile/update">
                                <div class="row g-6">
                                    <div class="col-md-6">
                                        <label for="firstName" class="form-label">Họ và Tên</label>
                                        <input class="form-control" type="text" id="firstName" name="name" value="{{ user.name }}" autofocus/>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="username" class="form-label">Tên người dùng</label>
                                        <input class="form-control" type="text" id="username" name="username" value="{{ user.username }}"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label for="email" class="form-label">E-mail</label>
                                        <input class="form-control" type="email" id="email" disabled value="{{ user.email }}" placeholder="john.doe@example.com"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="phoneNumber">Số Điện Thoại</label>
                                        <div class="input-group input-group-merge">
                                            <input type="text" id="phoneNumber" name="phone" class="form-control" placeholder="202 555 0111" value="{{ user.phone }}"/>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="role">Quyền Hạn</label>
                                        <div class="input-group input-group-merge">
                                            <input type="text" id="role" class="form-control" placeholder="" value="{% if user.role == 'ADMIN' %}Quản trị viên{% elif user.role == 'MOD' %}Điều hành viên{% else %}Người dùng{% endif %}" disabled/>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="gender">Giới tính</label>
                                        <select class="form-control" id="gender" name="gender">
                                            <option value="MALE" {% if user.gender == 'MALE' %}selected{% endif %}>Nam</option>
                                            <option value="FEMALE" {% if user.gender == 'FEMALE' %}selected{% endif %}>Nữ</option>
                                            <option value="OTHER" {% if user.gender == 'OTHER' %}selected{% endif %}>Khác</option>
                                        </select>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="birthday">Ngày sinh</label>
                                        <input type="date" id="birthday" name="birthday" class="form-control" value="{% if user.birthday %}{{ user.birthday | formatDate('YYYY/MM/DD') }}{% endif %}"/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="avatar">Ảnh đại diện</label>
                                        <div class="input-group">
                                            <input type="text" id="avatar" name="avatar" class="form-control" value="{{ user.avatar }}" readonly/>
                                            {% if user.avatar %}
                                            <img src="{{ user.avatar }}" alt="Avatar" style="width: 40px; height: 40px; object-fit: cover; border-radius: 50%; margin-left: 10px;"/>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="col-md-12">
                                        <label class="form-label" for="bio">Tiểu sử</label>
                                        <textarea id="bio" name="bio" class="form-control" rows="3" placeholder="Viết gì đó về bản thân...">{{ user.bio }}</textarea>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="createdAt">Ngày tạo tài khoản</label>
                                        <input type="text" id="createdAt" class="form-control" value="{{ user.createdAt | formatDate('DD/MM/YYYY HH:mm:ss') }}" disabled/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="updatedAt">Cập nhật lần cuối</label>
                                        <input type="text" id="updatedAt" class="form-control" value="{{ user.updatedAt | formatDate('DD/MM/YYYY HH:mm:ss') }}" disabled/>
                                    </div>
                                    {% if user.bannedUntil %}
                                    <div class="col-md-6">
                                        <label class="form-label" for="bannedUntil">Bị cấm đến</label>
                                        <input type="text" id="bannedUntil" class="form-control" value="{{ user.bannedUntil | formatDate('DD/MM/YYYY HH:mm:ss') }}" disabled/>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="form-label" for="bannedReason">Lý do bị cấm</label>
                                        <input type="text" id="bannedReason" class="form-control" value="{{ user.bannedReason }}" disabled/>
                                    </div>
                                    {% endif %}
                                    <input type="hidden" name="type" value="CHANGE_PROFILE"/>
                                    <div class="mt-6">
                                        <button type="submit" class="btn btn-primary me-3">
                                            Lưu Thay Đổi
                                        </button>
                                        <button type="reset" class="btn btn-outline-secondary">
                                            Hủy
                                        </button>
                                    </div>
                                </div>
                            </form>
                        </div>
                        <!-- /Tài khoản -->
                    </div>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal Popup Đổi Mật Khẩu -->
    <div class="modal fade" id="changePassModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Đổi mật khẩu</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="formChangePass" method="POST" action="{{ baseUrl }}/users/edit-profile">
                        <div class="mb-3">
                            <label for="currentPassword" class="form-label">Mật khẩu hiện tại</label>
                            <input type="password" class="form-control" id="currentPassword" name="currentPassword" required/>
                        </div>
                        <div class="mb-3">
                            <label for="newPassword" class="form-label">Mật khẩu mới</label>
                            <input type="password" class="form-control" id="newPassword" name="newPassword" required/>
                        </div>
                        <div class="mb-3">
                            <label for="confirmPassword" class="form-label">Xác nhận mật khẩu mới</label>
                            <input type="password" class="form-control" id="confirmPassword" name="confirmPassword" required/>
                        </div>
                        <input type="hidden" name="type" value="CHANGE_PASS"/>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="submit" form="formChangePass" class="me-2 btn btn-primary">
                        Lưu thay đổi
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
    <!-- Modal Popup Đổi Email -->
    <div class="modal fade" id="changeMailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">Đổi email</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form id="formChangeMail" method="POST" action="{{ baseUrl }}/users/edit-profile">
                        <div id="message-alert-email"></div>
                        <div class="mb-3">
                            <label class="form-label" for="apiKey">Nhập email mới</label>
                            <div class="input-group input-group-merge">
                                <input type="email" id="email-pre" class="form-control" name="email" placeholder="" required/>
                                <button class="btn btn-outline-primary" type="button" onclick="sendCode(this)">
                                    Nhận mã OTP
                                </button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label for="otp" class="form-label">Mã OTP</label>
                            <input type="text" class="form-control" name="otp" required/>
                        </div>
                        <input type="hidden" name="type" value="CHANGE_EMAIL"/>
                    </form>
                </div>
                <div class="modal-footer">
                    <button type="submit" form="formChangeMail" class="me-2 btn btn-primary">
                        Lưu thay đổi
                    </button>
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                        Đóng
                    </button>
                </div>
            </div>
        </div>
    </div>
    <div class="cf-turnstile mt-3" data-sitekey="{{ capchaPublicKey }}" data-theme="light"></div>
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    <script>
        function openFormChangePass() {
            var changePassModal = new bootstrap.Modal(document.getElementById('changePassModal'),);
            changePassModal.show();
        }
        function openFormChangeMail() {
            var changeMailModal = new bootstrap.Modal(document.getElementById('changeMailModal'),);
            changeMailModal.show();
        }
        async function sendCode(button) {
            button.disabled = true;
            button.innerText = 'Đang gửi...';
            const requestData = {
                email: document.getElementById('email-pre').value,
                'cf-turnstile-response': document.querySelector('.cf-turnstile [name="cf-turnstile-response"]',).value || '',
                type: 'CHANGE_MAIL'
            };
            fetch('{{ baseUrl }}/authentication/verify-email', {
                method: 'POST',
                headers: {
                    'Content-Type': 'application/json'
                },
                body: JSON.stringify(requestData)
            })
                .then((response) => response.json())
                .then((data) => {
                    if (data.success) {
                        showToast({message: data.data, header: 'Thông báo', type: 'success', delay: 3000});
                        startCountdown(button);
                    } else {
                        showToast({message: data.message, header: 'Lỗi!', type: 'error', delay: 5000});
                        button.disabled = false;
                        button.innerText = 'Gửi lại mã';
                    }
                })
                .catch((error) => {
                    console.error('Error:', error);
                    showToast({message: error.message, header: 'Lỗi!', type: 'error', delay: 5000});
                });
        }
        function startCountdown(button) {
            let countdown = 60;
            const interval = setInterval(() => {
                button.innerText = `${countdown}s`;
                countdown--;
                if (countdown < 0) {
                    clearInterval(interval);
                    button.disabled = false;
                    button.innerText = 'Gửi lại mã';
                }
            }, 1000);        }    

        async function uploadFile(file) {
            const formData = new FormData();
            formData.append('file', file);
            try {
                const response = await fetch('/storage/upload', {
                method: 'POST',
                body: formData
                });
                if (!response.ok) throw new Error('Upload failed');
                const data = await response.json();
                return data.data.url; // Assuming the API returns the file URL
            } catch (error) {
                console.error('Error uploading file:', error);
                showToast({message: "Lỗi khi tải lên tệp.", type: "error"});
            }
        }
    </script>
{% endblock %}