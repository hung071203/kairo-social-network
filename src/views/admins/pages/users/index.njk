{% extends 'layouts/app.njk' %}
{% set title = 'Quản lý người dùng' %}
{% set auth = false %}
{% block content %}
    <div class="card-header border-bottom">
        <h5 class="card-header">Quản lý người dùng</h5>
    </div>
    <br/>
    <!-- Button Thêm mới -->
    <div
        class="d-flex justify-content-between mb-3">
        <!-- Ô tìm kiếm + Nút tìm kiếm -->
        <div class="input-group w-25">
            <input type="text" class="form-control" id="searchUser" placeholder="Tìm kiếm người dùng...">
                <button class="btn btn-outline-primary" onclick="submitSearch()">
                    <i class="bx bx-search"></i>
                    Tìm kiếm
                </button>
            </div>            {% if user.role == 'ADMIN' %}
                <button class="btn btn-secondary add-new btn-primary" onclick="openAddUser()">
                    <span>
                        <i class="bx bx-plus bx-sm me-0 me-sm-2"></i>
                        <span class="d-none d-sm-inline-block">Thêm Mới Người Dùng</span>
                    </span>
                </button>
            {% endif %}
        </div>
        <script>
            // Lấy giá trị của query "search" từ URL và gán vào input
            function getSearchQuery() {
                const params = new URLSearchParams(window.location.search);
                return params.get("search") || "";
            }
            document.getElementById("searchUser").value = getSearchQuery();
            function submitSearch() {
                let input = document
                    .getElementById("searchUser")
                    .value
                    .trim();
                let url = new URL(window.location.href);
                if (input) {
                    url.searchParams.set("search", input); // Thêm hoặc cập nhật query "search"
                } else {
                    url.searchParams.delete("search"); // Xóa query nếu input rỗng
                }
                window.location.href = url.toString(); // Load lại trang với query mới
            }
            document.getElementById("searchUser").addEventListener("keydown", function (event) {
                if (event.key === "Enter") {
                    submitSearch();
                }
            });
        </script>
        <div class="table-responsive text-nowrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Người dùng</th>
                        <th>Số điện thoại</th>
                        <th
                            class="sortable"
                            onclick="setQueryParams({sort: 'role', order: '{% if query.order == 'asc' %}desc{% else %}asc{% endif %}'});">
                            Quyền hạn
                            <i class="fas fa-sort{% if query.sort == 'role' and query.order == 'asc' %}-up{% elif query.sort == 'role' and query.order
                                == 'desc' %}-down{% else %}{% endif %}"></i>
                        </th>
                        <th
                            class="sortable"
                            onclick="setQueryParams({sort: 'status', order: '{% if query.order == 'asc' %}desc{% else %}asc{% endif %}'});">
                            Trạng Thái
                            <i class="fas fa-sort{% if query.sort == 'status' and query.order == 'asc' %}-up{% elif query.sort == 'status' and
                                query.order == 'desc' %}-down{% endif %}"></i>
                        </th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    {% set index = (data.page - 1) * data.limit + 1 %}
                    {% for item in data.docs %}
                        <tr>
                            <td>{{ index }}</td>
                            {% set index = index + 1 %}                            <td>
                                <div class="d-flex justify-content-start align-items-center user-name">
                                    <div class="avatar-wrapper">
                                        <div class="avatar avatar-sm me-4">
                                            {% if item.avatar and item.avatar != '/images/kairo.jpg' %}
                                                <img src="{{ item.avatar }}" alt="{{ item.name }}" class="rounded-circle">
                                            {% else %}
                                                <span class="avatar-initial rounded-circle bg-label-primary">{{ item.name[0].upper() }}</span>
                                            {% endif %}
                                        </div>
                                    </div>
                                    <div class="d-flex flex-column">
                                        <span class="fw-medium text-heading">{{ item.name }}</span>
                                        <small class="text-muted">@{{ item.username }}</small>
                                        <small class="text-muted">{{ item.email }}</small>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-muted">{{ item.phone or 'Trống' }}</span>
                            </td>                            <td>
                                {% if item.role == 'ADMIN' %}
                                    <span class="badge bg-label-danger me-1">Admin</span>
                                {% elif item.role == 'MOD' %}
                                    <span class="badge bg-label-warning me-1">Moderator</span>
                                {% else %}
                                    <span class="badge bg-label-success me-1">Người Dùng</span>
                                {% endif %}
                            </td>                            <td>
                                {% if item.bannedUntil and item.bannedUntil > new Date() %}
                                    <span class="badge bg-label-danger me-1">Bị khóa</span>
                                {% elif item.bannedReason %}
                                    <span class="badge bg-label-warning me-1">Cảnh báo</span>
                                {% else %}
                                    <span class="badge bg-label-success me-1">Hoạt động</span>
                                {% endif %}
                            </td>                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="dropdown">
                                        <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="bx bx-dots-vertical-rounded"></i>
                                        </button>{% if user.role == 'ADMIN' or user.role == 'MOD' %}
                                                    <div class="dropdown-menu">
                                                        <a class="dropdown-item" href="javascript:void(0);" onclick="openEditUserModal('{{ item._id }}');">
                                                            <i class="bx bx-edit-alt me-1"></i>
                                                            Chỉnh Sửa
                                                        </a>
                                                        <a
                                                            class="dropdown-item"
                                                            href="javascript:void(0);"
                                                            onclick="confirmBanUser('{{ item.name }}', '{{ item._id }}', {% if item.bannedUntil %}false{% else %}true{% endif %})">
                                                            {% if item.bannedUntil and item.bannedUntil > new Date() %}
                                                                <i class="bx bx-lock-open me-1"></i>
                                                                Mở Khóa
                                                            {% else %}
                                                                <i class="bx bx-lock me-1"></i>
                                                                Khóa Tài Khoản
                                                            {% endif %}
                                                        </a>
                                                        {% if not item.bannedUntil %}
                                                            <a
                                                                class="dropdown-item"
                                                                href="javascript:void(0);"
                                                                onclick="confirmWarnUser('{{ item.name }}', '{{ item._id }}');">
                                                                <i class="bx bx-error me-1"></i>
                                                                Cảnh báo
                                                            </a>
                                                        {% endif %}
                                                        {% if user.role == 'ADMIN' %}
                                                            <a class="dropdown-item" href="javascript:void(0);" onclick="delUser('{{ item.name }}', '{{ item._id }}');">
                                                                <i class="bx bx-trash me-1"></i>
                                                                Xóa tài khoản
                                                            </a>
                                                        {% endif %}
                                                    </div>                                        {% endif %}
                                    </div>
                                </div>
                            </td>
                        </tr>
                    {% endfor %}
                </tbody>
            </table>
        </div>
                {% include '../../layouts/_pagination.njk' %}
                <!-- Offcanvas to add new user -->
                <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddUser" aria-labelledby="offcanvasAddUserLabel">
                    <div class="offcanvas-header border-bottom">
                        <h5 id="offcanvasAddUserLabel" class="offcanvas-title">Thêm Người Dùng</h5>
                        <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
                    </div>
                    <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
                        <form class="add-new-user pt-0 fv-plugins-bootstrap5 fv-plugins-framework" id="addNewUserForm" method="post" action="{{ baseUrl }}/users/create" novalidate="novalidate">                            <div class="mb-6 fv-plugins-icon-container">
                                <label class="form-label" for="add-user-fullname">Họ Tên</label>
                                <input
                                    type="text"
                                    class="form-control"
                                    id="name"
                                    placeholder="Nguyễn Văn A"
                                    name="name"
                                    aria-label="Nguyễn Văn A"
                                    required>
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
                            </div>
                            <div class="mb-6 fv-plugins-icon-container">
                                <label class="form-label" for="add-user-username">Tên đăng nhập</label>
                                <input
                                    type="text"
                                    class="form-control"
                                    id="username"
                                    placeholder="nguyenvana"
                                    name="username"
                                    aria-label="Tên đăng nhập"
                                    required>
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
                            </div>
                            <div class="mb-6 fv-plugins-icon-container">
                                <label class="form-label" for="add-user-email">Email</label>
                                <input
                                        type="email"
                                        id="email"
                                        class="form-control"
                                        placeholder="nguyenvana@example.com"
                                        aria-label="nguyenvana@example.com"
                                        name="email"
                                        required>
                                        <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
                                    </div>
                                    <div class="mb-6">
                                        <label class="form-label" for="add-user-contact">Liên Hệ</label>
                                        <input
                                            type="tel"
                                            id="phone"
                                            class="form-control phone-mask"
                                            placeholder="+84 (123) 456-789"
                                            aria-label="Liên Hệ"
                                            name="phone"
                                            pattern="[0-9]{10}"
                                            required></div>
                                        <div class="mb-6 form-password-toggle">
                                            <label class="form-label" for="password">Mật khẩu</label>
                                            <div class="input-group input-group-merge">
                                                <input
                                                    type="password"
                                                    id="password"
                                                    class="form-control"
                                                    name="password"
                                                    placeholder="············"
                                                    aria-describedby="password">
                                                    <span class="input-group-text cursor-pointer">
                                                        <i class="bx bx-hide"></i>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="mb-6 d-flex justify-content-between">                                <div class="me-2 flex-fill">
                                    <label class="form-label" for="user-role">Vai Trò Người Dùng</label>
                                    <select id="role" name="role" class="form-select">
                                        <option value="USER">Người Dùng</option>
                                        <option value="MOD">Moderator</option>
                                        <option value="ADMIN">Admin</option>
                                    </select>
                                </div>
                                <div class="flex-fill">
                                    <label class="form-label" for="user-gender">Giới tính</label>
                                    <select id="gender" name="gender" class="form-select">
                                        <option value="OTHER">Khác</option>
                                        <option value="MALE">Nam</option>
                                        <option value="FEMALE">Nữ</option>
                                    </select>
                                </div>                            </div>
                            <div class="mb-6">
                                <label class="form-label" for="add-user-bio">Tiểu sử</label>
                                <textarea
                                    id="bio"
                                    class="form-control"
                                    placeholder="Mô tả về bản thân..."
                                    name="bio"
                                    rows="3"></textarea>
                            </div>
                            <button type="submit" class="btn btn-primary me-3 data-submit">Gửi</button>
                            <button type="reset" class="btn btn-label-danger" data-bs-dismiss="offcanvas">Hủy</button>
                        </form>
                                            </div>
                                        </div>                        <script>
                            function confirmBanUser(username, id, shouldBan) {
                                const action = shouldBan ? 'khóa' : 'mở khóa';
                                if (confirm(`Bạn có chắc chắn muốn ${action} tài khoản của ${username} không?`)) {
                                    const formData = new FormData();
                                    if (shouldBan) {
                                        formData.append('bannedUntil', new Date(Date.now() + 30 * 24 * 60 * 60 * 1000).toISOString()); // Ban for 30 days
                                        formData.append('bannedReason', 'Vi phạm quy định');
                                    } else {
                                        formData.append('bannedUntil', '');
                                        formData.append('bannedReason', '');
                                    }
                                    
                                    fetch(`{{ baseUrl }}/user-management/ban/${id}`, {
                                        method: 'POST',
                                        body: formData
                                    }).then(() => {
                                        location.reload();
                                    });
                                }
                            }

                            function confirmWarnUser(username, id) {
                                const reason = prompt(`Nhập lý do cảnh báo cho ${username}:`);
                                if (reason) {
                                    const formData = new FormData();
                                    formData.append('bannedReason', reason);
                                    
                                    fetch(`{{ baseUrl }}/user-management/warn/${id}`, {
                                        method: 'POST',
                                        body: formData
                                    }).then(() => {
                                        location.reload();
                                    });
                                }
                            }

                            function delUser(username, id) {
                                if (confirm(`Bạn có chắc chắn muốn xóa tài khoản của ${username} không?`)) {
                                    fetch(`{{ baseUrl }}/user-management/delete/${id}`, {
                                        method: 'DELETE'
                                    }).then(() => {
                                        location.reload();
                                    });
                                }
                            }

                            function openAddUser() {
                                document.getElementById("offcanvasAddUserLabel").innerText = "Thêm Mới Người Dùng";
                                document.getElementById("addNewUserForm").action = "{{ baseUrl }}/user-management/create";
                                document.getElementById("addNewUserForm").reset();
                                const addUserModal = new bootstrap.Offcanvas(document.getElementById("offcanvasAddUser"));
                                addUserModal.show();
                            }

                            function openEditUserModal(id) {
                                document.getElementById("offcanvasAddUserLabel").innerText = "Chỉnh Sửa Người Dùng";
                                document.getElementById("addNewUserForm").action = "{{ baseUrl }}/user-management/update/" + id;
                                
                                fetch(`{{ baseUrl }}/user-management/get/${id}`)
                                    .then(response => response.json())
                                    .then(response => {
                                        document.getElementById("name").value = response.data.name || '';
                                        document.getElementById("username").value = response.data.username || '';
                                        document.getElementById("email").value = response.data.email || '';
                                        document.getElementById("phone").value = response.data.phone || '';
                                        document.getElementById("role").value = response.data.role || 'USER';
                                        document.getElementById("gender").value = response.data.gender || 'OTHER';
                                        document.getElementById("bio").value = response.data.bio || '';
                                        document.getElementById('password').value = '';
                                        
                                        const editUserModal = new bootstrap.Offcanvas(document.getElementById("offcanvasAddUser"));
                                        editUserModal.show();
                                    })
                                    .catch(error => {
                                        alert("Lỗi: " + error.message);
                                    });
                            }

                            function setQueryParams(params) {
                                const url = new URL(window.location.href);
                                Object.keys(params).forEach(key => {
                                    url.searchParams.set(key, params[key]);
                                });
                                window.location.href = url.toString();
                            }
                        </script>
                                    {% endblock %}