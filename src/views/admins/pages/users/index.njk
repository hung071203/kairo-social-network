                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                    <!-- Remove Warning Modal -->
                                    <div
                                        class="modal fade"
                                        id="removeWarningModal"
                                        tabindex="-1"
                                        aria-labelledby="removeWarningModalLabel"
                                        aria-hidden="true">
                                        <div class="modal-dialog modal-dialog-centered">
                                            <div class="modal-content">
                                                <div class="modal-header">
                                                    <h5 class="modal-title" id="removeWarningModalLabel">
                                                        <i class="bx bx-check-circle text-success me-2"></i>Bỏ Cảnh Báo
                                                    </h5>
                                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                                </div>
                                                <div class="modal-body">
                                                    <div class="text-center mb-3">
                                                        <i class="bx bx-shield-check text-success" style="font-size: 48px;"></i>
                                                    </div>
                                                    <div class="mb-3">
                                                        <p class="text-center">Bạn có chắc chắn muốn bỏ cảnh báo cho:</p>
                                                        <p class="text-center fw-bold fs-5" id="removeWarningUserName"></p>
                                                    </div>
                                                    <div class="alert alert-success">
                                                        <i class="bx bx-info-circle me-2"></i>
                                                        Sau khi bỏ cảnh báo, trạng thái tài khoản sẽ trở về bình thường.
                                                    </div>
                                                </div>
                                                <div class="modal-footer">
                                                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                    <button type="button" class="btn btn-success" onclick="confirmRemoveWarning()">
                                                        <i class="bx bx-check me-1"></i>Bỏ Cảnh Báo
                                                    </button>
                                                </div>
                                            </div>
                                        </div>
                                    </div>                                    <script>
                                        let currentBanUserId = null;
                                        let currentBanUserName = null;
                                        let currentProfileUserId = null;
                                        
                                        // User Profile Modal Functions
                                        function openUserProfileModal(userId) {
                                            currentProfileUserId = userId;
                                            fetchUserProfile(userId);
                                        }
                                        
                                        async function fetchUserProfile(userId) {
                                            try {
                                                const response = await fetch(`{{ baseUrl }}/user-management/get/${userId}`);
                                                const result = await response.json();
                                                
                                                if (response.ok && result.data) {
                                                    const user = result.data.data;
                                                    populateUserProfile(user);
                                                    
                                                    const profileModal = new bootstrap.Modal(document.getElementById('userProfileModal'));
                                                    profileModal.show();
                                                } else {
                                                    showNotification('error', 'Lỗi!', 'Không thể tải thông tin người dùng');
                                                }
                                            } catch (error) {
                                                console.error('Error fetching user profile:', error);
                                                showNotification('error', 'Lỗi!', 'Có lỗi xảy ra khi tải thông tin người dùng');
                                            }
                                        }
                                          function populateUserProfile(user) {                                            // Basic information
                                            document.getElementById('profileAvatar').src = user.avatar || '/images/kairo.jpg';
                                            document.getElementById('profileName').textContent = user.name || 'Chưa có tên';
                                            document.getElementById('profileUsername').textContent = '@' + (user.username || 'username');// Cover photo - use user's background field from API
                                            const coverElement = document.getElementById('profileCoverPhoto');
                                            if (user.background) {
                                                coverElement.style.backgroundImage = `url(${user.background})`;
                                                coverElement.style.filter = 'none';
                                            } else {
                                                // Use default background image if no background provided
                                                coverElement.style.backgroundImage = 'url(/images/bg.jpg)';
                                                coverElement.style.filter = 'brightness(0.8)';
                                            }
                                            
                                            // Role
                                            const roleElement = document.getElementById('profileRole');
                                            const roleText = user.role === 'ADMIN' ? 'Quản trị viên' : 
                                                            user.role === 'MOD' ? 'Điều hành viên' : 'Người dùng';
                                            const roleClass = user.role === 'ADMIN' ? 'bg-label-danger' : 
                                                             user.role === 'MOD' ? 'bg-label-warning' : 'bg-label-success';
                                            roleElement.textContent = roleText;
                                            roleElement.className = `badge ${roleClass}`;
                                            
                                            // Ban status
                                            const banStatusElement = document.getElementById('profileBanStatus');
                                            if (user.bannedUntil && new Date(user.bannedUntil) > new Date()) {
                                                banStatusElement.textContent = 'Đang bị khóa';
                                                banStatusElement.className = 'badge bg-label-danger';
                                                banStatusElement.classList.remove('d-none');
                                            } else if (user.bannedReason && (!user.bannedUntil || new Date(user.bannedUntil) <= new Date())) {
                                                banStatusElement.textContent = 'Cảnh báo';
                                                banStatusElement.className = 'badge bg-label-warning';
                                                banStatusElement.classList.remove('d-none');
                                            } else {
                                                banStatusElement.classList.add('d-none');
                                            }
                                            
                                            // Bio
                                            document.getElementById('profileBio').textContent = user.bio || 'Chưa có thông tin giới thiệu';
                                            
                                            // Contact information
                                            document.getElementById('profileEmail').textContent = user.email || 'Chưa có email';
                                            document.getElementById('profilePhone').textContent = user.phone || 'Chưa có số điện thoại';
                                            
                                            const genderText = user.gender === 'MALE' ? 'Nam' : 
                                                              user.gender === 'FEMALE' ? 'Nữ' : 'Khác';
                                            document.getElementById('profileGender').textContent = genderText;
                                            
                                            // Account information
                                            const formatDate = (dateString) => {
                                                if (!dateString) return 'Chưa có thông tin';
                                                const date = new Date(dateString);
                                                return date.toLocaleDateString('vi-VN', {
                                                    year: 'numeric',
                                                    month: 'long',
                                                    day: 'numeric',
                                                    hour: '2-digit',
                                                    minute: '2-digit'
                                                });
                                            };
                                              document.getElementById('profileCreatedAt').textContent = formatDate(user.createdAt);
                                            document.getElementById('profileUpdatedAt').textContent = formatDate(user.updatedAt);
                                              // Statistics (using sample data for now)
                                            document.getElementById('profilePostsCount').textContent = user.postsCount || 0;
                                            document.getElementById('profileFollowersCount').textContent = user.followersCount || 0;
                                            document.getElementById('profileFollowingCount').textContent = user.followingCount || 0;
                                        }
                                        
                                        function openBanModal(username, id) {
                                            currentBanUserId = id;
                                            currentBanUserName = username;
                                            document.getElementById('banUserName').textContent = username;
                                            document.getElementById('banDuration').value = '30';
                                            document.getElementById('banReason').value = 'Vi phạm quy định';
                                            document
                                                .getElementById('customDateGroup')
                                                .style
                                                .display = 'none';
                                            const banModal = new bootstrap.Modal(document.getElementById('banUserModal'));
                                            banModal.show();
                                        }
                                        function confirmUnbanUser(username, id) {
                                            if (confirm (`Bạn có chắc chắn muốn mở khóa tài khoản của ${username} không?`)) {
                                                const data = {
                                                    bannedUntil: null,
                                                    bannedReason: null
                                                };
                                                fetch (`{{ baseUrl }}/user-management/ban/${id}`, {
                                                    method: 'POST',
                                                    headers: {
                                                        'Content-Type': 'application/json'
                                                    },
                                                    body: JSON.stringify(data)
                                                }).then(response => {
                                                    if (response.ok) {
                                                        showNotification('success', 'Thành công!', `Đã mở khóa tài khoản ${username}`);
                                                        setTimeout(() => {
                                                            location.reload();
                                                        }, 2000);
                                                    } else {
                                                        return response.json().then(err => {
                                                            throw new Error(err.message || 'Có lỗi xảy ra');
                                                        });
                                                    }
                                                }).catch(error => {
                                                    showNotification('error', 'Lỗi!', error.message);
                                                });
                                            }
                                        }
                                        function confirmBan() {
                                            const duration = document.getElementById('banDuration').value;
                                            const reason = document
                                                .getElementById('banReason')
                                                .value
                                                .trim();
                                            if (! reason) {
                                                alert('Vui lòng nhập lý do khóa tài khoản');
                                                return;
                                            }
                                            let bannedUntil = null;
                                            if (duration === 'permanent') { // Set to a very far future date for permanent ban
                                                bannedUntil = new Date('2099-12-31T23:59:59.999Z').toISOString();
                                            } else if (duration === 'custom') {
                                                const customDate = document.getElementById('customBanDate').value;
                                                if (! customDate) {
                                                    showNotification('error', 'Lỗi!', 'Vui lòng chọn ngày kết thúc khóa');
                                                    return;
                                                }
                                                bannedUntil = new Date(customDate).toISOString();
                                            } else {
                                                const days = parseInt(duration);
                                                bannedUntil = new Date(Date.now() + days * 24 * 60 * 60 * 1000).toISOString();
                                            }
                                            const data = {
                                                bannedUntil: bannedUntil,
                                                bannedReason: reason
                                            };
                                            fetch (`{{ baseUrl }}/user-management/ban/${currentBanUserId}`, {
                                                method: 'POST',
                                                headers: {
                                                    'Content-Type': 'application/json'
                                                },
                                                body: JSON.stringify(data)
                                            }).then(response => {
                                                if (response.ok) { // Close modal and show success notification
                                                    const banModal = bootstrap.Modal.getInstance(document.getElementById('banUserModal'));
                                                    banModal.hide();
                                                    showNotification('success', 'Thành công!', `Đã khóa tài khoản ${currentBanUserName}`);
                                                    setTimeout(() => {
                                                        location.reload();
                                                    }, 2000);
                                                } else {
                                                    return response.json().then(err => {
                                                        throw new Error(err.message || 'Có lỗi xảy ra');
                                                    });
                                                }
                                            }).catch(error => {
                                                showNotification('error', 'Lỗi!', error.message);
                                            });
                                        }
                                        // Handle ban duration change
                                        document.addEventListener('DOMContentLoaded', function () {
                                            const banDurationSelect = document.getElementById('banDuration');
                                            const customDateGroup = document.getElementById('customDateGroup');
                                            if (banDurationSelect) {
                                                banDurationSelect.addEventListener('change', function () {
                                                    if (this.value === 'custom') {
                                                        customDateGroup.style.display = 'block';
                                                        // Set minimum date to current time
                                                        const now = new Date();
                                                        now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                                                        document.getElementById('customBanDate').min = now.toISOString().slice(0, 16);
                                                    } else {
                                                        customDateGroup.style.display = 'none';
                                                    }
                                                });
                                            }
                                        });
                                        // Variables for managing modals
                                        let currentWarnUserId = null;
                                        let currentWarnUserName = null;
                                        let currentDeleteUserId = null;
                                        let currentDeleteUserName = null;
                                        let currentUnbanUserId = null;
                                        let currentUnbanUserName = null;
                                        let currentRemoveWarningUserId = null;
                                        let currentRemoveWarningUserName = null;
                                        // Unban user functions
                                        function openUnbanModal(username, id) {
                                            currentUnbanUserId = id;
                                            currentUnbanUserName = username;
                                            document.getElementById('unbanUserName').textContent = username;
                                            const unbanModal = new bootstrap.Modal(document.getElementById('unbanUserModal'));
                                            unbanModal.show();
                                        }
                                        function confirmUnban() {
                                            const data = {
                                                bannedUntil: null,
                                                bannedReason: null
                                            };
                                            fetch (`{{ baseUrl }}/user-management/ban/${currentUnbanUserId}`, {
                                                method: 'POST',
                                                headers: {
                                                    'Content-Type': 'application/json'
                                                },
                                                body: JSON.stringify(data)
                                            }).then(response => {
                                                if (response.ok) { // Close unban modal
                                                    const unbanModal = bootstrap.Modal.getInstance(document.getElementById('unbanUserModal'));
                                                    unbanModal.hide();
                                                    showNotification('success', 'Thành công!', `Đã mở khóa tài khoản ${currentUnbanUserName}`);
                                                    setTimeout(() => {
                                                        location.reload();
                                                    }, 2000);
                                                } else {
                                                    return response.json().then(err => {
                                                        throw new Error(err.message || 'Có lỗi xảy ra');
                                                    });
                                                }
                                            }).catch(error => {
                                                showNotification('error', 'Lỗi!', error.message);
                                            });
                                        }
                                        // Remove warning functions
                                        function openRemoveWarningModal(username, id) {
                                            currentRemoveWarningUserId = id;
                                            currentRemoveWarningUserName = username;
                                            document.getElementById('removeWarningUserName').textContent = username;
                                            const removeWarningModal = new bootstrap.Modal(document.getElementById('removeWarningModal'));
                                            removeWarningModal.show();
                                        }
                                        function confirmRemoveWarning() {
                                            fetch (`{{ baseUrl }}/user-management/remove-warning/${currentRemoveWarningUserId}`, {
                                                method: 'POST',
                                                headers: {
                                                    'Content-Type': 'application/json'
                                                }
                                            }).then(response => {
                                                if (response.ok) { // Close remove warning modal
                                                    const removeWarningModal = bootstrap.Modal.getInstance(document.getElementById('removeWarningModal'));
                                                    removeWarningModal.hide();
                                                    // Show success notification
                                                    showNotification('success', 'Thành công!', `Đã gỡ bỏ cảnh báo cho ${currentRemoveWarningUserName}`);
                                                    // Reload page after 2 seconds
                                                    setTimeout(() => {
                                                        location.reload();
                                                    }, 2000);
                                                } else {
                                                    return response.json().then(err => {
                                                        throw new Error(err.message || 'Có lỗi xảy ra');
                                                    });
                                                }
                                            }).catch(error => {
                                                showNotification('error', 'Lỗi!', error.message);
                                            });
                                        }
                                        // Update confirmUnbanUser to use modal
                                        function confirmUnbanUser(username, id) {
                                            openUnbanModal(username, id);
                                        } // Warning user functions
                                        function openWarnModal(username, id) {
                                            currentWarnUserId = id;
                                            currentWarnUserName = username;
                                            document.getElementById('warnUserName').textContent = username;
                                            document.getElementById('warnReason').value = 'Vi phạm quy định cộng đồng';
                                            const warnModal = new bootstrap.Modal(document.getElementById('warnUserModal'));
                                            warnModal.show();
                                        }
                                        function confirmWarn() {
                                            const reason = document
                                                .getElementById('warnReason')
                                                .value
                                                .trim();
                                            if (! reason) {
                                                showNotification('error', 'Lỗi!', 'Vui lòng nhập lý do cảnh báo');
                                                return;
                                            }
                                            const data = {
                                                bannedReason: reason
                                            };
                                            fetch (`{{ baseUrl }}/user-management/warn/${currentWarnUserId}`, {
                                                method: 'POST',
                                                headers: {
                                                    'Content-Type': 'application/json'
                                                },
                                                body: JSON.stringify(data)
                                            }).then(response => {
                                                if (response.ok) { // Close warning modal
                                                    const warnModal = bootstrap.Modal.getInstance(document.getElementById('warnUserModal'));
                                                    warnModal.hide();
                                                    // Show success notification
                                                    showNotification('success', 'Thành công!', `Đã gửi cảnh báo cho ${currentWarnUserName}`);
                                                    // Reload page after 2 seconds
                                                    setTimeout(() => {
                                                        location.reload();
                                                    }, 2000);
                                                } else {
                                                    return response.json().then(err => {
                                                        throw new Error(err.message || 'Có lỗi xảy ra');
                                                    });
                                                }
                                            }).catch(error => {
                                                showNotification('error', 'Lỗi!', error.message);
                                            });
                                        }
                                        // Delete user functions
                                        function openDeleteModal(username, id) {
                                            currentDeleteUserId = id;
                                            currentDeleteUserName = username;
                                            document.getElementById('deleteUserName').textContent = username;
                                            const deleteModal = new bootstrap.Modal(document.getElementById('deleteUserModal'));
                                            deleteModal.show();
                                        }
                                        function confirmDelete() {
                                            fetch (`{{ baseUrl }}/user-management/delete/${currentDeleteUserId}`, {method: 'DELETE'}).then(response => {
                                                if (response.ok) { // Close delete modal
                                                    const deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteUserModal'));
                                                    deleteModal.hide();
                                                    // Show success notification
                                                    showNotification('success', 'Thành công!', `Đã xóa tài khoản ${currentDeleteUserName}`);
                                                    // Reload page after 2 seconds
                                                    setTimeout(() => {
                                                        location.reload();
                                                    }, 2000);
                                                } else {
                                                    return response.json().then(err => {
                                                        throw new Error(err.message || 'Có lỗi xảy ra');
                                                    });
                                                }
                                            }).catch(error => {
                                                showNotification('error', 'Lỗi!', error.message);
                                            });
                                        }
                                        // Notification function
                                        function showNotification(type, title, message) {
                                            const notificationModal = document.getElementById('notificationModal');
                                            const notificationIcon = document.getElementById('notificationIcon');
                                            const notificationTitle = document.getElementById('notificationTitle');
                                            const notificationMessage = document.getElementById('notificationMessage');
                                            // Set icon and colors based on type
                                            if (type === 'success') {
                                                notificationIcon.innerHTML = '<i class="bx bx-check-circle text-success" style="font-size: 48px;"></i>';
                                                notificationTitle.className = 'mb-2 text-success';
                                            } else if (type === 'error') {
                                                notificationIcon.innerHTML = '<i class="bx bx-error-circle text-danger" style="font-size: 48px;"></i>';
                                                notificationTitle.className = 'mb-2 text-danger';
                                            } else if (type === 'warning') {
                                                notificationIcon.innerHTML = '<i class="bx bx-error text-warning" style="font-size: 48px;"></i>';
                                                notificationTitle.className = 'mb-2 text-warning';
                                            }
                                            notificationTitle.textContent = title;
                                            notificationMessage.textContent = message;
                                            const modal = new bootstrap.Modal(notificationModal);
                                            modal.show();
                                        }
                                        function confirmWarnUser(username, id) {
                                            openWarnModal(username, id);
                                        }
                                        function delUser(username, id) {
                                            openDeleteModal(username, id);
                                        }
                                        function openAddUser() {
                                            document.getElementById("offcanvasAddUserLabel").innerText = "Thêm Mới Người Dùng";
                                            document.getElementById("addNewUserForm").action = "{{ baseUrl }}/user-management/create";
                                            document.getElementById("addNewUserForm").reset();
                                            // Make password required for new users
                                            document.getElementById("password").required = true;
                                            const addUserModal = new bootstrap.Offcanvas(document.getElementById("offcanvasAddUser"));
                                            addUserModal.show();
                                        }                                        function openEditUserModal(id) {
                                            // Đóng modal profile trước khi mở modal chỉnh sửa
                                            const profileModal = bootstrap.Modal.getInstance(document.getElementById('userProfileModal'));
                                            if (profileModal) {
                                                profileModal.hide();
                                            }
                                            
                                            document.getElementById("offcanvasAddUserLabel").innerText = "Chỉnh Sửa Người Dùng";
                                            document.getElementById("addNewUserForm").action = "{{ baseUrl }}/user-management/update/" + id;
                                            // Make password optional for editing
                                            document.getElementById("password").required = false;
                                            fetch (`{{ baseUrl }}/user-management/get/${id}`)
                                                .then(response => response.json())
                                                .then(response => {
                                                    response.data = response
                                                        .data
                                                        .data
                                                        document
                                                        .getElementById("name")
                                                        .value = response.data.name || '';
                                                    document.getElementById("username").value = response.data.username || '';
                                                    document.getElementById("email").value = response.data.email || '';
                                                    document.getElementById("phone").value = response.data.phone || '';
                                                    document.getElementById("role").value = response.data.role || 'USER';
                                                    document.getElementById("gender").value = response.data.gender || 'OTHER';
                                                    document.getElementById("bio").value = response.data.bio || '';
                                                    document.getElementById('password').value = '';
                                                    const editUserModal = new bootstrap.Offcanvas(document.getElementById("offcanvasAddUser"));
                                                    editUserModal.show();
                                                })
                                                .catch(error => {
                                                    showNotification('error', 'Lỗi!', `Không thể tải thông tin người dùng: ${
                                                        error.message
                                                    }`);
                                                });
                                        }
                                        function setQueryParams(params) {
                                            const url = new URL(window.location.href);
                                            Object.keys(params).forEach(key => {
                                                url.searchParams.set(key, params[key]);
                                            });
                                            window.location.href = url.toString();
                                        } // Handle form submission
                                        document.addEventListener('DOMContentLoaded', function () { // Initialize tooltips
                                            const tooltipTriggerList = [].slice.call(document.querySelectorAll('[data-bs-toggle="tooltip"]'));
                                            const tooltipList = tooltipTriggerList.map(function (tooltipTriggerEl) {
                                                return new bootstrap.Tooltip(tooltipTriggerEl);
                                            });
                                            const form = document.getElementById('addNewUserForm');
                                            if (form) {
                                                form.addEventListener('submit', function (e) {
                                                    e.preventDefault();
                                                    const formData = new FormData(form);
                                                    const data = {};
                                                    // Convert FormData to object, excluding empty password on edit
                                                    for (let [key, value] of formData.entries()) {
                                                        if (key === 'password' && value === '' && form.action.includes('update')) {
                                                            continue; // Skip empty password on update
                                                        }data[key] = value;
                                                    }
                                                    fetch(form.action, {
                                                        method: form.action.includes('update')
                                                            ? 'PUT'
                                                            : 'POST',
                                                        headers: {
                                                            'Content-Type': 'application/json'
                                                        },
                                                        body: JSON.stringify(data)
                                                    }).then(response => {
                                                        if (response.ok) { // Close offcanvas
                                                            const addUserModal = bootstrap.Offcanvas.getInstance(document.getElementById("offcanvasAddUser"));
                                                            addUserModal.hide();
                                                            // Show success notification
                                                            const isEdit = form.action.includes('update');
                                                            const successMessage = isEdit
                                                                ? 'Cập nhật người dùng thành công!'
                                                                : 'Tạo người dùng mới thành công!';
                                                            showNotification('success', 'Thành công!', successMessage);
                                                            // Reload page after 2 seconds
                                                            setTimeout(() => {
                                                                location.reload();
                                                            }, 2000);
                                                        } else {
                                                            return response.json().then(err => {
                                                                throw new Error(err.message || 'Có lỗi xảy ra');
                                                            });
                                                        }
                                                    }).catch(error => {
                                                        showNotification('error', 'Lỗi!', error.message);
                                                    });
                                                });
                                            }
                                        });
                                    </script>
                                {% endblock %}