{% extends 'admins/layouts/app.njk' %}
{% set title = 'Quản lý người dùng' %}
{% set auth = false %}
{% block content %}
    <div class="card-header border-bottom">
        <h5 class="card-header">Quản lý người dùng</h5>
    </div>
    <br/>
    <!-- Button Thêm mới -->
    <div
        class="d-flex justify-content-between mb-3">
        <!-- Ô tìm kiếm + Nút tìm kiếm -->
        <div class="input-group w-25">
            <input type="text" class="form-control" id="searchUser" placeholder="Tìm kiếm người dùng...">
                <button class="btn btn-outline-primary" onclick="submitSearch()">
                    <i class="bx bx-search"></i>
                    Tìm kiếm
                </button>
            </div>
            {% if user.role == 'ADMIN' %}
                <button class="btn btn-secondary add-new btn-primary" onclick="openAddUser()">
                    <span>
                        <i class="bx bx-plus bx-sm me-0 me-sm-2"></i>
                        <span class="d-none d-sm-inline-block">Thêm Mới Người Dùng</span>
                    </span>
                </button>
            {% endif %}
        </div>
        <script>
            // Lấy giá trị của query "search" từ URL và gán vào input
            function getSearchQuery() {
                const params = new URLSearchParams(window.location.search);
                return params.get("search") || "";
            }
            document.getElementById("searchUser").value = getSearchQuery();
            function submitSearch() {
                let input = document
                    .getElementById("searchUser")
                    .value
                    .trim();
                let url = new URL(window.location.href);
                if (input) {
                    url.searchParams.set("search", input); // Thêm hoặc cập nhật query "search"
                } else {
                    url.searchParams.delete("search"); // Xóa query nếu input rỗng
                }
                window.location.href = url.toString(); // Load lại trang với query mới
            }
            document.getElementById("searchUser").addEventListener("keydown", function (event) {
                if (event.key === "Enter") {
                    submitSearch();
                }
            });
        </script>
        <div class="table-responsive text-nowrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Người dùng</th>
                        <th>Số điện thoại</th>
                        <th
                            class="sortable"
                            onclick="setQueryParams({sort: 'role', order: '{% if query.order == 'asc' %}desc{% else %}asc{% endif %}'});">
                            Quyền hạn
                            <i class="fas fa-sort{% if query.sort == 'role' and query.order == 'asc' %}-up{% elif query.sort == 'role' and query.order
                                == 'desc' %}-down{% else %}{% endif %}"></i>
                        </th>
                        <th
                            class="sortable"
                            onclick="setQueryParams({sort: 'status', order: '{% if query.order == 'asc' %}desc{% else %}asc{% endif %}'});">
                            Trạng Thái
                            <i class="fas fa-sort{% if query.sort == 'status' and query.order == 'asc' %}-up{% elif query.sort == 'status' and
                                query.order == 'desc' %}-down{% endif %}"></i>
                        </th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    {% set index = (data.page - 1) * data.limit + 1 %}
                    {% if data.docs and data.docs.length > 0 %}
                        {% for item in data.docs %}
                            <tr>
                                <td>{{ index }}</td>
                                {% set index = index + 1 %}
                                <td>
                                    <div class="d-flex justify-content-start align-items-center user-name">
                                        <div class="avatar-wrapper">
                                            <div class="avatar avatar-sm me-4">
                                                {% if item.avatar %}
                                                    <img src="{{ item.avatar }}" alt="{{ item.name }}" class="rounded-circle">
                                                    {% endif %}
                                                </div>
                                            </div>
                                            <div class="d-flex flex-column">
                                                <span class="fw-medium text-heading">{{ item.name or 'Không có tên' }}</span>
                                                <small class="text-muted">{{ item.username or 'unknown' }}</small>
                                                <small class="text-muted">{{ item.email or 'Không có email' }}</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted">{{ item.phone or 'Trống' }}</span>
                                    </td>
                                    <td>
                                        {% if item.role == 'ADMIN' %}
                                            <span class="badge bg-label-danger me-1">Admin</span>
                                        {% elif item.role == 'MOD' %}
                                            <span class="badge bg-label-warning me-1">Moderator</span>
                                        {% else %}
                                            <span class="badge bg-label-success me-1">Người Dùng</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if item.bannedUntil %}
                                            <span class="badge bg-label-danger me-1">Bị khóa</span>
                                        {% elif item.bannedReason %}
                                            <span class="badge bg-label-warning me-1">Cảnh báo</span>
                                        {% else %}
                                            <span class="badge bg-label-success me-1">Hoạt động</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="dropdown">
                                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bx bx-dots-vertical-rounded"></i>
                                                </button>
                                                {% if user.role == 'ADMIN' or user.role == 'MOD' %}
                                                    <div class="dropdown-menu">
                                                        <a class="dropdown-item" href="javascript:void(0);" onclick="openEditUserModal('{{ item._id }}');">
                                                            <i class="bx bx-edit-alt me-1"></i>
                                                            Chỉnh Sửa
                                                        </a>                                                        <a
                                                            class="dropdown-item"
                                                            href="javascript:void(0);"
                                                            onclick="{% if item.bannedUntil %}confirmUnbanUser('{{ item.name }}', '{{ item._id }}'){% else %}openBanModal('{{ item.name }}', '{{ item._id }}'){% endif %}">
                                                            {% if item.bannedUntil %}
                                                                <i class="bx bx-lock-open me-1"></i>
                                                                Mở Khóa
                                                            {% else %}
                                                                <i class="bx bx-lock me-1"></i>
                                                                Khóa Tài Khoản
                                                            {% endif %}
                                                        </a>
                                                        {% if not item.bannedUntil %}
                                                            <a class="dropdown-item" href="javascript:void(0);" onclick="confirmWarnUser('{{ item.name }}', '{{ item._id }}');">
                                                                <i class="bx bx-error me-1"></i>
                                                                Cảnh báo
                                                            </a>
                                                        {% endif %}
                                                        {% if user.role == 'ADMIN' %}
                                                            <a class="dropdown-item" href="javascript:void(0);" onclick="delUser('{{ item.name }}', '{{ item._id }}');">
                                                                <i class="bx bx-trash me-1"></i>
                                                                Xóa tài khoản
                                                            </a>
                                                        {% endif %}
                                                    </div>
                                                {% endif %}
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <div class="empty-state">
                                        <i class="bx bx-user-x display-4 text-muted mb-2"></i>
                                        <p class="text-muted">Không có người dùng nào được tìm thấy</p>
                                    </div>
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
            {% include '../../layouts/_pagination.njk' %}
            <!-- Offcanvas to add new user -->
            <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddUser" aria-labelledby="offcanvasAddUserLabel">
                <div class="offcanvas-header border-bottom">
                    <h5 id="offcanvasAddUserLabel" class="offcanvas-title">Thêm Người Dùng</h5>
                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
                </div>
                <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
                    <form class="add-new-user pt-0 fv-plugins-bootstrap5 fv-plugins-framework" id="addNewUserForm" method="post" action="{{ baseUrl }}/users/create" novalidate="novalidate">
                        <div class="mb-6 fv-plugins-icon-container">
                            <label class="form-label" for="add-user-fullname">Họ Tên</label>
                            <input
                                type="text"
                                class="form-control"
                                id="name"
                                placeholder="Nguyễn Văn A"
                                name="name"
                                aria-label="Nguyễn Văn A"
                                required>
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
                            </div>
                            <div class="mb-6 fv-plugins-icon-container">
                                <label class="form-label" for="add-user-username">Tên đăng nhập</label>
                                <input
                                    type="text"
                                    class="form-control"
                                    id="username"
                                    placeholder="nguyenvana"
                                    name="username"
                                    aria-label="Tên đăng nhập"
                                    required>
                                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
                                </div>
                                <div class="mb-6 fv-plugins-icon-container">
                                    <label class="form-label" for="add-user-email">Email</label>
                                    <input
                                        type="email"
                                        id="email"
                                        class="form-control"
                                        placeholder="nguyenvana@example.com"
                                        aria-label="nguyenvana@example.com"
                                        name="email"
                                        required>
                                        <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
                                    </div>
                                    <div class="mb-6">
                                        <label class="form-label" for="add-user-contact">Liên Hệ</label>
                                        <input
                                            type="tel"
                                            id="phone"
                                            class="form-control phone-mask"
                                            placeholder="+84 (123) 456-789"
                                            aria-label="Liên Hệ"
                                            name="phone"
                                            pattern="[0-9]{10}"></div>
                                        <div class="mb-6 form-password-toggle">
                                            <label class="form-label" for="password">Mật khẩu</label>
                                            <div class="input-group input-group-merge">
                                                <input
                                                    type="password"
                                                    id="password"
                                                    class="form-control"
                                                    name="password"
                                                    placeholder="············"
                                                    aria-describedby="password">
                                                    <span class="input-group-text cursor-pointer">
                                                        <i class="bx bx-hide"></i>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="mb-6 d-flex justify-content-between">
                                                <div class="me-2 flex-fill">
                                                    <label class="form-label" for="user-role">Vai Trò Người Dùng</label>
                                                    <select id="role" name="role" class="form-select">
                                                        <option value="USER">Người Dùng</option>
                                                        <option value="MOD">Moderator</option>
                                                        <option value="ADMIN">Admin</option>
                                                    </select>
                                                </div>
                                                <div class="flex-fill">
                                                    <label class="form-label" for="user-gender">Giới tính</label>
                                                    <select id="gender" name="gender" class="form-select">
                                                        <option value="OTHER">Khác</option>
                                                        <option value="MALE">Nam</option>
                                                        <option value="FEMALE">Nữ</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="mb-6">
                                                <label class="form-label" for="add-user-bio">Tiểu sử</label>
                                                <textarea id="bio" class="form-control" placeholder="Mô tả về bản thân..." name="bio" rows="3"></textarea>
                                            </div>
                                            <button type="submit" class="btn btn-primary me-3 data-submit">Gửi</button>
                                            <button type="reset" class="btn btn-label-danger" data-bs-dismiss="offcanvas">Hủy</button>
                                        </form>                                    </div>                                </div>                                <!-- Warning User Modal -->
                                <div class="modal fade" id="warnUserModal" tabindex="-1" aria-labelledby="warnUserModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="warnUserModalLabel">
                                                    <i class="bx bx-error text-warning me-2"></i>Cảnh Báo Người Dùng
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label">Tên người dùng:</label>
                                                    <span id="warnUserName" class="fw-bold text-primary"></span>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="warnReason" class="form-label">Lý do cảnh báo:</label>
                                                    <textarea id="warnReason" class="form-control" rows="4" placeholder="Nhập lý do cảnh báo người dùng..." required>Vi phạm quy định cộng đồng</textarea>
                                                </div>
                                                <div class="alert alert-warning">
                                                    <i class="bx bx-info-circle me-2"></i>
                                                    <small>Người dùng sẽ nhận được thông báo về cảnh báo này trong hệ thống.</small>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <button type="button" class="btn btn-warning" onclick="confirmWarn()">
                                                    <i class="bx bx-send me-1"></i>Gửi Cảnh Báo
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header border-danger">
                                                <h5 class="modal-title text-danger" id="deleteUserModalLabel">
                                                    <i class="bx bx-trash me-2"></i>Xác Nhận Xóa Tài Khoản
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="text-center mb-3">
                                                    <i class="bx bx-error-circle text-danger" style="font-size: 48px;"></i>
                                                </div>
                                                <div class="mb-3">
                                                    <p class="text-center">Bạn có chắc chắn muốn xóa tài khoản của:</p>
                                                    <p class="text-center fw-bold fs-5" id="deleteUserName"></p>
                                                </div>
                                                <div class="alert alert-danger">
                                                    <i class="bx bx-error me-2"></i>
                                                    <strong>Cảnh báo:</strong> Hành động này không thể hoàn tác. Tất cả dữ liệu của người dùng sẽ bị xóa vĩnh viễn.
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                                                    <i class="bx bx-trash me-1"></i>Xóa Tài Khoản
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Success/Error Notification Modal -->
                                <div class="modal fade" id="notificationModal" tabindex="-1" aria-labelledby="notificationModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-sm">
                                        <div class="modal-content">
                                            <div class="modal-body text-center py-4">
                                                <div id="notificationIcon" class="mb-3">
                                                    <!-- Icon will be set by JavaScript -->
                                                </div>
                                                <h6 id="notificationTitle" class="mb-2"></h6>
                                                <p id="notificationMessage" class="text-muted mb-3"></p>
                                                <button type="button" class="btn btn-primary btn-sm" data-bs-dismiss="modal">Đóng</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>

                                <!-- Ban User Modal -->
                                <div class="modal fade" id="banUserModal" tabindex="-1" aria-labelledby="banUserModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="banUserModalLabel">Khóa Tài Khoản</h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label">Tên người dùng:</label>
                                                    <span id="banUserName" class="fw-bold"></span>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="banDuration" class="form-label">Thời gian khóa:</label>
                                                    <select id="banDuration" class="form-select">
                                                        <option value="1">1 ngày</option>
                                                        <option value="3">3 ngày</option>
                                                        <option value="7">7 ngày</option>
                                                        <option value="30" selected>30 ngày</option>
                                                        <option value="90">90 ngày</option>
                                                        <option value="365">365 ngày (1 năm)</option>
                                                        <option value="permanent">Vĩnh viễn</option>
                                                        <option value="custom">Tùy chỉnh...</option>
                                                    </select>
                                                </div>
                                                <div class="mb-3" id="customDateGroup" style="display: none;">
                                                    <label for="customBanDate" class="form-label">Chọn ngày kết thúc:</label>
                                                    <input type="datetime-local" id="customBanDate" class="form-control">
                                                </div>
                                                <div class="mb-3">
                                                    <label for="banReason" class="form-label">Lý do khóa:</label>
                                                    <textarea id="banReason" class="form-control" rows="3" placeholder="Nhập lý do khóa tài khoản...">Vi phạm quy định</textarea>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <button type="button" class="btn btn-danger" onclick="confirmBan()">Khóa Tài Khoản</button>
                                            </div>
                                        </div>
                                    </div>
                                </div>                                <script>
                                    let currentBanUserId = null;
                                    let currentBanUserName = null;

                                    function openBanModal(username, id) {
                                        currentBanUserId = id;
                                        currentBanUserName = username;
                                        document.getElementById('banUserName').textContent = username;
                                        document.getElementById('banDuration').value = '30';
                                        document.getElementById('banReason').value = 'Vi phạm quy định';
                                        document.getElementById('customDateGroup').style.display = 'none';
                                        
                                        const banModal = new bootstrap.Modal(document.getElementById('banUserModal'));
                                        banModal.show();
                                    }                                    function confirmUnbanUser(username, id) {
                                        if (confirm(`Bạn có chắc chắn muốn mở khóa tài khoản của ${username} không?`)) {
                                            const data = {
                                                bannedUntil: null,
                                                bannedReason: null
                                            };
                                            
                                            fetch(`{{ baseUrl }}/user-management/ban/${id}`, {
                                                method: 'POST',
                                                headers: {
                                                    'Content-Type': 'application/json',
                                                },
                                                body: JSON.stringify(data)
                                            }).then(response => {
                                                if (response.ok) {
                                                    showNotification('success', 'Thành công!', `Đã mở khóa tài khoản ${username}`);
                                                    setTimeout(() => {
                                                        location.reload();
                                                    }, 2000);
                                                } else {
                                                    return response.json().then(err => {
                                                        throw new Error(err.message || 'Có lỗi xảy ra');
                                                    });
                                                }
                                            }).catch(error => {
                                                showNotification('error', 'Lỗi!', error.message);
                                            });
                                        }
                                    }

                                    function confirmBan() {
                                        const duration = document.getElementById('banDuration').value;
                                        const reason = document.getElementById('banReason').value.trim();
                                        
                                        if (!reason) {
                                            alert('Vui lòng nhập lý do khóa tài khoản');
                                            return;
                                        }

                                        let bannedUntil = null;
                                        
                                        if (duration === 'permanent') {
                                            // Set to a very far future date for permanent ban
                                            bannedUntil = new Date('2099-12-31T23:59:59.999Z').toISOString();
                                        } else if (duration === 'custom') {
                                            const customDate = document.getElementById('customBanDate').value;
                                            if (!customDate) {
                                                alert('Vui lòng chọn ngày kết thúc khóa');
                                                return;
                                            }
                                            bannedUntil = new Date(customDate).toISOString();
                                        } else {
                                            const days = parseInt(duration);
                                            bannedUntil = new Date(Date.now() + days * 24 * 60 * 60 * 1000).toISOString();
                                        }

                                        const data = {
                                            bannedUntil: bannedUntil,
                                            bannedReason: reason
                                        };                                        fetch(`{{ baseUrl }}/user-management/ban/${currentBanUserId}`, {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/json',
                                            },
                                            body: JSON.stringify(data)
                                        }).then(response => {
                                            if (response.ok) {
                                                // Close modal and show success notification
                                                const banModal = bootstrap.Modal.getInstance(document.getElementById('banUserModal'));
                                                banModal.hide();
                                                
                                                showNotification('success', 'Thành công!', `Đã khóa tài khoản ${currentBanUserName}`);
                                                
                                                setTimeout(() => {
                                                    location.reload();
                                                }, 2000);
                                            } else {
                                                return response.json().then(err => {
                                                    throw new Error(err.message || 'Có lỗi xảy ra');
                                                });
                                            }
                                        }).catch(error => {
                                            showNotification('error', 'Lỗi!', error.message);
                                        });
                                    }

                                    // Handle ban duration change
                                    document.addEventListener('DOMContentLoaded', function() {
                                        const banDurationSelect = document.getElementById('banDuration');
                                        const customDateGroup = document.getElementById('customDateGroup');
                                        
                                        if (banDurationSelect) {
                                            banDurationSelect.addEventListener('change', function() {
                                                if (this.value === 'custom') {
                                                    customDateGroup.style.display = 'block';
                                                    // Set minimum date to current time
                                                    const now = new Date();
                                                    now.setMinutes(now.getMinutes() - now.getTimezoneOffset());
                                                    document.getElementById('customBanDate').min = now.toISOString().slice(0, 16);
                                                } else {
                                                    customDateGroup.style.display = 'none';
                                                }
                                            });
                                        }                                    });
                                    
                                    // Variables for managing modals
                                    let currentWarnUserId = null;
                                    let currentWarnUserName = null;
                                    let currentDeleteUserId = null;
                                    let currentDeleteUserName = null;                                    // Warning user functions
                                    function openWarnModal(username, id) {
                                        currentWarnUserId = id;
                                        currentWarnUserName = username;
                                        document.getElementById('warnUserName').textContent = username;
                                        document.getElementById('warnReason').value = 'Vi phạm quy định cộng đồng';
                                        
                                        const warnModal = new bootstrap.Modal(document.getElementById('warnUserModal'));
                                        warnModal.show();
                                    }

                                    function confirmWarn() {
                                        const reason = document.getElementById('warnReason').value.trim();
                                        
                                        if (!reason) {
                                            showNotification('error', 'Lỗi!', 'Vui lòng nhập lý do cảnh báo');
                                            return;
                                        }

                                        const data = {
                                            bannedReason: reason
                                        };

                                        fetch(`{{ baseUrl }}/user-management/warn/${currentWarnUserId}`, {
                                            method: 'POST',
                                            headers: {
                                                'Content-Type': 'application/json'
                                            },
                                            body: JSON.stringify(data)
                                        }).then(response => {
                                            if (response.ok) {
                                                // Close warning modal
                                                const warnModal = bootstrap.Modal.getInstance(document.getElementById('warnUserModal'));
                                                warnModal.hide();
                                                
                                                // Show success notification
                                                showNotification('success', 'Thành công!', `Đã gửi cảnh báo cho ${currentWarnUserName}`);
                                                
                                                // Reload page after 2 seconds
                                                setTimeout(() => {
                                                    location.reload();
                                                }, 2000);
                                            } else {
                                                return response.json().then(err => {
                                                    throw new Error(err.message || 'Có lỗi xảy ra');
                                                });
                                            }
                                        }).catch(error => {
                                            showNotification('error', 'Lỗi!', error.message);
                                        });
                                    }

                                    // Delete user functions
                                    function openDeleteModal(username, id) {
                                        currentDeleteUserId = id;
                                        currentDeleteUserName = username;
                                        document.getElementById('deleteUserName').textContent = username;
                                        
                                        const deleteModal = new bootstrap.Modal(document.getElementById('deleteUserModal'));
                                        deleteModal.show();
                                    }

                                    function confirmDelete() {
                                        fetch(`{{ baseUrl }}/user-management/delete/${currentDeleteUserId}`, {
                                            method: 'DELETE'
                                        }).then(response => {
                                            if (response.ok) {
                                                // Close delete modal
                                                const deleteModal = bootstrap.Modal.getInstance(document.getElementById('deleteUserModal'));
                                                deleteModal.hide();
                                                
                                                // Show success notification
                                                showNotification('success', 'Thành công!', `Đã xóa tài khoản ${currentDeleteUserName}`);
                                                
                                                // Reload page after 2 seconds
                                                setTimeout(() => {
                                                    location.reload();
                                                }, 2000);
                                            } else {
                                                return response.json().then(err => {
                                                    throw new Error(err.message || 'Có lỗi xảy ra');
                                                });
                                            }
                                        }).catch(error => {
                                            showNotification('error', 'Lỗi!', error.message);
                                        });
                                    }

                                    // Notification function
                                    function showNotification(type, title, message) {
                                        const notificationModal = document.getElementById('notificationModal');
                                        const notificationIcon = document.getElementById('notificationIcon');
                                        const notificationTitle = document.getElementById('notificationTitle');
                                        const notificationMessage = document.getElementById('notificationMessage');
                                        
                                        // Set icon and colors based on type
                                        if (type === 'success') {
                                            notificationIcon.innerHTML = '<i class="bx bx-check-circle text-success" style="font-size: 48px;"></i>';
                                            notificationTitle.className = 'mb-2 text-success';
                                        } else if (type === 'error') {
                                            notificationIcon.innerHTML = '<i class="bx bx-error-circle text-danger" style="font-size: 48px;"></i>';
                                            notificationTitle.className = 'mb-2 text-danger';
                                        } else if (type === 'warning') {
                                            notificationIcon.innerHTML = '<i class="bx bx-error text-warning" style="font-size: 48px;"></i>';
                                            notificationTitle.className = 'mb-2 text-warning';
                                        }
                                        
                                        notificationTitle.textContent = title;
                                        notificationMessage.textContent = message;
                                        
                                        const modal = new bootstrap.Modal(notificationModal);
                                        modal.show();
                                    }

                                    function confirmWarnUser(username, id) {
                                        openWarnModal(username, id);
                                    }
                                    
                                    function delUser(username, id) {
                                        openDeleteModal(username, id);
                                    }
                                    function openAddUser() {
                                        document.getElementById("offcanvasAddUserLabel").innerText = "Thêm Mới Người Dùng";
                                        document.getElementById("addNewUserForm").action = "{{ baseUrl }}/user-management/create";
                                        document.getElementById("addNewUserForm").reset();
                                        // Make password required for new users
                                        document.getElementById("password").required = true;
                                        const addUserModal = new bootstrap.Offcanvas(document.getElementById("offcanvasAddUser"));
                                        addUserModal.show();
                                    }
                                    function openEditUserModal(id) {
                                        document.getElementById("offcanvasAddUserLabel").innerText = "Chỉnh Sửa Người Dùng";
                                        document.getElementById("addNewUserForm").action = "{{ baseUrl }}/user-management/update/" + id;
                                        // Make password optional for editing
                                        document.getElementById("password").required = false;
                                        fetch (`{{ baseUrl }}/user-management/get/${id}`)
                                            .then(response => response.json())
                                            .then(response => {
                                                response.data = response.data.data
                                                document.getElementById("name").value = response.data.name || '';
                                                document.getElementById("username").value = response.data.username || '';
                                                document.getElementById("email").value = response.data.email || '';
                                                document.getElementById("phone").value = response.data.phone || '';
                                                document.getElementById("role").value = response.data.role || 'USER';
                                                document.getElementById("gender").value = response.data.gender || 'OTHER';
                                                document.getElementById("bio").value = response.data.bio || '';
                                                document.getElementById('password').value = '';
                                                const editUserModal = new bootstrap.Offcanvas(document.getElementById("offcanvasAddUser"));
                                                editUserModal.show();                                            })
                                            .catch(error => {
                                                showNotification('error', 'Lỗi!', `Không thể tải thông tin người dùng: ${error.message}`);
                                            });
                                    }
                                    function setQueryParams(params) {
                                        const url = new URL(window.location.href);
                                        Object.keys(params).forEach(key => {
                                            url.searchParams.set(key, params[key]);
                                        });
                                        window.location.href = url.toString();
                                    }
                                    // Handle form submission
                                    document.addEventListener('DOMContentLoaded', function () {
                                        const form = document.getElementById('addNewUserForm');
                                        if (form) {
                                            form.addEventListener('submit', function (e) {
                                                e.preventDefault();
                                                const formData = new FormData(form);
                                                const data = {};
                                                // Convert FormData to object, excluding empty password on edit
                                                for (let [key, value] of formData.entries()) {
                                                    if (key === 'password' && value === '' && form.action.includes('update')) {
                                                        continue; // Skip empty password on update
                                                    }data[key] = value;
                                                }
                                                fetch(form.action, {
                                                    method: form.action.includes('update')
                                                        ? 'PUT'
                                                        : 'POST',
                                                    headers: {
                                                        'Content-Type': 'application/json'
                                                    },
                                                    body: JSON.stringify(data)                                                }).then(response => {
                                                    if (response.ok) {
                                                        // Close offcanvas
                                                        const addUserModal = bootstrap.Offcanvas.getInstance(document.getElementById("offcanvasAddUser"));
                                                        addUserModal.hide();
                                                        
                                                        // Show success notification
                                                        const isEdit = form.action.includes('update');
                                                        const successMessage = isEdit ? 'Cập nhật người dùng thành công!' : 'Tạo người dùng mới thành công!';
                                                        showNotification('success', 'Thành công!', successMessage);
                                                        
                                                        // Reload page after 2 seconds
                                                        setTimeout(() => {
                                                            location.reload();
                                                        }, 2000);
                                                    } else {
                                                        return response.json().then(err => {
                                                            throw new Error(err.message || 'Có lỗi xảy ra');
                                                        });
                                                    }
                                                }).catch(error => {
                                                    showNotification('error', 'Lỗi!', error.message);
                                                });
                                            });
                                        }
                                    });
                                </script>
                            {% endblock %}