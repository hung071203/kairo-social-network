{% extends 'admins/layouts/app.njk' %}
{% set title = 'Quản lý người dùng' %}
{% set auth = false %}
{% block content %}
    <div class="card-header border-bottom">
        <h5 class="card-header">Quản lý người dùng</h5>
    </div>
    <br/>
    <!-- Button Thêm mới -->
    <div
        class="d-flex justify-content-between mb-3">
        <!-- Ô tìm kiếm + Nút tìm kiếm -->
        <div class="input-group w-25">
            <input type="text" class="form-control" id="searchUser" placeholder="Tìm kiếm người dùng...">
                <button class="btn btn-outline-primary" onclick="submitSearch()">
                    <i class="bx bx-search"></i>
                    Tìm kiếm
                </button>
            </div>
            {% if user.role == 'ADMIN' %}
                <button class="btn btn-secondary add-new btn-primary" onclick="openAddUser()">
                    <span>
                        <i class="bx bx-plus bx-sm me-0 me-sm-2"></i>
                        <span class="d-none d-sm-inline-block">Thêm Mới Người Dùng</span>
                    </span>
                </button>
            {% endif %}
        </div>
        <script>
            // Lấy giá trị của query "search" từ URL và gán vào input
            function getSearchQuery() {
                const params = new URLSearchParams(window.location.search);
                return params.get("search") || "";
            }
            document.getElementById("searchUser").value = getSearchQuery();
            function submitSearch() {
                let input = document
                    .getElementById("searchUser")
                    .value
                    .trim();
                let url = new URL(window.location.href);
                if (input) {
                    url.searchParams.set("search", input); // Thêm hoặc cập nhật query "search"
                } else {
                    url.searchParams.delete("search"); // Xóa query nếu input rỗng
                }
                window.location.href = url.toString(); // Load lại trang với query mới
            }
            document.getElementById("searchUser").addEventListener("keydown", function (event) {
                if (event.key === "Enter") {
                    submitSearch();
                }
            });
        </script>
        <div class="table-responsive text-nowrap">
            <table class="table">
                <thead>
                    <tr>
                        <th>ID</th>
                        <th>Người dùng</th>
                        <th>Số điện thoại</th>
                        <th
                            class="sortable"
                            onclick="setQueryParams({sort: 'createdAt', order: '{% if query.order == 'asc' %}desc{% else %}asc{% endif %}'});">
                            Ngày tạo
                            <i class="fas fa-sort{% if query.sort == 'createdAt' and query.order == 'asc' %}-up{% elif query.sort == 'createdAt' and
                                query.order == 'desc' %}-down{% else %}{% endif %}"></i>
                        </th>
                        <th
                            class="sortable"
                            onclick="setQueryParams({sort: 'role', order: '{% if query.order == 'asc' %}desc{% else %}asc{% endif %}'});">
                            Quyền hạn
                            <i class="fas fa-sort{% if query.sort == 'role' and query.order == 'asc' %}-up{% elif query.sort == 'role' and query.order
                                == 'desc' %}-down{% else %}{% endif %}"></i>
                        </th>
                        <th>
                            Trạng Thái
                        </th>
                        <th>Hành Động</th>
                    </tr>
                </thead>
                <tbody class="table-border-bottom-0">
                    {% set index = (data.page - 1) * data.limit + 1 %}
                    {% if data.docs and data.docs.length > 0 %}
                        {% for item in data.docs %}
                            <tr>
                                <td>{{ index }}</td>
                                {% set index = index + 1 %}
                                <td>
                                    <div class="d-flex justify-content-start align-items-center user-name">
                                        <div class="avatar-wrapper">
                                            <div class="avatar avatar-sm me-4">
                                                {% if item.avatar %}
                                                    <img src="{{ item.avatar }}" alt="{{ item.name or 'User' }}" class="rounded-circle">
                                                    {% else %}
                                                        <span class="avatar-initial rounded-circle bg-label-primary">
                                                            {{ (item.name or item.username or 'U')[0] | upper }}
                                                        </span>
                                                    {% endif %}
                                                </div>
                                            </div>
                                            <div class="d-flex flex-column">
                                                <span class="fw-medium text-heading">{{ item.name or 'Không có tên' }}</span>
                                                <small class="text-muted">{{ item.username or 'unknown' }}</small>
                                                <small class="text-muted">{{ item.email or 'Không có email' }}</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="text-muted">{{ item.phone or 'Trống' }}</span>
                                    </td>
                                    <td>
                                        <span class="text-muted">{{ item.createdAt | formatDate('YYYY-MM-DD HH:mm:ss') }}</span>
                                    </td>
                                    <td>
                                        {% if item.role == 'ADMIN' %}
                                            <span class="badge bg-label-danger me-1">Admin</span>
                                        {% elif item.role == 'MOD' %}
                                            <span class="badge bg-label-warning me-1">Moderator</span>
                                        {% else %}
                                            <span class="badge bg-label-success me-1">Người Dùng</span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        {% if item.bannedUntil and (item.bannedUntil | isFuture) %}
                                            {% set bannedDate = item.bannedUntil | formatDate('YYYY-MM-DD HH:mm:ss') %}
                                            <span
                                                class="badge bg-label-danger me-1"
                                                title="Bị khóa đến: {{ bannedDate }}{% if item.bannedReason %} | Lý do: {{ item.bannedReason }}{% endif %}"
                                                data-bs-toggle="tooltip">
                                                <i class="bx bx-lock me-1"></i>Khóa đến {{ bannedDate }}
                                            </span>
                                        {% elif item.bannedReason and not (item.bannedUntil and (item.bannedUntil | isFuture)) %}
                                            <span class="badge bg-label-warning me-1" title="Cảnh báo: {{ item.bannedReason }}" data-bs-toggle="tooltip">
                                                <i class="bx bx-error me-1"></i>Cảnh báo
                                            </span>
                                        {% else %}
                                            <span class="badge bg-label-success me-1" title="Tài khoản hoạt động bình thường" data-bs-toggle="tooltip">
                                                <i class="bx bx-check me-1"></i>Hoạt động
                                            </span>
                                        {% endif %}
                                    </td>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="dropdown">                                                <button type="button" class="btn p-0 dropdown-toggle hide-arrow" data-bs-toggle="dropdown" aria-expanded="false">
                                                    <i class="bx bx-dots-vertical-rounded"></i>
                                                </button>
                                                <div class="dropdown-menu">
                                                    <a class="dropdown-item" href="javascript:void(0);" onclick="openUserProfileModal('{{ item._id }}');">
                                                        <i class="bx bx-user me-1"></i>
                                                        Xem Hồ Sơ
                                                    </a>
                                                    {% if user.role == 'ADMIN' or user.role == 'MOD' %}
                                                        <a class="dropdown-item" href="javascript:void(0);" onclick="openEditUserModal('{{ item._id }}');">
                                                            <i class="bx bx-edit-alt me-1"></i>
                                                            Chỉnh Sửa
                                                        </a>
                                                        <a class="dropdown-item {% if item.bannedUntil and (item.bannedUntil | isFuture) %}text-success{% else %}text-danger{% endif %}" href="javascript:void(0);" onclick="{% if item.bannedUntil and (item.bannedUntil | isFuture) %}confirmUnbanUser('{{ item.name }}', '{{ item._id }}'){% else %}openBanModal('{{ item.name }}', '{{ item._id }}'){% endif %}">
                                                            {% if item.bannedUntil and (item.bannedUntil | isFuture) %}
                                                                <i class="bx bx-lock-open me-1"></i>
                                                                Mở Khóa
                                                            {% else %}
                                                                <i class="bx bx-lock me-1"></i>
                                                                Khóa Tài Khoản
                                                            {% endif %}
                                                        </a>
                                                        {% if not (item.bannedUntil and (item.bannedUntil | isFuture)) %}
                                                            {% if item.bannedReason %}
                                                                <a
                                                                    class="dropdown-item text-success"
                                                                    href="javascript:void(0);"
                                                                    onclick="openRemoveWarningModal('{{ item.name }}', '{{ item._id }}');">
                                                                    <i class="bx bx-shield-check me-1"></i>
                                                                    Bỏ Cảnh Báo
                                                                </a>
                                                            {% else %}
                                                                <a
                                                                    class="dropdown-item text-warning"
                                                                    href="javascript:void(0);"
                                                                    onclick="confirmWarnUser('{{ item.name }}', '{{ item._id }}');">
                                                                    <i class="bx bx-error me-1"></i>
                                                                    Cảnh báo
                                                                </a>
                                                            {% endif %}
                                                        {% endif %}
                                                        {% if user.role == 'ADMIN' %}
                                                            <a class="dropdown-item text-danger" href="javascript:void(0);" onclick="delUser('{{ item.name }}', '{{ item._id }}');">
                                                                <i class="bx bx-trash me-1"></i>
                                                                Xóa tài khoản
                                                            </a>                                                        {% endif %}
                                                    {% endif %}
                                                </div>
                                            </div>
                                        </div>
                                    </td>
                                </tr>
                            {% endfor %}
                        {% else %}
                            <tr>
                                <td colspan="6" class="text-center py-4">
                                    <div class="empty-state">
                                        <i class="bx bx-user-x display-4 text-muted mb-2"></i>
                                        <p class="text-muted">Không có người dùng nào được tìm thấy</p>
                                    </div>
                                </td>
                            </tr>
                        {% endif %}
                    </tbody>
                </table>
            </div>
            {% include '../../layouts/_pagination.njk' %}
            <!-- Offcanvas to add new user -->
            <div class="offcanvas offcanvas-end" tabindex="-1" id="offcanvasAddUser" aria-labelledby="offcanvasAddUserLabel">
                <div class="offcanvas-header border-bottom">
                    <h5 id="offcanvasAddUserLabel" class="offcanvas-title">Thêm Người Dùng</h5>
                    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="Đóng"></button>
                </div>
                <div class="offcanvas-body mx-0 flex-grow-0 p-6 h-100">
                    <form class="add-new-user pt-0 fv-plugins-bootstrap5 fv-plugins-framework" id="addNewUserForm" method="post" action="{{ baseUrl }}/users/create" novalidate="novalidate">
                        <div class="mb-6 fv-plugins-icon-container">
                            <label class="form-label" for="add-user-fullname">Họ Tên</label>
                            <input
                                type="text"
                                class="form-control"
                                id="name"
                                placeholder="Nguyễn Văn A"
                                name="name"
                                aria-label="Nguyễn Văn A"
                                required>
                                <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
                            </div>
                            <div class="mb-6 fv-plugins-icon-container">
                                <label class="form-label" for="add-user-username">Tên đăng nhập</label>
                                <input
                                    type="text"
                                    class="form-control"
                                    id="username"
                                    placeholder="nguyenvana"
                                    name="username"
                                    aria-label="Tên đăng nhập"
                                    required>
                                    <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
                                </div>
                                <div class="mb-6 fv-plugins-icon-container">
                                    <label class="form-label" for="add-user-email">Email</label>
                                    <input
                                        type="email"
                                        id="email"
                                        class="form-control"
                                        placeholder="nguyenvana@example.com"
                                        aria-label="nguyenvana@example.com"
                                        name="email"
                                        required>
                                        <div class="fv-plugins-message-container fv-plugins-message-container--enabled invalid-feedback"></div>
                                    </div>
                                    <div class="mb-6">
                                        <label class="form-label" for="add-user-contact">Liên Hệ</label>
                                        <input
                                            type="tel"
                                            id="phone"
                                            class="form-control phone-mask"
                                            placeholder="+84 (123) 456-789"
                                            aria-label="Liên Hệ"
                                            name="phone"
                                            pattern="[0-9]{10}"></div>
                                        <div class="mb-6 form-password-toggle">
                                            <label class="form-label" for="password">Mật khẩu</label>
                                            <div class="input-group input-group-merge">
                                                <input
                                                    type="password"
                                                    id="password"
                                                    class="form-control"
                                                    name="password"
                                                    placeholder="············"
                                                    aria-describedby="password">
                                                    <span class="input-group-text cursor-pointer">
                                                        <i class="bx bx-hide"></i>
                                                    </span>
                                                </div>
                                            </div>
                                            <div class="mb-6 d-flex justify-content-between">
                                                <div class="me-2 flex-fill">
                                                    <label class="form-label" for="user-role">Vai Trò Người Dùng</label>
                                                    <select id="role" name="role" class="form-select">
                                                        <option value="USER">Người Dùng</option>
                                                        <option value="MOD">Moderator</option>
                                                        <option value="ADMIN">Admin</option>
                                                    </select>
                                                </div>
                                                <div class="flex-fill">
                                                    <label class="form-label" for="user-gender">Giới tính</label>
                                                    <select id="gender" name="gender" class="form-select">
                                                        <option value="OTHER">Khác</option>
                                                        <option value="MALE">Nam</option>
                                                        <option value="FEMALE">Nữ</option>
                                                    </select>
                                                </div>
                                            </div>
                                            <div class="mb-6">
                                                <label class="form-label" for="add-user-bio">Tiểu sử</label>
                                                <textarea id="bio" class="form-control" placeholder="Mô tả về bản thân..." name="bio" rows="3"></textarea>
                                            </div>
                                            <button type="submit" class="btn btn-primary me-3 data-submit">Gửi</button>
                                            <button type="reset" class="btn btn-label-danger" data-bs-dismiss="offcanvas">Hủy</button>
                                        </form>
                                    </div>
                                </div>
                                <!-- Warning User Modal -->
                                <div class="modal fade" id="warnUserModal" tabindex="-1" aria-labelledby="warnUserModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header">
                                                <h5 class="modal-title" id="warnUserModalLabel">
                                                    <i class="bx bx-error text-warning me-2"></i>Cảnh Báo Người Dùng
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label">Tên người dùng:</label>
                                                    <span id="warnUserName" class="fw-bold text-primary"></span>
                                                </div>
                                                <div class="mb-3">
                                                    <label for="warnReason" class="form-label">Lý do cảnh báo:</label>
                                                    <textarea id="warnReason" class="form-control" rows="4" placeholder="Nhập lý do cảnh báo người dùng..." required>Vi phạm
                                                        quy định cộng đồng</textarea>
                                                </div>
                                                <div class="alert alert-warning">
                                                    <i class="bx bx-info-circle me-2"></i>
                                                    <small>Người dùng sẽ nhận được thông báo về cảnh báo này trong hệ thống.</small>
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <button type="button" class="btn btn-warning" onclick="confirmWarn()">
                                                    <i class="bx bx-send me-1"></i>Gửi Cảnh Báo
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Delete Confirmation Modal -->
                                <div class="modal fade" id="deleteUserModal" tabindex="-1" aria-labelledby="deleteUserModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header border-danger">
                                                <h5 class="modal-title text-danger" id="deleteUserModalLabel">
                                                    <i class="bx bx-trash me-2"></i>Xác Nhận Xóa Tài Khoản
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body">
                                                <div class="text-center mb-3">
                                                    <i class="bx bx-error-circle text-danger" style="font-size: 48px;"></i>
                                                </div>
                                                <div class="mb-3">
                                                    <p class="text-center">Bạn có chắc chắn muốn xóa tài khoản của:</p>
                                                    <p class="text-center fw-bold fs-5" id="deleteUserName"></p>
                                                </div>
                                                <div class="alert alert-danger">
                                                    <i class="bx bx-error me-2"></i>
                                                    <strong>Cảnh báo:</strong>
                                                    Hành động này không thể hoàn tác. Tất cả dữ liệu của người dùng sẽ bị xóa vĩnh viễn.
                                                </div>
                                            </div>
                                            <div class="modal-footer">
                                                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Hủy</button>
                                                <button type="button" class="btn btn-danger" onclick="confirmDelete()">
                                                    <i class="bx bx-trash me-1"></i>Xóa Tài Khoản
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                <!-- Success/Error Notification Modal -->
                                <div
                                    class="modal fade"
                                    id="notificationModal"
                                    tabindex="-1"
                                    aria-labelledby="notificationModalLabel"
                                    aria-hidden="true">
                                    <div class="modal-dialog modal-dialog-centered modal-sm">
                                        <div class="modal-content">
                                            <div class="modal-body text-center py-4">
                                                <div
                                                    id="notificationIcon" class="mb-3"><!-- Icon will be set by JavaScript -->
                                                </div>
                                                <h6 id="notificationTitle" class="mb-2"></h6>
                                                <p id="notificationMessage" class="text-muted mb-3"></p>
                                                <button type="button" class="btn btn-primary btn-sm" data-bs-dismiss="modal">Đóng</button>
                                            </div>
                                        </div>                                    </div>
                                </div>
                                
                                <!-- User Profile Modal -->
                                <div class="modal fade" id="userProfileModal" tabindex="-1" aria-labelledby="userProfileModalLabel" aria-hidden="true">
                                    <div class="modal-dialog modal-lg modal-dialog-centered">
                                        <div class="modal-content">
                                            <div class="modal-header border-0 pb-0">
                                                <h5 class="modal-title" id="userProfileModalLabel">
                                                    <i class="bx bx-user-circle text-primary me-2"></i>Hồ Sơ Người Dùng
                                                </h5>
                                                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                            </div>
                                            <div class="modal-body p-0">                                                <!-- Profile Content -->
                                                <div class="position-relative">                                                    <!-- Cover Photo -->
                                                    <div id="profileCoverPhoto" class="position-relative" style="height: 200px; background: linear-gradient(135deg, #667eea 0%, #764ba2 100%); background-size: cover; background-position: center; background-repeat: no-repeat;">
                                                        <!-- Overlay for better text readability -->
                                                        <div class="position-absolute w-100 h-100" style="background: linear-gradient(to bottom, rgba(0,0,0,0.1) 0%, rgba(0,0,0,0.5) 100%);"></div>
                                                        <!-- Simple overlay text -->
                                                        <div class="position-absolute bottom-0 start-0 p-4 text-white w-100">
                                                            <h5 class="mb-0 fw-bold" style="text-shadow: 2px 2px 8px rgba(0,0,0,0.8);">Hồ sơ người dùng</h5>
                                                        </div>
                                                    </div>
                                                      <!-- Profile Info -->
                                                    <div class="px-4 pb-4">
                                                        <!-- Avatar and Basic Info -->
                                                        <div class="text-center mb-4" style="margin-top: -60px;">
                                                            <div class="position-relative d-inline-block">
                                                                <img id="profileAvatar" src="" alt="Avatar" class="rounded-circle border border-4 border-white bg-white shadow" style="width: 120px; height: 120px; object-fit: cover;">
                                                                <span id="profileStatus" class="position-absolute bottom-0 end-0 badge rounded-pill bg-success border border-2 border-white" style="width: 24px; height: 24px;"></span>
                                                            </div>
                                                            <div class="mt-3">
                                                                <h4 id="profileName" class="mb-1 fw-bold text-dark"></h4>
                                                                <p id="profileUsername" class="text-muted mb-2"></p>
                                                                <div class="d-flex gap-2 justify-content-center">
                                                                    <span id="profileRole" class="badge bg-label-primary"></span>
                                                                    <span id="profileBanStatus" class="badge d-none"></span>
                                                                </div>
                                                            </div>
                                                        </div>                                                        <!-- Bio Section -->
                                                        <div class="mb-4">
                                                            <h6 class="fw-semibold mb-2">
                                                                <i class="bx bx-info-circle me-1 text-info"></i>Giới thiệu
                                                            </h6>
                                                            <p id="profileBio" class="text-muted mb-0 fst-italic">Chưa có thông tin giới thiệu</p>
                                                        </div>

                                                        <!-- Contact Information -->
                                                        <div class="row mb-4">
                                                            <div class="col-md-6">
                                                                <div class="card border-0 bg-light h-100">
                                                                    <div class="card-body">
                                                                        <h6 class="fw-semibold mb-3 text-primary">
                                                                            <i class="bx bx-envelope me-1"></i>Thông tin liên hệ
                                                                        </h6>
                                                                        <div class="mb-2">
                                                                            <small class="text-muted">Email:</small>
                                                                            <div id="profileEmail" class="fw-medium text-break"></div>
                                                                        </div>
                                                                        <div class="mb-2">
                                                                            <small class="text-muted">Số điện thoại:</small>
                                                                            <div id="profilePhone" class="fw-medium"></div>
                                                                        </div>
                                                                        <div class="mb-2">
                                                                            <small class="text-muted">Giới tính:</small>
                                                                            <div id="profileGender" class="fw-medium"></div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                            <div class="col-md-6">
                                                                <div class="card border-0 bg-light h-100">
                                                                    <div class="card-body">
                                                                        <h6 class="fw-semibold mb-3 text-success">
                                                                            <i class="bx bx-time me-1"></i>Thông tin tài khoản
                                                                        </h6>
                                                                        <div class="mb-2">
                                                                            <small class="text-muted">Ngày tạo:</small>
                                                                            <div id="profileCreatedAt" class="fw-medium"></div>
                                                                        </div>                                                                        <div class="mb-2">
                                                                            <small class="text-muted">Cập nhật cuối:</small>
                                                                            <div id="profileUpdatedAt" class="fw-medium"></div>
                                                                        </div>
                                                                    </div>
                                                                </div>
                                                            </div>
                                                        </div><!-- Statistics -->
                                                        <div class="row">
                                                            <div class="col-md-12">
                                                                <h6 class="fw-semibold mb-3">
                                                                    <i class="bx bx-bar-chart me-1 text-primary"></i>Thống kê hoạt động
                                                                </h6>                                                                <div class="row text-center g-3">
                                                                    <div class="col-md-4">
                                                                        <div class="card border-0 bg-light h-100">
                                                                            <div class="card-body py-3">
                                                                                <h5 id="profilePostsCount" class="mb-1 text-primary fw-bold">0</h5>
                                                                                <small class="text-muted">Bài viết</small>
                                                                            </div>
                                                                        </div>
                                                                    </div>
                                                                    <div class="col-md-4">
                                                                        <div class="card border-0 bg-light h-100">
